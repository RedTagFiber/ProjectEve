using System;
using System.Collections.Generic;
using System.Linq;

namespace ProjectEve.Traits
{
    /// <summary>
    /// Legacy registry API kept for compile compatibility.
    /// Source of truth is TraitJson (Fast / Mid / Slow).
    /// Do NOT call LoadBaseTraits to seed gameplay traits.
    /// </summary>
    public static class TraitRegistry
    {
        public static List<TraitDefinition> AllTraits { get; private set; } = new();

        public class TraitDefinition
        {
            public string Id { get; set; } = "";
            public string Name { get; set; } = "";
            public string Category { get; set; } = "";
            public string Description { get; set; } = "";
            public string Prompt { get; set; } = "";
            public int DefaultValue { get; set; } = 50;
            public int MinValue { get; set; } = 0;
            public int MaxValue { get; set; } = 100;
            public string WeightHint { get; set; } = "medium";
            public List<string> Tags { get; set; } = new();
            public string LlmContext { get; set; } = "";
            public string ExampleHigh { get; set; } = "";
            public string ExampleLow { get; set; } = "";
            public List<string> BehaviorLinks { get; set; } = new();
            public string ImpactDirection { get; set; } = "mixed";
            public bool IsCoreTrait { get; set; } = true;

            /// <summary>fast | mid | slow</summary>
            public string Layer { get; set; } = "fast";
        }

        /// <summary>
        /// NO-OP for old callers. Does not populate 200 traits.
        /// Optional: registers Fast 20 stubs so GetDefinition does not return null.
        /// </summary>
        public static void LoadBaseTraits()
        {
            AllTraits.Clear();
            RegisterFast20Stubs();
            // Mid/Slow come from JSON loader later — not here.
        }

        public static TraitDefinition? GetDefinition(string id)
        {
            if (string.IsNullOrWhiteSpace(id))
                return null;

            return AllTraits.FirstOrDefault(t =>
                t.Id.Equals(id, StringComparison.OrdinalIgnoreCase));
        }

        public static void Register(TraitDefinition def)
        {
            if (def == null || string.IsNullOrWhiteSpace(def.Id))
                return;

            var existing = GetDefinition(def.Id);
            if (existing != null)
                AllTraits.Remove(existing);

            AllTraits.Add(def);
        }

        private static void RegisterFast20Stubs()
        {
            void Add(string id, string name, string llm)
            {
                AllTraits.Add(new TraitDefinition
                {
                    Id = id,
                    Name = name,
                    Category = "Fast",
                    Layer = "fast",
                    Description = name,
                    DefaultValue = 45,
                    MinValue = 0,
                    MaxValue = 100,
                    WeightHint = "high",
                    LlmContext = llm,
                    IsCoreTrait = true
                });
            }

            Add("trait.anger", "Anger", "In-moment anger heat; style decides expression.");
            Add("trait.anxiety", "Anxiety", "Worry, scanning, need for reassurance.");
            Add("trait.fear", "Fear", "Threat, loss, danger response.");
            Add("trait.shame", "Shame", "Exposed, small, want to hide.");
            Add("trait.guilt", "Guilt", "I did wrong / owe repair.");
            Add("trait.hurt", "Hurt", "Wounded by someone who matters.");
            Add("trait.jealousy", "Jealousy", "Claim threat, rival attention.");
            Add("trait.resentment", "Resentment", "Stored unfairness.");
            Add("trait.trust", "Trust", "Safety with this person.");
            Add("trait.affection", "Affection", "Warmth / fondness in-moment.");
            Add("trait.desire", "Desire", "Wanting them (body/heart).");
            Add("trait.attraction", "Attraction", "Pull / chemistry spike.");
            Add("trait.tension", "Tension", "Charged air — fight or sexual.");
            Add("trait.playfulness", "Playfulness", "Tease, joke, light.");
            Add("trait.pride", "Pride", "Status, face, being right.");
            Add("trait.patience", "Patience", "Tolerance before snap.");
            Add("trait.guard", "Guard", "Close the gates now.");
            Add("trait.openness", "Openness", "Willing to show / say more.");
            Add("trait.loneliness", "Loneliness", "Need contact / left out.");
            Add("trait.hope", "Hope", "Belief this can get better.");
        }
    }
}