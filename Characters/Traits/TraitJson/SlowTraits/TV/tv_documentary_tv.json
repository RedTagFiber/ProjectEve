{
  "id": "slow.tv.documentary_tv",
  "layer": "slow",
  "domain": "tv",
  "label": "Documentary TV",
  "version": 1,
  "description": "Non-crime documentaries—nature, history, sports docs, music docs, social issue series.",
  "priorIntensity": 4,
  "moveSpeed": "very_slow",
  "fillThreshold": 50,
  "bands": {
    "off": "0-29",
    "low": "30-49",
    "mid": "50-69",
    "high": "70-84",
    "break": "85-94",
    "extreme": "95-100"
  },
  "talkTriggers": [ "documentary", "docuseries", "nature", "history", "that doc", "learned" ],
  "rivalBias": false,
  "catalog": "TV/Shows/Documentary",
  "subTraits": [
    {
      "id": "slow.tv.documentary_tv.nature",
      "label": "Nature / planet docs",
      "kind": "style",
      "defaultRange": [ 35, 95 ],
      "tags": [ "calm" ]
    },
    {
      "id": "slow.tv.documentary_tv.history",
      "label": "History docs",
      "kind": "style",
      "defaultRange": [ 30, 95 ],
      "tags": [ "war", "era" ]
    },
    {
      "id": "slow.tv.documentary_tv.music_doc",
      "label": "Music documentaries",
      "kind": "style",
