{
  "id": "slow.tv.sports_media",
  "layer": "slow",
  "domain": "tv",
  "label": "Sports Media",
  "version": 1,
  "description": "Sports TV as content—studio shows, documentaries, highlight culture, not just live games (live games live on sports traits).",
  "priorIntensity": 5,
  "moveSpeed": "very_slow",
  "fillThreshold": 50,
  "bands": {
    "off": "0-29",
    "low": "30-49",
    "mid": "50-69",
    "high": "70-84",
    "break": "85-94",
    "extreme": "95-100"
  },
  "talkTriggers": [ "First Take", "Pat McAfee", "highlights", "documentary", "studio show", "debate" ],
  "rivalBias": true,
  "catalog": "TV/Shows/SportsMedia",
