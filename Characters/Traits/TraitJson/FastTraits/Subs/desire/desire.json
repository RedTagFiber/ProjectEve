{
  "id": "desire",
  "layer": "fast",
  "label": "Desire",
  "version": 1,
  "description": "Wanting them — body and/or heart drive to act. Stronger and more intentional than Attraction alone. Gated by context, trust, and content rating.",
  "priorIntensity": {
    "min": 2,
    "max": 6,
    "mean": 3
  },
  "spawn": {
    "currentFromIntensity": true,
    "noise": 3
  },
  "bands": {
      "stage1": [ 0, 20 ],
      "stage2": [ 21, 40 ],
      "stage3": [ 41, 60 ],
      "stage4": [ 61, 80 ],
      "stage5": [ 81, 94 ],
      "wildcard": [ 95, 100 ]
    },
  "styles": {
    "soft": {
      "means": "Gentle want; tenderness first; no rush.",
      "speechHints": [ "quiet", "warm", "careful" ],
      "bodyHints": [ "soft_touch", "close" ],
      "riskTags": [ "vulnerable" ]
    },
    "direct": {
      "means": "Clear ask or clear signal; names the want.",
      "speechHints": [ "blunt", "honest", "forward" ],
      "bodyHints": [ "steady_eye", "advance" ],
      "riskTags": [ "rejection_risk" ]
    },
    "playful": {
      "means": "Tease and charge; want wrapped in fun.",
      "speechHints": [ "tease", "dare", "laugh" ],
      "bodyHints": [ "grin", "brush_contact" ],
      "riskTags": [ "misread" ]
    },
    "hungry": {
      "means": "Strong physical drive; urgency; less filter.",
      "speechHints": [ "low", "short", "raw" ],
      "bodyHints": [ "intensity", "proximity" ],
      "riskTags": [ "push_pace" ]
    },
    "restrained": {
      "means": "Feels it hard but holds the line; controlled.",
      "speechHints": [ "measured", "half_held" ],
      "bodyHints": [ "tense_still", "step_back" ],
      "riskTags": [ "frustration" ]
    }
  },
  "defaultStyleWeights": {
    "soft": 1.0,
    "direct": 0.7,
    "playful": 0.85,
    "hungry": 0.45,
    "restrained": 0.9
  },
  "flavors": {
    "sexual": "Physical/sexual want.",
    "romantic": "Heart + closeness want.",
    "reunion": "After absence; need to close distance.",
    "jealous_spark": "Want sharpened by rival attention.",
    "comfort": "Want as soothing / safety-seeking."
  },
  "pull": {
    "belowHomeDamageMult": 0.65,
    "recoverMult": 1.2,
    "aboveHomeSettleMult": 1.2
  },
  "funding": {
    "required": true,
    "budgetPerIntensityPoint": 1.0
  },
