{
  "id": "anxiety",
  "layer": "fast",
  "label": "Anxiety",
  "version": 1,
  "description": "Worry, scanning, need for reassurance. Not the same as Fear (immediate threat). Body and mind run ahead of the moment.",
  "priorIntensity": {
    "min": 2,
    "max": 7,
    "mean": 4
  },
  "spawn": {
    "currentFromIntensity": true,
    "noise": 3
  },
  "bands": {
    "off": [ 0, 29 ],
    "low": [ 30, 49 ],
    "mid": [ 50, 69 ],
    "high": [ 70, 84 ],
    "break": [ 85, 94 ],
    "extreme": [ 95, 100 ]
  },
  "styles": {
    "fidget": {
      "means": "Restless body: taps, checks phone, moves, cannot settle.",
      "speechHints": [ "rushed", "tangential" ],
      "bodyHints": [ "fidget", "scan_room", "phone_check" ],
      "riskTags": [ "distracted" ]
    },
    "overtalk": {
      "means": "Fills silence; over-explains; asks stacked questions.",
      "speechHints": [ "fast", "too_many_words", "clarify_loop" ],
      "bodyHints": [ "lean_in", "wide_eyes" ],
      "riskTags": [ "exhaust_listener" ]
    },
    "withdraw": {
      "means": "Pulls inward; quiet; avoids adding risk.",
      "speechHints": [ "minimal", "soft", "uncertain" ],
      "bodyHints": [ "shrink", "avoid_eye" ],
      "riskTags": [ "shutdown" ]
    },
    "reassure_seek": {
      "means": "Needs confirmation: are we ok, did I mess up, do you still…",
      "speechHints": [ "checking", "are_we_ok", "repeat_ask" ],
      "bodyHints": [ "searching_face" ],
      "riskTags": [ "cling" ]
    },
    "freeze": {
      "means": "Locks up; blank; hard to decide or speak.",
      "speechHints": [ "stalled", "uh", "lost" ],
      "bodyHints": [ "still", "shallow_breath" ],
      "riskTags": [ "non_responsive" ]
    },
    "plan_spiral": {
      "means": "What-if chains; plans and backups; cannot stop forecasting.",
      "speechHints": [ "what_if", "list", "worst_case" ],
      "bodyHints": [ "tense_shoulders" ],
      "riskTags": [ "paralysis_by_analysis" ]
    }
  },
  "defaultStyleWeights": {
    "fidget": 1.0,
    "overtalk": 0.85,
    "withdraw": 0.9,
    "reassure_seek": 1.0,
    "freeze": 0.5,
    "plan_spiral": 0.8
  },
  "flavors": {
    "social": "Judgment, awkwardness, what they think of me.",
    "attachment": "Relationship safety; abandonment scan.",
    "performance": "Failing, looking incompetent, deadlines.",
    "health": "Body / catastrophe health worries.",
    "uncertainty": "Unknown outcomes; open loops."
  },
  "pull": {
    "belowHomeDamageMult": 0.55,
    "recoverMult": 1.25,
    "aboveHomeSettleMult": 1.1
  },
  "funding": {
    "required": true,
    "budgetPerIntensityPoint": 1.0
  },
