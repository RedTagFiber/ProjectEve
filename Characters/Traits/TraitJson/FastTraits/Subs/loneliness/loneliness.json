{
  "id": "loneliness",
  "layer": "fast",
  "label": "Loneliness",
  "version": 1,
  "description": "Need for contact / left out. Can be alone in a crowd. Drives reach, cling, or numb scroll.",
  "priorIntensity": {
    "min": 2,
    "max": 7,
    "mean": 4
  },
  "spawn": {
