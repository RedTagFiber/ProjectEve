      "stage2": [ 21, 40 ],
      "stage3": [ 41, 60 ],
      "stage4": [ 61, 80 ],
      "stage5": [ 81, 94 ],
      "wildcard": [ 95, 100 ]
    },
  "styles": {
    "reach": {
      "means": "Texts, calls, shows up; asks to hang.",
      "speechHints": [ "you_free", "miss_you", "come_over" ],
      "bodyHints": [ "approach" ],
      "riskTags": [ "needy_read" ]
    },
    "numb": {
      "means": "Flat alone; shuts the need down.",
      "speechHints": [ "flat", "fine" ],
      "bodyHints": [ "still", "screen" ],
      "riskTags": [ "isolate" ]
    },
    "scroll": {
      "means": "Fills the hole with phone, noise, background people.",
      "speechHints": [ "distracted" ],
      "bodyHints": [ "phone", "half_present" ],
      "riskTags": [ "absent" ]
    },
    "cling": {
      "means": "When someone is there, holds tight; fears the end of the visit.",
      "speechHints": [ "stay", "one_more" ],
      "bodyHints": [ "hold", "delay_exit" ],
      "riskTags": [ "cling" ]
    },
    "ache": {
      "means": "Open painful awareness of missing someone / people.",
      "speechHints": [ "honest_sad", "empty" ],
      "bodyHints": [ "sink", "quiet" ],
      "riskTags": [ "vulnerable" ]
    }
  },
