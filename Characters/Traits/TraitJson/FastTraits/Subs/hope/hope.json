      "stage2": [ 21, 40 ],
      "stage3": [ 41, 60 ],
      "stage4": [ 61, 80 ],
      "stage5": [ 81, 94 ],
      "wildcard": [ 95, 100 ]
    },
  "styles": {
    "bright": {
      "means": "Open optimism; says the good future out loud.",
      "speechHints": [ "we_can", "itll_work", "forward" ],
      "bodyHints": [ "open", "light" ],
      "riskTags": [ "naive_read" ]
    },
    "fragile": {
      "means": "Hopes but is ready to crack; small voice.",
      "speechHints": [ "maybe", "I_want_to_believe" ],
      "bodyHints": [ "tentative" ],
      "riskTags": [ "easily_crushed" ]
    },
    "stubborn": {
      "means": "Won't quit the belief even when evidence is thin.",
      "speechHints": [ "still", "not_giving_up" ],
      "bodyHints": [ "set_jaw_soft" ],
      "riskTags": [ "denial_edge" ]
    },
    "quiet": {
      "means": "Holds hope privately; doesn't perform it.",
      "speechHints": [ "understated", "small_plan" ],
      "bodyHints": [ "steady" ],
      "riskTags": []
    },
    "naive": {
      "means": "Skips the hard parts; rose-colored.",
      "speechHints": [ "easy_fix", "itll_be_fine" ],
      "bodyHints": [ "bounce" ],
      "riskTags": [ "blindsided" ]
    }
  },
  "defaultStyleWeights": {
