{
  "id": "fear",
  "layer": "fast",
  "label": "Fear",
  "version": 1,
  "description": "Response to threat, loss, or danger — more immediate than Anxiety. Can be physical danger, social ruin, or losing someone.",
  "priorIntensity": {
    "min": 2,
    "max": 6,
    "mean": 3
  },
  "spawn": {
    "currentFromIntensity": true,
    "noise": 3
  },
  "bands": {
      "stage1": [ 0, 20 ],
      "stage2": [ 21, 40 ],
      "stage3": [ 41, 60 ],
      "stage4": [ 61, 80 ],
      "stage5": [ 81, 94 ],
      "wildcard": [ 95, 100 ]
    },
  "styles": {
    "flee": {
      "means": "Gets out — leaves room, ends call, changes subject hard.",
      "speechHints": [ "cutoff", "gotta_go" ],
      "bodyHints": [ "exit", "turn_away" ],
      "riskTags": [ "abandon_scene" ]
    },
    "freeze": {
      "means": "Cannot move or decide; locked.",
      "speechHints": [ "stuck", "quiet" ],
      "bodyHints": [ "still", "wide_eye" ],
      "riskTags": [ "non_responsive" ]
    },
    "fight": {
      "means": "Fear turns into push-back; defensive aggression.",
      "speechHints": [ "sharp", "defensive" ],
      "bodyHints": [ "brace", "raise_voice" ],
      "riskTags": [ "fear_anger_blend" ]
    },
    "cling": {
      "means": "Grabs safety in a person; stays close; needs them near.",
      "speechHints": [ "don't_leave", "stay" ],
      "bodyHints": [ "hold", "follow" ],
      "riskTags": [ "cling" ]
    },
    "numb": {
      "means": "Shuts feeling down; flat; delayed reaction.",
      "speechHints": [ "flat", "distant" ],
      "bodyHints": [ "slack", "empty_face" ],
      "riskTags": [ "dissociate_light" ]
    }
  },
  "defaultStyleWeights": {
    "flee": 0.9,
    "freeze": 0.7,
    "fight": 0.6,
    "cling": 0.8,
    "numb": 0.5
  },
  "flavors": {
    "physical": "Body harm, violence, accident.",
    "social": "Humiliation, exile, being hated.",
    "loss": "Someone leaving, dying, choosing another.",
    "authority": "Police, boss, parent power.",
    "unknown": "Cannot name the threat; dread."
  },
  "pull": {
    "belowHomeDamageMult": 0.5,
    "recoverMult": 1.35,
    "aboveHomeSettleMult": 1.25
  },
  "funding": {
