    "low": [ 30, 49 ],
    "mid": [ 50, 69 ],
    "high": [ 70, 84 ],
    "break": [ 85, 94 ],
    "extreme": [ 95, 100 ]
  },
  "styles": {
    "soft_cry": {
      "means": "Tears, cracked voice, visible wound.",
      "speechHints": [ "broken", "quiet", "why" ],
      "bodyHints": [ "tears", "fold_in" ],
      "riskTags": [ "vulnerable" ]
    },
    "shut_down": {
      "means": "Goes quiet and flat; emotional lights off.",
      "speechHints": [ "minimal", "empty" ],
      "bodyHints": [ "still", "look_down" ],
      "riskTags": [ "stonewall" ]
    },
    "lash": {
      "means": "Hurt comes out as sharp words; wound → spike.",
      "speechHints": [ "sharp", "accuse" ],
      "bodyHints": [ "tense", "glare" ],
      "riskTags": [ "hurt_anger_blend" ]
    },
    "cling": {
      "means": "Needs contact even while wounded; don't leave.",
      "speechHints": [ "stay", "hold" ],
      "bodyHints": [ "reach", "hold" ],
      "riskTags": [ "cling" ]
    },
    "silent": {
      "means": "No show; carries it; may tell later or never.",
      "speechHints": [ "fine", "nothing" ],
      "bodyHints": [ "composed_mask" ],
      "riskTags": [ "delayed_blow" ]
    }
  },
  "defaultStyleWeights": {
