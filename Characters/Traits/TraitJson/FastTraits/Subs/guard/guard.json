  "styles": {
    "walls": {
      "means": "Hard boundary; closed topics; emotional wall.",
      "speechHints": [ "short", "closed", "none_of_your_business" ],
      "bodyHints": [ "arms_cross", "angle_away" ],
      "riskTags": [ "stonewall" ]
    },
    "humor_mask": {
      "means": "Jokes instead of answers; keeps it light on purpose.",
      "speechHints": [ "joke", "deflect", "sarcasm_light" ],
      "bodyHints": [ "smile_armor" ],
      "riskTags": [ "never_serious" ]
    },
    "topic_change": {
      "means": "Steers away from soft or dangerous subjects.",
      "speechHints": [ "anyway", "subject_change" ],
      "bodyHints": [ "busy", "look_elsewhere" ],
      "riskTags": [ "avoidant" ]
    },
    "exit": {
      "means": "Leaves the moment — room, thread, relationship beat.",
      "speechHints": [ "gotta_go", "done" ],
      "bodyHints": [ "exit" ],
      "riskTags": [ "abandon_scene" ]
    },
    "minimal": {
      "means": "Answers with least possible; no extra free info.",
      "speechHints": [ "one_word", "fine", "sure" ],
      "bodyHints": [ "still", "flat" ],
      "riskTags": [ "read_as_cold" ]
    }
  },
