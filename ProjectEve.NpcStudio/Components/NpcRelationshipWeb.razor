@using Microsoft.Data.Sqlite
@using ProjectEve.NpcStudio.Models
@using ProjectEve.NpcStudio.Services
@inject NpcStudioService Studio
@inject CanonicalFamilyGraphService CanonicalFamily
@inject NpcStudioOptions Options

<NpcRelationshipBuilders Sheet="Sheet" />
<div class="family-state-sync-panel">
    <div>
        <strong>Canonical family relationship states</strong>
        <span>
            The family graph is objective structure. The score editor uses this NPC's
            subjective relationship-state rows.
        </span>
    </div>

    <div class="family-state-sync-actions">
        <button type="button"
                class="rw-secondary"
                @onclick="PreviewMissingFamilyStates">
            Preview Missing Relationship States
        </button>

        @if (_familyStatePreview.Count > 0)
        {
            <button type="button"
                    class="rw-primary"
                    @onclick="ConfirmMissingFamilyStates">
                Confirm Create @_familyStatePreview.Count Neutral State@(_familyStatePreview.Count == 1 ? "" : "s")
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_familyStatePreviewMessage))
    {
        <div class="family-state-sync-message">@_familyStatePreviewMessage</div>
    }

    @if (_familyStatePreview.Count > 0)
    {
        <div class="family-state-preview-list">
            @foreach (var item in _familyStatePreview)
            {
                <span><b>@item.Name</b> · @item.Role</span>
            }
        </div>
    }
</div>

<div class="relationship-workspace">
    <UnifiedRelationshipGraph Sheet="Sheet" OnNpcSelected="SelectNpc" OnRelationshipSelected="SelectRelationship" />
<aside class="relationship-detail-panel">
        @if (_selected is null)
        {
            @if (_selectedNpcId > 0)
            {
                <div class="rw-title compact">
                    <div>
                        <span class="rw-kicker">SELECTED FAMILY MEMBER</span>
                        <h3>@_selectedNpcName</h3>
                    </div>
                    <a href="/npc-studio/npc/@_selectedNpcId">Open Dossier</a>
                </div>

                <div class="rw-empty">
                    <strong>@_selectedNpcName is selected</strong>
                    <span>This person is connected through the canonical family graph but does not yet have a direct subjective relationship-state row for this NPC.</span>
                </div>
            }
            else
            {
                <div class="rw-empty">
                    <strong>Select someone in the web</strong>
                    <span>Then edit the relationship, click a score to see why it is that number, or add supporting history.</span>
                </div>
            }
        }
        else
        {
            <div class="rw-title compact">
                <div>
                    <span class="rw-kicker">SELECTED RELATIONSHIP</span>
                    <h3>@_selected.TargetName</h3>
                </div>
                @if (_selected.TargetNpcId > 0)
                {
                    <a href="/npc-studio/npc/@_selected.TargetNpcId">Open dossier →</a>
                }
            </div>

            <div class="rel-edit-grid">
                <label>Category
                    <select @bind="_selected.RelationshipCategory">
                        @foreach (var c in Categories) { <option value="@c">@c</option> }
                    </select>
                </label>
                <label>Type
                    <input @bind="_selected.RelationshipType" />
                </label>
                <label>Family Role
                    <select @bind="_selected.FamilyRole">
                        @foreach (var role in FamilyRoles)
                        {
                            <option value="@role">@DisplayFamilyRole(role)</option>
                        }
                    </select>
                </label>
                <label>Relationship Tier
                    <select @bind="_selectedTier">
                        <option value="0">Unrated</option>
                        <option value="1">Tier 1 — Core</option>
                        <option value="2">Tier 2 — Strong</option>
                        <option value="3">Tier 3 — Meaningful</option>
                        <option value="4">Tier 4 — Peripheral</option>
                        <option value="5">Tier 5 — Background</option>
                    </select>
                </label>
                <label>Importance
                    <input type="number" min="0" max="100" @bind="_selected.Importance" />
                </label>
            </div>

            <div class="metric-grid">
                @MetricButton("Love", _selected.Affection)
                @MetricButton("Trust", _selected.Trust)
                @MetricButton("Respect", _selected.Respect)
                @MetricButton("Loyalty", _selected.Loyalty)
                @MetricButton("Anger", _selected.Anger)
                @MetricButton("Resentment", _selected.Resentment)
                @MetricButton("Fear", _selected.Fear)
                @MetricButton("Jealousy", _selected.Jealousy)
                @MetricButton("Attraction", _selected.Attraction)
                @MetricButton("Tension", _selected.Tension)
            </div>

            <div class="relationship-sliders">
                @MetricSlider("Love", _selected.Affection, v => _selected.Affection = v)
                @MetricSlider("Trust", _selected.Trust, v => _selected.Trust = v)
                @MetricSlider("Respect", _selected.Respect, v => _selected.Respect = v)
                @MetricSlider("Loyalty", _selected.Loyalty, v => _selected.Loyalty = v)
                @MetricSlider("Anger", _selected.Anger, v => _selected.Anger = v)
                @MetricSlider("Resentment", _selected.Resentment, v => _selected.Resentment = v)
                @MetricSlider("Fear", _selected.Fear, v => _selected.Fear = v)
                @MetricSlider("Jealousy", _selected.Jealousy, v => _selected.Jealousy = v)
                @MetricSlider("Attraction", _selected.Attraction, v => _selected.Attraction = v)
                @MetricSlider("Tension", _selected.Tension, v => _selected.Tension = v)
            </div>

            <label class="rw-notes">Relationship Notes
                <textarea rows="4" @bind="_selected.Notes"></textarea>
            </label>
            <button type="button" class="rw-primary" @onclick="SaveSelected">Save Relationship</button>
                @if (!string.IsNullOrWhiteSpace(_relationshipSaveMessage))
                {
                    <div class="relationship-save-message">@_relationshipSaveMessage</div>
                }

            <section class="why-panel">
                <div class="why-head">
                    <div>
                        <span>WHY THIS SCORE?</span>
                        <strong>@_selectedMetric <b>@_selectedMetricValue</b></strong>
                    </div>
                    <small>
                        @ActiveMetricReasonCount(_selectedMetric) active · @MetricReasonCount(_selectedMetric) total
                    </small>
                </div>

                @if (_reasons.Count == 0)
                {
                    <div class="why-empty">No supporting reason saved for @_selectedMetric yet. Add the story that explains why this number is where it is.</div>
                }
                else
                {
                    @foreach (var reason in _reasons.Where(r => r.Metric.Equals(_selectedMetric, StringComparison.OrdinalIgnoreCase)))
                    {
                        <article class="reason-card @(!reason.StillActive ? "inactive" : "")">
                            <div class="reason-card-head">
                                <div>
                                    <strong>@reason.Title</strong>
                                    <small class="reason-state @(reason.StillActive ? "active" : "inactive")">
                                        @(reason.StillActive ? "ACTIVE" : "INACTIVE")
                                    </small>
                                </div>
                                <span class="@(reason.Impact >= 0 ? "positive" : "negative")">@FormatImpact(reason.Impact)</span>
                            </div>
                            <p>@reason.Details</p>
                            @if (!string.IsNullOrWhiteSpace(reason.HistoryEventId))
                            {
                                <small class="reason-history">History event: @reason.HistoryEventId</small>
                            }
                            <div class="reason-actions">
                                <button type="button" class="rw-secondary" @onclick="@(() => BeginEditReason(reason))">Edit</button>
                                <button type="button"
                                        class="rw-secondary @(reason.StillActive ? "danger-soft" : "success-soft")"
                                        @onclick="@(() => ToggleReasonActive(reason))">
                                    @(reason.StillActive ? "Deactivate" : "Reactivate")
                                </button>
                            </div>
                        </article>
                    }
                }

                <details class="reason-add" open>
                    <summary>@(_editingReasonId is null ? "Add reason / history support" : "Edit reason")</summary>
                    <input placeholder="Reason title" @bind="_reasonDraft.Title" />
                    <textarea rows="3" placeholder="What happened and why it matters..." @bind="_reasonDraft.Details"></textarea>
                    <div class="reason-row">
                        <label>Impact <input type="number" min="-100" max="100" @bind="_reasonDraft.Impact" /></label>
                        <label>History Event
                            <select @bind="_reasonDraft.HistoryEventId">
                                <option value="">— Optional —</option>
                                @foreach (var h in Sheet.HistoryEvents) { <option value="@h.Id">@h.Title</option> }
                            </select>
                        </label>
                    </div>
                    <div class="reason-editor-actions">
                        <button type="button" class="rw-secondary" @onclick="SaveReason">
                            @(_editingReasonId is null ? $"Add to {_selectedMetric}" : "Save changes")
                        </button>
                        @if (_editingReasonId is not null)
                        {
                            <button type="button" class="rw-secondary" @onclick="CancelReasonEdit">Cancel</button>
                        }
                    </div>
                </details>
            </section>
        }

        <details class="add-relationship">
            <summary>+ Add relationship</summary>
            <label>NPC
                <select @bind="_newRelationship.TargetNpcId">
                    <option value="0">— Select NPC —</option>
                    @foreach (var npc in _npcChoices.Where(n => n.Id != Sheet.Id)) { <option value="@npc.Id">@npc.Name</option> }
                </select>
            </label>
            <label>Category
                <select @bind="_newRelationship.RelationshipCategory">
                    @foreach (var c in Categories) { <option value="@c">@c</option> }
                </select>
            </label>
            <label>Type <input placeholder="Best friend, father, rival..." @bind="_newRelationship.RelationshipType" /></label>
            <label>Family Role
                <select @bind="_newRelationship.FamilyRole">
                    @foreach (var role in FamilyRoles)
                    {
                        <option value="@role">@DisplayFamilyRole(role)</option>
                    }
                </select>
            </label>
            <label>Importance <input type="number" min="0" max="100" @bind="_newRelationship.Importance" /></label>
            <label class="mutual"><input type="checkbox" @bind="_newRelationship.IsMutual" /> Create mutual link</label>
            <button type="button" class="rw-primary" @onclick="AddRelationship">Add Relationship</button>
        </details>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public NpcCharacterSheet Sheet { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private NpcRelationshipRow? _selected;
    private int _selectedNpcId;
    private string _selectedNpcName = "";
    private List<FamilyStatePreviewRow> _familyStatePreview = new();
    private string _familyStatePreviewMessage = "";
    private string _selectedMetric = "Love";
    private string _relationshipSaveMessage = "";
    private List<NpcRelationshipReason> _reasons = new();
    private List<NpcBrowserRow> _npcChoices = new();
    private NpcRelationshipReason _reasonDraft = new() { Metric = "Love", Impact = 10, StillActive = true };
    private string? _editingReasonId;
    private NpcRelationshipDraft _newRelationship = new() { RelationshipCategory = "Friend", RelationshipType = "Friend", Importance = 50, Loyalty = 50, IsMutual = true };

    private static readonly string[] Categories = ["Family", "Friend", "Romantic", "Rival", "Enemy", "Work", "Mentor", "Neighbor", "Other"];
    private static readonly string[] FamilyRoles =
    [
        "",
        "Mother", "Father", "Parent",
        "Daughter", "Son", "Child",
        "Sister", "Brother", "Sibling",
        "Wife", "Husband", "Spouse",
        "Grandmother", "Grandfather", "Grandparent",
        "Mother's Mother", "Mother's Father",
        "Father's Mother", "Father's Father",
        "Mother's Sister", "Mother's Brother",
        "Father's Sister", "Father's Brother",
        "Granddaughter", "Grandson", "Grandchild",
        "Aunt", "Uncle", "Cousin",
        "Niece", "Nephew",
        "Stepmother", "Stepfather", "Stepparent",
        "Stepdaughter", "Stepson", "Stepchild",
        "Mother-in-law", "Father-in-law",
        "Daughter-in-law", "Son-in-law",
        "Sister-in-law", "Brother-in-law",
        "Ex-wife", "Ex-husband", "Ex-spouse",
        "Adoptive Mother", "Adoptive Father", "Adoptive Parent",
        "Biological Mother", "Biological Father"
    ];

    private int _selectedTier;

    private static string DisplayFamilyRole(string role) =>
        string.IsNullOrWhiteSpace(role) ? "— None —" : role;

    private readonly HashSet<string> _enabledCategories =
        new(StringComparer.OrdinalIgnoreCase) { "Family", "Friend", "Relationship", "Enemy" };

    private readonly HashSet<int> _enabledTiers = [1, 2, 3, 4, 5];

    private List<NpcRelationshipRow> VisibleRelationships =>
        Sheet.Relationships
            .Where(r => _enabledCategories.Contains(FilterCategory(r)))
            .Where(r => _enabledTiers.Contains(RelationshipTier(r)))
            .OrderBy(RelationshipTier)
            .ThenByDescending(EffectiveImportance)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _npcChoices = await Studio.SearchNpcsAsync("", "", null);
        _newRelationship.SourceNpcId = Sheet.Id;
        if (Sheet.Relationships.Count > 0) await SelectRelationship(Sheet.Relationships.OrderByDescending(EffectiveImportance).First());
    }

    protected override async Task OnParametersSetAsync()
    {
        _newRelationship.SourceNpcId = Sheet.Id;
        if (_selected is not null)
        {
            var refreshed = Sheet.Relationships.FirstOrDefault(r => r.Id == _selected.Id);
            if (refreshed is not null) _selected = refreshed;
        }
        await Task.CompletedTask;
    }

            private Task PreviewMissingFamilyStates()
    {
        _familyStatePreview.Clear();

        var graph = CanonicalFamily.Resolve(Sheet.Id);

        foreach (var person in graph.People
            .Where(p => p.NpcId > 0 && p.NpcId != Sheet.Id)
            .OrderBy(p => p.Generation)
            .ThenBy(p => p.RoleFromRoot)
            .ThenBy(p => p.Name))
        {
            var alreadyExists = Sheet.Relationships.Any(r => r.TargetNpcId == person.NpcId);
            if (alreadyExists)
                continue;

            _familyStatePreview.Add(new FamilyStatePreviewRow
            {
                NpcId = person.NpcId,
                Name = person.Name,
                Role = string.IsNullOrWhiteSpace(person.RoleFromRoot)
                    ? "Family"
                    : person.RoleFromRoot
            });
        }

        _familyStatePreviewMessage = _familyStatePreview.Count == 0
            ? "No missing subjective relationship-state rows were found for this canonical family graph."
            : $"Preview only — {_familyStatePreview.Count} missing family relationship-state row(s) would be created. Nothing has been written yet.";

        return Task.CompletedTask;
    }

    private async Task ConfirmMissingFamilyStates()
    {
        if (_familyStatePreview.Count == 0)
        {
            _familyStatePreviewMessage = "Nothing to create. Run Preview first.";
            return;
        }

        var planned = _familyStatePreview.ToList();
        var created = 0;

        foreach (var item in planned)
        {
            // Re-check before every write so Confirm is idempotent.
            var current = await Studio.GetCharacterSheetAsync(Sheet.Id);
            if (current is not null &&
                current.Relationships.Any(r => r.TargetNpcId == item.NpcId))
            {
                continue;
            }

            var draft = new NpcRelationshipDraft
            {
                SourceNpcId = Sheet.Id,
                TargetNpcId = item.NpcId,
                RelationshipCategory = "Family",
                RelationshipType = "family",
                FamilyRole = item.Role,
                Importance = 90,
                Loyalty = 50,
                IsMutual = true
            };

            await Studio.AddRelationshipAsync(draft);
            created++;
        }

        _familyStatePreview.Clear();
        _familyStatePreviewMessage =
            $"Created {created} neutral family relationship-state row(s). Existing rows were preserved and were not overwritten.";

        // Ask the parent page to reload the character sheet so the graph and
        // right-hand editor immediately see the newly-created states.
        await OnChanged.InvokeAsync();
    }
private async Task SelectNpc(int npcId)
    {
        _selectedNpcId = npcId;

        // Prefer an existing direct subjective relationship row.
        var direct = Sheet.Relationships
            .Where(r => r.TargetNpcId == npcId)
            .OrderByDescending(EffectiveImportance)
            .FirstOrDefault();

        if (direct is not null)
        {
            await SelectRelationship(direct);
            return;
        }

        // Canonical-only family member: clear the old editor immediately.
        _selected = null;
        _reasons.Clear();
        _selectedMetric = "Love";
        ResetReasonDraft();

        var target = await Studio.GetCharacterSheetAsync(npcId);
        _selectedNpcName = target?.Name ?? $"NPC {npcId}";
    }
private async Task SelectRelationship(NpcRelationshipRow rel)
    {
                _selectedNpcId = rel.TargetNpcId;
        _selectedNpcName = rel.TargetName;_selected = rel;

        if (_selected.Importance <= 0)
            _selected.Importance = EffectiveImportance(_selected);

        if (string.IsNullOrWhiteSpace(_selected.RelationshipCategory))
            _selected.RelationshipCategory = GuessCategory(_selected);

        _selectedTier = LoadRelationshipTier(
            Sheet.Id,
            _selected.TargetNpcId,
            _selected.Id);

        _reasons = string.IsNullOrWhiteSpace(rel.Id)
            ? new List<NpcRelationshipReason>()
            : await Studio.GetRelationshipReasonsAsync(rel.Id);

        _selectedMetric = "Love";
        ResetReasonDraft();
    }

    private async Task SaveSelected()
    {
        if (_selected is null) return;

        _relationshipSaveMessage = "";

        try
        {
            await Studio.SaveRelationshipAsync(_selected);

            // This helper was added by the slider-persistence patch.
            // Keep it when present so every emotional score is guaranteed saved.

            var selectedId = _selected.Id;
            var selectedTargetId = _selected.TargetNpcId;

            // Refresh this component locally instead of forcing the entire dossier
            // through OnChanged. The previous full-parent reload was throwing after
            // the DB write had already succeeded.
            var fresh = await Studio.GetCharacterSheetAsync(Sheet.Id);

            if (fresh is not null)
            {
                Sheet.Relationships = fresh.Relationships;

                var refreshed = Sheet.Relationships.FirstOrDefault(r =>
                    (!string.IsNullOrWhiteSpace(selectedId) && r.Id == selectedId) ||
                    (selectedTargetId > 0 && r.TargetNpcId == selectedTargetId));

                if (refreshed is not null)
                {
                    _selected = refreshed;
                    _selectedNpcId = refreshed.TargetNpcId;
                    _selectedNpcName = refreshed.TargetName;
                    _reasons = await Studio.GetRelationshipReasonsAsync(refreshed.Id);
                }
            }

            _relationshipSaveMessage = "Relationship and slider values saved.";
        }
        catch (Exception ex)
        {
            _relationshipSaveMessage = "Save error: " + ex.Message;
        }
    }

private async Task AddRelationship()
    {
        if (_newRelationship.TargetNpcId <= 0 || string.IsNullOrWhiteSpace(_newRelationship.RelationshipType)) return;
        _newRelationship.SourceNpcId = Sheet.Id;
        await Studio.AddRelationshipAsync(_newRelationship);
        _newRelationship = new NpcRelationshipDraft { SourceNpcId = Sheet.Id, RelationshipCategory = "Friend", RelationshipType = "Friend", Importance = 50, Loyalty = 50, IsMutual = true };
        await OnChanged.InvokeAsync();
    }

        private string RelationshipsDbPath =>
        Options.GetType().GetProperty("RelationshipsDbPath")?.GetValue(Options) as string
        ?? @"D:\ProjectEveData\Database\project_eve_relationships.db";

    private int LoadRelationshipTier(
        int sourceNpcId,
        int targetNpcId,
        string relationshipId)
    {
        try
        {
            using var conn = new SqliteConnection($"Data Source={RelationshipsDbPath}");
            conn.Open();

            using var cmd = conn.CreateCommand();

            if (!string.IsNullOrWhiteSpace(relationshipId))
            {
                cmd.CommandText = """
                    SELECT COALESCE(RelationshipTier, 0)
                    FROM RelationshipStates
                    WHERE RelationshipId = $id
                    LIMIT 1;
                    """;
                cmd.Parameters.AddWithValue("$id", relationshipId);
            }
            else
            {
                cmd.CommandText = """
                    SELECT COALESCE(RelationshipTier, 0)
                    FROM RelationshipStates
                    WHERE SourceCharacterId = $source
                      AND TargetCharacterId = $target
                    ORDER BY UpdatedRealAt DESC
                    LIMIT 1;
                    """;
                cmd.Parameters.AddWithValue("$source", sourceNpcId);
                cmd.Parameters.AddWithValue("$target", targetNpcId);
            }

            var value = cmd.ExecuteScalar();
            if (value is null || value is DBNull)
                return 0;

            var tier = Convert.ToInt32(value);
            return tier is >= 1 and <= 5 ? tier : 0;
        }
        catch (SqliteException)
        {
            return 0;
        }
    }

    private void SaveRelationshipTier(
        int sourceNpcId,
        int targetNpcId,
        string relationshipId,
        int tier)
    {
        tier = tier is >= 1 and <= 5 ? tier : 0;

        using var conn = new SqliteConnection($"Data Source={RelationshipsDbPath}");
        conn.Open();

        using var cmd = conn.CreateCommand();

        if (!string.IsNullOrWhiteSpace(relationshipId))
        {
            cmd.CommandText = """
                UPDATE RelationshipStates
                SET RelationshipTier = $tier,
                    UpdatedRealAt = CURRENT_TIMESTAMP
                WHERE RelationshipId = $id;
                """;
            cmd.Parameters.AddWithValue("$id", relationshipId);
        }
        else
        {
            cmd.CommandText = """
                UPDATE RelationshipStates
                SET RelationshipTier = $tier,
                    UpdatedRealAt = CURRENT_TIMESTAMP
                WHERE SourceCharacterId = $source
                  AND TargetCharacterId = $target;
                """;
            cmd.Parameters.AddWithValue("$source", sourceNpcId);
            cmd.Parameters.AddWithValue("$target", targetNpcId);
        }

        cmd.Parameters.AddWithValue("$tier", tier);
        cmd.ExecuteNonQuery();
    }
private void SelectMetric(string metric)
    {
        _selectedMetric = metric;
        ResetReasonDraft();
    }

    private async Task SaveReason()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reasonDraft.Title)) return;

        _reasonDraft.RelationshipId = _selected.Id;
        _reasonDraft.NpcId = Sheet.Id;
        _reasonDraft.Metric = _selectedMetric;

        if (_editingReasonId is null)
            await Studio.AddRelationshipReasonAsync(_reasonDraft);
        else
            await Studio.SaveRelationshipReasonAsync(_reasonDraft);

        _reasons = await Studio.GetRelationshipReasonsAsync(_selected.Id);
        ResetReasonDraft();
        await OnChanged.InvokeAsync();
    }

    private void BeginEditReason(NpcRelationshipReason reason)
    {
        _editingReasonId = reason.Id;
        _selectedMetric = reason.Metric;
        _reasonDraft = new NpcRelationshipReason
        {
            Id = reason.Id,
            RelationshipId = reason.RelationshipId,
            NpcId = Sheet.Id,
            Metric = reason.Metric,
            Impact = reason.Impact,
            Title = reason.Title,
            Details = reason.Details,
            HistoryEventId = reason.HistoryEventId,
            StillActive = reason.StillActive,
            CreatedRealAt = reason.CreatedRealAt
        };
    }

    private void CancelReasonEdit() => ResetReasonDraft();

    private async Task ToggleReasonActive(NpcRelationshipReason reason)
    {
        if (_selected is null) return;

        await Studio.SetRelationshipReasonActiveAsync(
            reason.Id,
            Sheet.Id,
            !reason.StillActive);

        _reasons = await Studio.GetRelationshipReasonsAsync(_selected.Id);

        if (_editingReasonId == reason.Id)
            ResetReasonDraft();

        await OnChanged.InvokeAsync();
    }

    private void ResetReasonDraft()
    {
        _editingReasonId = null;
        _reasonDraft = new NpcRelationshipReason
        {
            RelationshipId = _selected?.Id ?? "",
            NpcId = Sheet.Id,
            Metric = _selectedMetric,
            Impact = 10,
            StillActive = true
        };
    }

    private int _selectedMetricValue => _selected is null ? 0 : _selectedMetric switch
    {
        "Love" => _selected.Affection,
        "Trust" => _selected.Trust,
        "Respect" => _selected.Respect,
        "Loyalty" => _selected.Loyalty,
        "Anger" => _selected.Anger,
        "Resentment" => _selected.Resentment,
        "Fear" => _selected.Fear,
        "Jealousy" => _selected.Jealousy,
        "Attraction" => _selected.Attraction,
        "Tension" => _selected.Tension,
        _ => 0
    };

    private RenderFragment MetricButton(string name, int value) => builder =>
    {
        var seq = 0;
        int reasonCount = _reasons.Count(r =>
            r.Metric.Equals(name, StringComparison.OrdinalIgnoreCase));

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(
            seq++,
            "class",
            "metric-button " + (_selectedMetric == name ? "active" : ""));
        builder.AddAttribute(
            seq++,
            "title",
            $"Open Why for {name}");
        builder.AddAttribute(
            seq++,
            "onclick",
            EventCallback.Factory.Create(this, () => SelectMetric(name)));

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, name);
        builder.CloseElement();

        builder.OpenElement(seq++, "strong");
        builder.AddContent(seq++, value);
        builder.CloseElement();

        builder.OpenElement(seq++, "small");
        builder.AddContent(
            seq++,
            reasonCount == 0
                ? "Why?"
                : $"Why? · {reasonCount}");
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment MetricSlider(string name, int value, Action<int> setter) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "metric-slider");
        builder.OpenElement(seq++, "span"); builder.AddContent(seq++, name); builder.CloseElement();
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "range");
        builder.AddAttribute(seq++, "min", "0");
        builder.AddAttribute(seq++, "max", "100");
        builder.AddAttribute(seq++, "value", value);
        builder.AddAttribute(seq++, "oninput", EventCallback.Factory.CreateBinder<int>(this, setter, value));
        builder.CloseElement();
        builder.OpenElement(seq++, "b"); builder.AddContent(seq++, value); builder.CloseElement();
        builder.CloseElement();
    };

    private static int EffectiveImportance(NpcRelationshipRow rel)
    {
        if (rel.Importance > 0) return Math.Clamp(rel.Importance, 0, 100);
        return Math.Clamp((Math.Max(rel.Affection, Math.Max(rel.Trust, rel.Respect)) + Math.Max(rel.Tension, Math.Max(rel.Resentment, rel.Fear))) / 2, 1, 100);
    }

    private (double x, double y, double angle, double radius) WebPoint(NpcRelationshipRow rel)
    {
        var tier = RelationshipTier(rel);
        var tierRows = VisibleRelationships.Where(r => RelationshipTier(r) == tier).ToList();
        var index = Math.Max(0, tierRows.FindIndex(r => r.Id == rel.Id));
        var count = Math.Max(1, tierRows.Count);

        var offset = (tier - 1) * 0.39d;
        var angle = (-Math.PI / 2d) + offset + (2d * Math.PI * index / count);
        var radius = tier switch
        {
            1 => 16d,
            2 => 24d,
            3 => 32d,
            4 => 40d,
            _ => 47d
        };

        var x = 50d + Math.Cos(angle) * radius;
        var y = 50d + Math.Sin(angle) * radius;
        return (x, y, angle, radius);
    }

    private static string WebNodeStyle(double x, double y, NpcRelationshipRow rel)
    {
        var importance = EffectiveImportance(rel);
        var size = 64d + Math.Clamp(importance, 0, 100) * 0.22d;
        var delay = -((rel.TargetNpcId > 0 ? rel.TargetNpcId : importance) % 17) * 0.37d;
        return $"left:{x:0.##}%;top:{y:0.##}%;--node-size:{size:0.#}px;--wind-delay:{delay:0.##}s;";
    }

    private static string WebSpokeStyle(double angle, double radius)
    {
        var degrees = angle * 180d / Math.PI;
        return $"width:{radius:0.##}%;transform:rotate({degrees:0.##}deg);";
    }

    private static int RelationshipTier(NpcRelationshipRow rel)
    {
        var importance = EffectiveImportance(rel);
        if (importance >= 80) return 1;
        if (importance >= 60) return 2;
        if (importance >= 40) return 3;
        if (importance >= 20) return 4;
        return 5;
    }

    private static string FilterCategory(NpcRelationshipRow rel)
    {
        var category = string.IsNullOrWhiteSpace(rel.RelationshipCategory)
            ? GuessCategory(rel)
            : rel.RelationshipCategory;

        var c = category.Trim().ToLowerInvariant();
        if (c == "family") return "Family";
        if (c == "friend") return "Friend";
        if (c is "romantic" or "romance" or "relationship") return "Relationship";
        if (c is "rival" or "enemy") return "Enemy";

        var type = (rel.RelationshipType ?? "").ToLowerInvariant();
        if (type.Contains("wife") || type.Contains("husband") || type.Contains("girlfriend") ||
            type.Contains("boyfriend") || type.Contains("fianc") || type.Contains("partner") ||
            type.Contains("lover"))
            return "Relationship";

        if (type.Contains("rival") || type.Contains("enemy"))
            return "Enemy";

        return "Friend";
    }

    private static string RelationshipLabel(NpcRelationshipRow rel)
    {
        if (!string.IsNullOrWhiteSpace(rel.FamilyRole)) return rel.FamilyRole;
        if (!string.IsNullOrWhiteSpace(rel.RelationshipType)) return rel.RelationshipType;
        return FilterCategory(rel);
    }

    private void ToggleCategory(string category)
    {
        if (!_enabledCategories.Add(category))
            _enabledCategories.Remove(category);
    }

    private string FilterClass(string category) =>
        _enabledCategories.Contains(category) ? "on" : "";

    private void ToggleTier(int tier)
    {
        if (!_enabledTiers.Add(tier))
            _enabledTiers.Remove(tier);
    }

    private void ShowAllTiers()
    {
        _enabledTiers.Clear();
        for (var tier = 1; tier <= 5; tier++) _enabledTiers.Add(tier);
    }

    private void ClearTiers() => _enabledTiers.Clear();
    private static string CategoryClass(NpcRelationshipRow rel)
    {
        var category = string.IsNullOrWhiteSpace(rel.RelationshipCategory) ? GuessCategory(rel) : rel.RelationshipCategory;
        return category.ToLowerInvariant() switch
        {
            "family" => "family",
            "friend" => "friend",
            "romantic" => "romantic",
            "rival" or "enemy" => "rival",
            _ => "work"
        };
    }

    private static string GuessCategory(NpcRelationshipRow rel)
    {
        var text = (rel.RelationshipType ?? "").ToLowerInvariant();
        if (text.Contains("mother") || text.Contains("father") || text.Contains("sister") || text.Contains("brother") || text.Contains("family") || text.Contains("parent") || text.Contains("child") || text.Contains("cousin")) return "Family";
        if (text.Contains("wife") || text.Contains("husband") || text.Contains("girlfriend") || text.Contains("boyfriend") || text.Contains("romantic") || text.Contains("partner") || text.Contains("lover")) return "Romantic";
        if (text.Contains("enemy")) return "Enemy";
        if (text.Contains("rival")) return "Rival";
        if (text.Contains("friend")) return "Friend";
        if (text.Contains("boss") || text.Contains("cowork") || text.Contains("work")) return "Work";
        return "Other";
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : parts.Length == 1 ? parts[0][0].ToString().ToUpperInvariant() : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private int MetricReasonCount(string metric) =>
        _reasons.Count(r =>
            r.Metric.Equals(metric, StringComparison.OrdinalIgnoreCase));

    private int ActiveMetricReasonCount(string metric) =>
        _reasons.Count(r =>
            r.StillActive &&
            r.Metric.Equals(metric, StringComparison.OrdinalIgnoreCase));

    private static string FormatImpact(int value) => value > 0 ? $"+{value}" : value.ToString();
}


