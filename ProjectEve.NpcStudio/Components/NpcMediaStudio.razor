@using ProjectEve.NpcStudio.Models
@using ProjectEve.NpcStudio.Services
@inject NpcStudioService Studio
@inject NpcFileSystemService FileSystem
@inject ComfyWorkflowService Comfy
@inject NpcAppearanceDetailService AppearanceDetails

<section class="tier-media-studio">
    @if (_sheet is null)
    {
        <div class="tm-card">Loading NPC media...</div>
    }
    else
    {
        <div class="tm-head">
            <div>
                <span class="tm-kicker">DOSSIER MEDIA Â· TIER @_sheet.Tier</span>
                <h2>Portrait & Life Image Studio</h2>
                <p>@TierDescription</p>
            </div>
            <div class="tm-status @StatusClass">@StatusText</div>
        </div>

        <div class="tm-policy">
            @foreach (var type in RequiredImageTypes)
            {
                <button class="tm-type @(type == _imageType ? "active" : "")"
                        @onclick="() => SelectImageType(type)">
                    <span>@Pretty(type)</span>
                    <small>@ImageTypeNote(type)</small>
                </button>
            }
        </div>

        <div class="tm-tier-queue">
            <div class="tm-tier-queue-head">
                <div>
                    <span>AUTOMATIC TIER MEDIA</span>
                    <strong>Tier @_sheet.Tier · @ApprovedTierCount / @RequiredImageTypes.Count approved</strong>
                    <small>
                        Only missing required pictures are generated. Approved pictures are never regenerated by this queue.
                    </small>
                </div>

                <div class="tm-tier-queue-actions">
                    <button class="primary"
                            disabled="@(_tierQueueRunning || _busy || MissingTierTypes.Count == 0)"
                            @onclick="GenerateMissingTierMediaAsync">
                        @(_tierQueueRunning
                            ? $"Making {Pretty(_tierQueueCurrentType)}..."
                            : MissingTierTypes.Count == 0
                                ? "Tier Media Complete"
                                : $"Generate Missing ({MissingTierTypes.Count})")
                    </button>

                    @if (_tierQueueRunning)
                    {
                        <button @onclick="StopTierQueue">
                            Stop After Current
                        </button>
                    }
                </div>
            </div>

            <div class="tm-tier-queue-list">
                @foreach (var type in RequiredImageTypes)
                {
                    var approved = IsApprovedImageType(type);
                    var current = _tierQueueRunning &&
                        string.Equals(
                            type,
                            _tierQueueCurrentType,
                            StringComparison.OrdinalIgnoreCase);

                    <div class="tm-tier-queue-item @(approved ? "approved" : current ? "current" : "missing")">
                        <span class="tm-tier-queue-dot"></span>
                        <span>@Pretty(type)</span>
                        <b>@(approved ? "APPROVED" : current ? "MAKING" : "MISSING")</b>
                    </div>
                }
            </div>

            @if (MissingTierTypes.Count == 0)
            {
                <div class="tm-tier-complete">
                    All required Tier @_sheet.Tier pictures are made and approved.
                </div>
            }
            else
            {
                <div class="tm-tier-missing">
                    Missing:
                    @string.Join(", ", MissingTierTypes.Select(Pretty))
                </div>
            }
        </div>

        <div class="tm-grid">
            <div class="tm-card">
                <h3>@Pretty(_imageType)</h3>

                @if (IsExistingImage(_candidatePath))
                {
                    <img class="tm-image" src="@PreviewUrl(_candidatePath)" alt="@Pretty(_imageType) preview" />
                    <div class="tm-path">@_candidatePath</div>
                }
                else if (_imageType == "ProfilePicture" && IsExistingImage(_sheet.Appearance.ReferenceImagePath))
                {
                    <img class="tm-image" src="@PreviewUrl(_sheet.Appearance.ReferenceImagePath)" alt="@_sheet.Name profile picture" />
                    <div class="tm-path">@_sheet.Appearance.ReferenceImagePath</div>
                }
                else
                {
                    <div class="tm-empty">
                        No finished @Pretty(_imageType).ToLowerInvariant() selected yet.
                    </div>
                }

                <div class="tm-actions">
                    <button disabled="@_busy" @onclick="FindNewestOutput">Use Newest Comfy Output</button>
                    <button class="approve"
                            disabled="@(_busy || !IsExistingImage(_candidatePath))"
                            @onclick="ApproveAsync">
                        Save / Approve @Pretty(_imageType)
                    </button>
                </div>
            </div>

            <div class="tm-card">
                <h3>Generate in Comfy</h3>
                <div class="tm-person">
                    <b>@_sheet.Name</b>
                    <span>Tier @_sheet.Tier Â· @_sheet.Age Â· @_sheet.Occupation</span>
                </div>

                @if (RequiresIdentityReference(_imageType))
                {
                    var identityReference =
                        ResolveIdentityReferencePath();

                    <div class="tm-info">
                        <b>REAL IDENTITY REFERENCE:</b>
                        @(string.IsNullOrWhiteSpace(identityReference)
                            ? "MISSING - generation is blocked until an approved Profile/Front image exists."
                            : identityReference)
                    </div>
                }
                <div class="tm-generation-status @GenerationStatusClass">
                    <div class="tm-generation-status-head">
                        <span>GENERATION STATUS</span>
                        <strong>@_generationStage</strong>
                    </div>

                    <div class="tm-generation-steps">
                        @foreach (var step in GenerationSteps)
                        {
                            <div class="tm-generation-step @GenerationStepClass(step)">
                                <span class="tm-generation-dot"></span>
                                <span>@step</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_promptId))
                    {
                        <small>Comfy Prompt ID: @_promptId</small>
                    }
                </div>

                <label>Positive Prompt</label>
                <textarea rows="8" @bind="_positivePrompt"></textarea>

                <label>Negative Prompt</label>
                <textarea rows="4" @bind="_negativePrompt"></textarea>

                <div class="tm-actions">
                    <button @onclick="BuildPrompt">Rebuild Prompt</button>
                    <button class="primary" disabled="@_busy" @onclick="QueuePortraitAsync">
                        @(_busy ? "Working..." : $"Generate {Pretty(_imageType)}")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_promptId))
                {
                    <div class="tm-info"><b>Comfy Prompt ID:</b> @_promptId</div>
                }
            </div>
        </div>

        <NpcMediaHistoryCleanupPanel NpcId="NpcId" />
    }
</section>

