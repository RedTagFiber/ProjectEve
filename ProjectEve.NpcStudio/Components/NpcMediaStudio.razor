    private static readonly string[] GenerationSteps =
    {
        "Started",
        "Queued",
        "Making",
        "Complete"
    };

    private string _generationStage = "Ready";

    private string GenerationStatusClass =>
        _generationStage switch
        {
            "Complete" => "complete",
            "Failed" => "failed",
            _ => ""
        };

    private string GenerationStepClass(string step)
    {
        var order = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
        {
            ["Started"] = 1,
            ["Queued"] = 2,
            ["Making"] = 3,
            ["Complete"] = 4
        };

        if (_generationStage == "Failed")
            return "";

        if (!order.TryGetValue(step, out var stepOrder))
            return "";

        var current = _generationStage switch
        {
            "Started" => 1,
            "Queued" => 2,
            "Making" => 3,
            "Complete" => 4,
            _ => 0
        };

        if (stepOrder < current)
            return "done";

        if (stepOrder == current)
            return current == 4 ? "done" : "active";

        return "";
    }

    private async Task TrackComfyProgressAsync(string promptId)
    {
        if (string.IsNullOrWhiteSpace(promptId))
            return;

        _generationStage = "Making";
        SetStatus("busy", $"{Pretty(_imageType)} is being made in ComfyUI...");
        await InvokeAsync(StateHasChanged);

        var deadline = DateTime.UtcNow.AddMinutes(12);

        while (DateTime.UtcNow < deadline)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));

            var status = await Comfy.GetPromptStatusAsync(promptId);

            if (string.Equals(
                status,
                "Complete",
                StringComparison.OrdinalIgnoreCase))
            {
                _generationStage = "Complete";
                SetStatus(
                    "ok",
                    $"{Pretty(_imageType)} generation complete. Loading newest Comfy output...");

                await InvokeAsync(StateHasChanged);

                // Comfy can report completion a fraction before the output file
                // becomes visible to Project Eve. Retry briefly, then perform
                // the same action as the Use Newest Comfy Output button.
                for (var attempt = 0; attempt < 8; attempt++)
                {
                    await Task.Delay(TimeSpan.FromSeconds(1));
                    FindNewestOutput();

                    if (IsExistingImage(_candidatePath))
                        break;
                }

                if (IsExistingImage(_candidatePath))
                {
                    SetStatus(
                        "ok",
                        $"{Pretty(_imageType)} complete. Newest Comfy output loaded and ready for review / approval.");
                }
                else
                {
                    SetStatus(
                        "ok",
                        $"{Pretty(_imageType)} complete, but the output file is not visible yet. Use Newest Comfy Output if needed.");
                }

                await InvokeAsync(StateHasChanged);
                return;
            }

            if (string.Equals(
                status,
                "Failed",
                StringComparison.OrdinalIgnoreCase))
            {
                _generationStage = "Failed";
                SetStatus(
                    "fail",
                    $"{Pretty(_imageType)} generation failed in ComfyUI.");

                await InvokeAsync(StateHasChanged);
                return;
            }

            _generationStage = "Making";
            await InvokeAsync(StateHasChanged);
        }

        _generationStage = "Failed";
        SetStatus(
            "fail",
            $"{Pretty(_imageType)} did not complete within 12 minutes.");

        await InvokeAsync(StateHasChanged);
    }

    private bool _tierQueueRunning;
    private bool _tierQueueStopRequested;
    private string _tierQueueCurrentType = "";

    private int ApprovedTierCount =>
        RequiredImageTypes.Count(IsApprovedImageType);

    private List<string> MissingTierTypes =>
        RequiredImageTypes
            .Where(type => !IsApprovedImageType(type))
            .ToList();

    private bool IsApprovedImageType(string imageType)
    {
        if (_sheet is null)
            return false;

        return _sheet.Images.Any(x =>
            x.Approved &&
            string.Equals(
                NormalizeMediaType(x.ImageType),
                imageType,
                StringComparison.OrdinalIgnoreCase) &&
            IsExistingImage(x.ImagePath));
    }

    private static string NormalizeMediaType(string? imageType) =>
        imageType switch
        {
            "ProfessionalProfile" => "ProfilePicture",
            "ReferencePortrait" => "ProfilePicture",
            _ => imageType ?? ""
        };

    private void StopTierQueue()
    {
        _tierQueueStopRequested = true;
        SetStatus(
            "busy",
            "Tier media queue will stop after the current picture finishes.");
    }

    private async Task GenerateMissingTierMediaAsync()
    {
        if (_sheet is null || _tierQueueRunning)
            return;

        _tierQueueRunning = true;
        _tierQueueStopRequested = false;
        _tierQueueCurrentType = "";

        try
        {
            await ReloadAsync();

            while (true)
            {
                if (_sheet is null)
                    throw new InvalidOperationException("NPC dossier is no longer available.");

                var missing = MissingTierTypes;

                if (missing.Count == 0)
                {
                    _tierQueueCurrentType = "";
                    SetStatus(
                        "ok",
                        $"Tier {_sheet.Tier} media complete. All {RequiredImageTypes.Count} required pictures are approved.");
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (_tierQueueStopRequested)
                {
                    SetStatus(
                        "ok",
                        $"Tier media queue stopped. {missing.Count} required picture(s) are still missing.");
                    return;
                }

                var next = missing[0];
                _tierQueueCurrentType = next;

                SelectImageType(next);

                SetStatus(
                    "busy",
                    $"Automatic Tier {_sheet.Tier} media: making {Pretty(next)}. " +
                    $"{ApprovedTierCount}/{RequiredImageTypes.Count} already approved.");

                await InvokeAsync(StateHasChanged);

                await QueuePortraitAsync();

                // QueuePortraitAsync in the current Media Studio tracks Comfy
                // until completion and automatically loads the newest output.
                // This fallback also supports an older queue method that returns
                // immediately after obtaining the Comfy prompt ID.
                if (!IsExistingImage(_candidatePath) &&
                    !string.IsNullOrWhiteSpace(_promptId))
                {
                    var deadline = DateTime.UtcNow.AddMinutes(12);

                    while (DateTime.UtcNow < deadline)
                    {
                        if (_tierQueueStopRequested)
                            break;

                        var comfyState =
                            await Comfy.GetPromptStatusAsync(_promptId);

                        if (string.Equals(
                            comfyState,
                            "Failed",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            throw new InvalidOperationException(
                                $"{Pretty(next)} failed in ComfyUI.");
                        }

                        if (string.Equals(
                            comfyState,
                            "Complete",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            for (var outputAttempt = 0;
                                 outputAttempt < 10;
                                 outputAttempt++)
                            {
                                FindNewestOutput();

                                if (IsExistingImage(_candidatePath))
                                    break;

                                await Task.Delay(
                                    TimeSpan.FromSeconds(1));
                            }

                            break;
                        }

                        await Task.Delay(
                            TimeSpan.FromSeconds(2));
                    }
                }

                if (!IsExistingImage(_candidatePath))
                {
                    throw new InvalidOperationException(
                        $"{Pretty(next)} completed without a usable Comfy output file.");
                }

                SetStatus(
                    "busy",
                    $"{Pretty(next)} complete. Saving and approving automatically...");

                await InvokeAsync(StateHasChanged);

                await ApproveAsync();

                await ReloadAsync();

                if (!IsApprovedImageType(next))
                {
                    throw new InvalidOperationException(
                        $"{Pretty(next)} was generated but did not become an approved media record.");
                }

                SetStatus(
                    "ok",
                    $"{Pretty(next)} approved. Checking the next missing Tier {_sheet.Tier} picture...");

                await InvokeAsync(StateHasChanged);

                if (_tierQueueStopRequested)
                {
                    SetStatus(
                        "ok",
                        $"Tier media queue stopped after {Pretty(next)}. " +
                        $"{MissingTierTypes.Count} picture(s) remain.");
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            SetStatus(
                "fail",
                "Automatic tier media stopped: " + ex.Message);
        }
        finally
        {
            _tierQueueRunning = false;
            _tierQueueStopRequested = false;
            _tierQueueCurrentType = "";
            _busy = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private string ResolveReferencePathForGeneration(string imageType)
    {
        if (_sheet is null || imageType == "FrontReference")
            return "";

        // Once Front Reference exists it is the master identity source for
        // every downstream Tier 1/2/3 image, including Profile Picture.
        var front = _sheet.Images
            .Where(x =>
                x.Approved &&
                string.Equals(
                    NormalizeMediaType(x.ImageType),
                    "FrontReference",
                    StringComparison.OrdinalIgnoreCase) &&
                IsExistingImage(x.ImagePath))
            .OrderByDescending(x => x.IsCurrent)
            .ThenByDescending(x => x.CreatedRealAt)
            .Select(x => x.ImagePath)
            .FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(front))
            return front;

        // Tier 4 has no Front Reference. Its Profile Picture becomes the
        // identity source for Contact + Phone.
        if (imageType != "ProfilePicture")
        {
            var profile = _sheet.Images
                .Where(x =>
                    x.Approved &&
                    string.Equals(
                        NormalizeMediaType(x.ImageType),
                        "ProfilePicture",
                        StringComparison.OrdinalIgnoreCase) &&
                    IsExistingImage(x.ImagePath))
                .OrderByDescending(x => x.IsCurrent)
                .ThenByDescending(x => x.CreatedRealAt)
                .Select(x => x.ImagePath)
                .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(profile))
                return profile;
        }

        return "";
    }

    private async Task QueuePortraitAsync()
    {
        if (_sheet is null) return;

        // HARD RULE: never queue Comfy from a stale UI prompt.
        // Reload canonical dossier + appearance and rebuild immediately before send.
        _sheet = await Studio.GetCharacterSheetAsync(NpcId);
        if (_sheet is null) return;
        _appearance = AppearanceDetails.Load(NpcId);
        BuildPrompt();

        if (RequiresIdentityReference(_imageType))
        {
            var identityReference =
                ResolveIdentityReferencePath();

            if (!IsExistingImage(identityReference))
            {
                SetStatus(
                    "fail",
                    $"{Pretty(_imageType)} requires a real approved Profile/Front reference image. Text-only identity generation is blocked.");

                return;
            }
        }
        _generationStage = "Started";
        await InvokeAsync(StateHasChanged);

        _busy = true;
        SetStatus("busy", $"Queuing {Pretty(_imageType)} in ComfyUI...");

        try
        {
            var request = new NpcComfyGenerationRequest
            {
                NpcId = _sheet.Id,
                ImageType = _imageType,
                PositivePrompt = _positivePrompt,
                NegativePrompt = _negativePrompt,
                SavePrefix = $"ProjectEve/NPC_{_sheet.Id:D6}/{_imageType}",
                ReferenceImagePath = ResolveReferencePathForGeneration(_imageType),
                ReferenceDenoise =
                    ReferenceDenoiseFor(_imageType)
,
                WorkflowTemplatePath = ResolveWorkflowTemplatePath(_imageType)
,
                Seed = ResolveGenerationSeed(_imageType)
            };

            var result = await Comfy.QueueReferencePortraitAsync(request);
            _promptId = result.PromptId;
            _generationStage = "Queued";
            await InvokeAsync(StateHasChanged);


            var image = new NpcImageGeneration
            {
                Id = $"dossier-image-{Guid.NewGuid():N}",
                NpcId = _sheet.Id,
                ImageType = _imageType,
                PromptGenerationId = result.PromptId,
                PositivePrompt = request.PositivePrompt,
                NegativePrompt = request.NegativePrompt,
                Seed = request.Seed,
                WorkflowName = string.IsNullOrWhiteSpace(result.WorkflowUsed) ? request.WorkflowName : result.WorkflowUsed,
                Checkpoint = request.Checkpoint,
                Width = request.Width,
                Height = request.Height,
                Steps = request.Steps,
                Cfg = request.Cfg,
                Sampler = request.Sampler + " / " + request.Scheduler,
                ImagePath = "",
                IsCurrent = false,
                Approved = false,
                Notes = $"Queued from dossier Tier {_sheet.Tier} Media Studio. PromptId={result.PromptId}. SavePrefix={result.SavePrefix}"
            };

            await Studio.AddImageGenerationAsync(image);

            await TrackComfyProgressAsync(_promptId);
            _selectedGeneration = image;

            SetStatus(result.Success ? "ok" : "fail",
                result.Success
                    ? $"{Pretty(_imageType)} queued. When Comfy finishes, click Use Newest Comfy Output."
                    : "Comfy queue failed: " + result.Message);
        }
        catch (Exception ex)
        {
            SetStatus("fail", "Comfy error: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void FindNewestOutput()
    {
        var newest = FileSystem.FindNewestComfyOutput(NpcId);
        if (string.IsNullOrWhiteSpace(newest))
        {
            SetStatus("fail", "No NPC-specific Comfy output found yet.");
            return;
        }

        _candidatePath = newest;
        SelectNewestGenerationForType();
        SetStatus("ok", $"Newest Comfy output loaded for {Pretty(_imageType)}.");
    }

    private void SelectNewestGenerationForType()
    {
        if (_sheet is null || _sheet.Images.Count == 0)
        {
            _selectedGeneration = null;
            return;
        }

        _selectedGeneration = _sheet.Images
            .Where(x => string.Equals(x.ImageType, _imageType, StringComparison.OrdinalIgnoreCase)
                     || (_imageType == "ProfilePicture" && string.Equals(x.ImageType, "ProfessionalProfile", StringComparison.OrdinalIgnoreCase))
                     || (_imageType == "ProfilePicture" && string.Equals(x.ImageType, "ReferencePortrait", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(x => x.CreatedRealAt)
            .FirstOrDefault();
    }

    private void SelectGeneration(NpcImageGeneration image)
    {
        _selectedGeneration = image;
        if (RequiredImageTypes.Contains(image.ImageType))
            _imageType = image.ImageType;
        else if (image.ImageType is "ProfessionalProfile" or "ReferencePortrait")
            _imageType = "ProfilePicture";

        if (IsExistingImage(image.ImagePath))
            _candidatePath = image.ImagePath;

        BuildPrompt();
        SetStatus("ok", $"Selected {Pretty(_imageType)} generation.");
    }

    private async Task ApproveAsync()
    {
        if (_sheet is null) return;

        if (!IsExistingImage(_candidatePath))
        {
            SetStatus("fail", "The selected Comfy image file does not exist.");
            return;
        }

        _busy = true;
        SetStatus("busy", $"Saving {Pretty(_imageType)} into this dossier...");

        try
        {
            var generation = _selectedGeneration;

            // Old school-generated images may exist on disk without a matching
            // generation selected in this new tier-aware UI. Create the missing
            // generation record automatically so Save always works.
            if (generation is null)
            {
                generation = new NpcImageGeneration
                {
                    Id = $"dossier-image-{Guid.NewGuid():N}",
                    NpcId = _sheet.Id,
                    ImageType = _imageType,
                    PositivePrompt = _positivePrompt,
                    NegativePrompt = _negativePrompt,
                    Seed = "-1",
                    WorkflowName = "Existing Comfy output linked from dossier",
                    ImagePath = _candidatePath,
                    IsCurrent = false,
                    Approved = false,
                    Notes = "Linked automatically by the embedded dossier Media Studio."
                };

                await Studio.AddImageGenerationAsync(generation);
                _selectedGeneration = generation;
            }

            var setAsProfile = _imageType == "ProfilePicture";
            var approvedPath = _candidatePath;

            if (setAsProfile)
            {
                await FileSystem.EnsureNpcFolderLayoutAsync(_sheet);
                approvedPath = await FileSystem.CopyImageToNpcReferenceAsync(_sheet, _candidatePath);
            }

            await Studio.ApproveImageGenerationAsync(
                generation.Id,
                _sheet.Id,
                approvedPath,
                setAsProfile);

            _candidatePath = approvedPath;
            await ReloadAsync();

            SetStatus("ok",
                setAsProfile
                    ? "Profile picture saved and set as this NPC's dossier portrait."
                    : $"{Pretty(_imageType)} saved and approved in this NPC's image history.");
        }
        catch (Exception ex)
        {
            SetStatus("fail", "Save failed: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetStatus(string status, string message)
    {
        _status = status;
        _message = message;
    }

