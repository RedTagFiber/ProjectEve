@code {
    [Parameter] public int NpcId { get; set; }

    private NpcCharacterSheet? _sheet;
    private NpcAppearanceDetailProfile? _appearance;
    private NpcImageGeneration? _selectedGeneration;
    private string _imageType = "ProfilePicture";
    private string _candidatePath = "";
    private string _positivePrompt = "";
    private string _negativePrompt = DefaultNegativePrompt;
    private string _promptId = "";
    private string _status = "idle";
    private string _message = "Ready";
    private bool _busy;

    private string StatusClass => _status;
    private string StatusText => _message;

    private IReadOnlyList<string> RequiredImageTypes
    {
        get
        {
            if (_sheet is null)
                return Array.Empty<string>();

            return _sheet.Tier switch
            {
                5 => new[]
                {
                    "ProfilePicture"
                },

                4 => new[]
                {
                    "ProfilePicture",
                    "ContactPicture",
                    "PhonePicture"
                },

                3 => new[]
                {
                    "FrontReference",
                    "SideReference",
                    "BodyReference",
                    "ProfilePicture",
                    "ContactPicture",
                    "PhonePicture"
                },

                2 => new[]
                {
                    "FrontReference",
                    "SideReference",
                    "BodyReference",
                    "ProfilePicture",
                    "ContactPicture",
                    "PhonePicture",
                    "PersonalPicture",
                    "ClubPicture"
                },

                1 => new[]
                {
                    "FrontReference",
                    "SideReference",
                    "BodyReference",
                    "ProfilePicture",
                    "ContactPicture",
                    "PhonePicture",
                    "PersonalPicture",
                    "ClubPicture",
                    "HistoryPicture",
                    "SchoolHistoryPicture"
                },

                _ => new[]
                {
                    "ProfilePicture"
                }
            };
        }
    }

    private string TierDescription => _sheet?.Tier switch
    {
        5 => "Tier 5 generates one lightweight Profile Picture.",
        4 => "Tier 4 generates Profile, Contact and Phone pictures.",
        3 => "Tier 3 generates the six-image canonical identity pack: Front, Side, Body, Profile, Contact and Phone.",
        2 => "Tier 2 generates the Tier 3 identity pack plus Personal and Club / Social pictures.",
        1 => "Tier 1 generates the full media pack: identity, personal, social, history and school-history imagery.",
        _ => "This NPC uses a Profile Picture."
    };

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (NpcId <= 0) return;

        _sheet = await Studio.GetCharacterSheetAsync(NpcId);
        if (_sheet is null)
        {
            SetStatus("fail", $"NPC {NpcId} was not found.");
            return;
        }

        if (!RequiredImageTypes.Contains(_imageType))
            _imageType = RequiredImageTypes.First();

        SelectNewestGenerationForType();

        if (string.IsNullOrWhiteSpace(_positivePrompt))
            BuildPrompt();

        SetStatus("ok", $"Media loaded for {_sheet.Name}. Generate will auto-sync the latest dossier first.");
    }

    private void SelectImageType(string type)
    {
        _imageType = type;
        _candidatePath = "";
        _promptId = "";
        SelectNewestGenerationForType();
        BuildPrompt();
        SetStatus("ok", $"{Pretty(type)} selected.");
    }

    private void BuildPrompt()
    {
        if (_sheet is null)
            return;

        _appearance = AppearanceDetails.Load(_sheet.Id);
        var a = _appearance;

        var eyes = NpcAppearanceDetailService.ComposeEyes(a);
        var hair = NpcAppearanceDetailService.ComposeHair(a);
        var skin = NpcAppearanceDetailService.ComposeSkin(a);
        var face = NpcAppearanceDetailService.ComposeFace(a);
        var clothing = NpcAppearanceDetailService.ClothingForImage(a, _imageType);
        var adultBodyConsistency = AdultBodyConsistencyPrompt(a, _imageType);
        var context = BuildSceneContext();

        var identity =
            $"single-person photorealistic image of {Clean(_sheet.Name)}, age {_sheet.Age}, {Clean(_sheet.Gender)}; " +
            $"same stable canonical identity; " +
            $"overall appearance: {Clean(a.AppearanceLevel)}; " +
            $"body/build: {Clean(a.BodyBuild)}; " +
            $"eyes: {Clean(eyes)}; " +
            $"hair: {Clean(hair)}; " +
            $"skin: {Clean(skin)}; " +
            $"face: {Clean(face)}; " +
            $"clothing: {Clean(clothing)}; " +
            adultBodyConsistency;

        var imageJob = _imageType switch
        {
            "ProfilePicture" =>
                "DOSSIER PROFILE PICTURE; polished head-and-shoulders portrait; face is the visual priority; " +
                "direct natural eye contact; natural expression; flattering but realistic; shoulders visible; " +
                "clean simple background; soft even portrait lighting; realistic skin texture; " +
                "good composition for a small NPC avatar; no extreme crop; no dramatic camera angle",

            "FrontReference" =>
                "STRICT CANONICAL FRONT REFERENCE SHEET; THIS IS NOT A PROFILE PICTURE OR BEAUTY CLOSE-UP; " +
                "camera approximately 1.5 to 2 meters from subject; medium reference framing from top of head through upper chest; " +
                "subject facing exactly 0 degrees straight toward camera; head perfectly upright; shoulders square; " +
                "both eyes clearly visible and level; both sides of the face readable; both ears visible when hair permits; " +
                "neutral relaxed mouth; neutral expression; no smile pose; plain light gray reference background; " +
                "flat even clinical reference lighting; centered symmetrical composition; " +
                "leave visible space above the head and around both shoulders; " +
                "identity-document / character-model-sheet photography; structural facial reference, not glamour photography",

            "SideReference" =>
                "STRICT CANONICAL 90-DEGREE SIDE REFERENCE; edit the supplied canonical reference person into a true side view while preserving identity; " +
                "medium reference framing from top of head through upper chest; subject turned exactly 90 degrees; " +
                "one eye visible only; one ear visible only; nose, lips, chin, forehead and jaw form a clean side silhouette; " +
                "shoulders side-on; neutral expression; plain light gray background; flat even reference lighting; " +
                "no front view; no three-quarter view; no eye contact with camera; character-model-sheet reference photograph",

            "BodyReference" =>
                "STRICT CANONICAL FULL-BODY REFERENCE; edit the supplied canonical reference person while preserving the exact face and identity; " +
                "entire body visible from top of head to soles of feet; camera far enough away to include the complete figure; " +
                "upright neutral stance; arms relaxed and slightly separated from torso; both hands visible; both feet visible; " +
                "plain light gray background; flat even reference lighting; simple practical clothing; " +
                "clear readable body proportions; no fashion pose; no cinematic pose; no crop",

            "PhonePicture" =>
                PhoneScene(a),

            "ContactPicture" =>
                "natural phone contact portrait; friendly believable expression; face and shoulders visible; casual realistic crop",

            "PersonalPicture" =>
                "candid personal-life photograph appropriate to personality, age, household and normal daily life",

            "ClubPicture" =>
                "realistic club, social, hobby or activity photograph appropriate to this person's personality and lifestyle",

            "HistoryPicture" =>
                "realistic documentary-style life-history photograph; age and setting appropriate; no text overlay",

            "SchoolHistoryPicture" =>
                "realistic school-history photograph appropriate to the represented life period; documentary realism",

            _ =>
                "natural realistic portrait with clear identity and believable contemporary photography"
        };

        _positivePrompt =
            identity +
            imageJob + "; " +
            context +
            $"personality cues: {Clean(a.PersonalitySummary)}; " +
            "realistic skin texture; anatomically correct; one person only";

        _negativePrompt = _imageType switch
        {
            "FrontReference" =>
                "extreme close-up, beauty close-up, glamour portrait, fashion editorial, selfie, dramatic portrait, " +
                "cropped forehead, cropped chin, cropped shoulders, face filling entire frame, three-quarter angle, side angle, " +
                "head tilt, looking away, dramatic lighting, colored lighting, heavy beauty makeup emphasis, hair covering most of face, " +
                "wide angle distortion, fisheye, duplicate person, text, watermark, cartoon, anime, CGI, plastic skin",

            "SideReference" =>
                "front-facing, three-quarter view, looking at camera, both eyes visible, both ears visible, head turned toward camera, " +
                "extreme close-up, glamour portrait, dramatic lighting, cropped head, duplicate person, text, watermark, cartoon, anime, CGI",

            "BodyReference" =>
                "cropped body, missing feet, missing hands, sitting, crouching, fashion pose, action pose, dramatic perspective, " +
                "extreme close-up, portrait crop, duplicate person, extra limbs, malformed hands, text, watermark, cartoon, anime, CGI",

            "ProfilePicture" =>
                "extreme close-up, cropped forehead, cropped chin, distorted face, bad eyes, duplicate person, extra limbs, " +
                "text, watermark, cartoon, anime, CGI, plastic skin, low quality",

            _ => DefaultNegativePrompt
        };

        SetStatus("ok", $"{Pretty(_imageType)} prompt rebuilt from the latest canonical dossier.");
    }

    private static string AdultBodyConsistencyPrompt(NpcAppearanceDetailProfile a, string imageType)
    {
        if (a.Age < 18)
            return "";

        var isFemale =
            (a.Gender ?? "").Contains("female", StringComparison.OrdinalIgnoreCase)
            || string.Equals(a.Gender, "woman", StringComparison.OrdinalIgnoreCase);

        if (isFemale
            && !string.IsNullOrWhiteSpace(a.BraSize)
            && imageType is "FrontReference" or "SideReference" or "BodyReference")
        {
            return $"adult body proportion: clothed natural bust/chest proportions consistent with bra size {a.BraSize}; ";
        }

        return "";
    }
    private string BuildSceneContext()
    {
        if (_sheet is null) return "";

        // Only scene-specific imagery receives job/location context.
        // Identity imagery stays person-first.
        return _imageType switch
        {
            "WorkPicture" or "WorkScene" =>
                $"work context: {Clean(_sheet.Occupation)}; location context: {Clean(_sheet.Location)}; ",

            "SchoolHistoryPicture" =>
                $"school-history scene context; location context: {Clean(_sheet.Location)}; ",

            "HistoryPicture" =>
                string.IsNullOrWhiteSpace(_sheet.Location)
                    ? ""
                    : $"historical scene location context: {Clean(_sheet.Location)}; ",

            _ => ""
        };
    }

    private static string PhoneScene(NpcAppearanceDetailProfile a)
    {
        var p = (a.PersonalitySummary + " " + a.Goal + " " + a.Want).ToLowerInvariant();

        if (p.Contains("club") || p.Contains("social") || p.Contains("party"))
            return "casual smartphone selfie feel, slightly imperfect handheld framing, believable nightclub/lounge/live-music background appropriate to this person, natural ambient light";
        if (p.Contains("outdoor") || p.Contains("athletic") || p.Contains("run") || p.Contains("sport"))
            return "casual smartphone selfie feel outdoors, park/trail/street background appropriate to this person, natural daylight, spontaneous everyday framing";
        if (p.Contains("family") || p.Contains("home") || p.Contains("private"))
            return "casual smartphone selfie feel at home, believable kitchen/living-room/porch background, warm everyday atmosphere";
        if (p.Contains("work") || p.Contains("career") || p.Contains("school"))
            return "casual smartphone selfie feel near work or school, believable hallway/office/coffee-shop/outdoor workday background, not a formal headshot";

        return "casual smartphone selfie feel with a believable randomly varied everyday background such as outdoors, a coffee shop, home, car, neighborhood street or local social setting, chosen to fit the person's personality; natural imperfect framing";
    }

    private static bool RequiresIdentityReference(string imageType) =>
        imageType is
            "SideReference" or
            "BodyReference" or
            "ContactPicture" or
            "PhonePicture" or
            "PersonalPicture" or
            "ClubPicture" or
            "HistoryPicture" or
            "SchoolHistoryPicture";

    private static double ReferenceDenoiseFor(
        string imageType) =>
        imageType switch
        {
            "FrontReference" => 0.48,
            "SideReference" => 0.72,
            "BodyReference" => 0.80,
            _ => 0.65
        };

    private string ResolveIdentityReferencePath()
    {
        if (_sheet is null)
            return "";

        if (_imageType is
            "SideReference" or
            "BodyReference")
        {
            var front =
                _sheet.Images
                    .Where(x =>
                        x.Approved &&
                        string.Equals(
                            x.ImageType,
                            "FrontReference",
                            StringComparison.OrdinalIgnoreCase) &&
                        IsExistingImage(x.ImagePath))
                    .OrderByDescending(x => x.CreatedRealAt)
                    .Select(x => x.ImagePath)
                    .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(front))
                return front;
        }

        var profile =
            _sheet.Images
                .Where(x =>
                    x.Approved &&
                    string.Equals(
                        x.ImageType,
                        "ProfilePicture",
                        StringComparison.OrdinalIgnoreCase) &&
                    IsExistingImage(x.ImagePath))
                .OrderByDescending(x => x.CreatedRealAt)
                .Select(x => x.ImagePath)
                .FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(profile))
            return profile;

        if (IsExistingImage(
            _sheet.Appearance.ProfileImagePath))
        {
            return _sheet.Appearance.ProfileImagePath;
        }

        if (IsExistingImage(
            _sheet.Appearance.ReferenceImagePath))
        {
            return _sheet.Appearance.ReferenceImagePath;
        }

        return "";
    }
