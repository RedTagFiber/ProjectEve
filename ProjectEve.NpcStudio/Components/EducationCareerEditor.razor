@code {
    [Parameter] public int NpcId { get; set; }

    private CanonicalProfessionalBundle? _bundle;
    private AiEducationProfessionalProposal? _aiPreview;
    private bool _loading = true;
    private bool _busy;
    private bool _aiBusy;
    private string _message = "";
    private string _error = "";

    private static readonly string[] EducationLevels =
    [
        "Elementary School",
        "Middle School",
        "High School",
        "College / University",
        "Trade / Vocational",
        "Graduate School",
        "Doctoral / Professional School",
        "Certification / Continuing Education",
        "Other"
    ];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = "";
        try
        {
            _bundle = await Repo.GetCanonicalProfessionalBundleAsync(NpcId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateAiPreviewAsync()
    {
        if (_bundle is null) return;

        _aiBusy = true;
        _message = "";
        _error = "";

        try
        {
            _aiPreview = await AiAssist.BuildPreviewAsync(NpcId, _bundle);
            _message = "AI draft ready below. Review it before applying. Nothing has been saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void ApplyAiPreviewToForm()
    {
        if (_bundle is null || _aiPreview is null) return;

        static string Fill(string current, string proposed) =>
            string.IsNullOrWhiteSpace(current) ? (proposed ?? "") : current;

        var p = _bundle.ProfessionalProfile;
        var a = _aiPreview.Professional;

        p.PrimaryRoleId = Fill(p.PrimaryRoleId, a.PrimaryRoleId);
        p.CareerField = Fill(p.CareerField, a.CareerField);
        p.TrainingLevel = Fill(p.TrainingLevel, a.TrainingLevel);
        if (p.YearsExperience <= 0) p.YearsExperience = Math.Max(0, a.YearsExperience);
        p.LicenseStanding = Fill(p.LicenseStanding, a.LicenseStanding);
        if (p.Burnout == 0) p.Burnout = Math.Clamp(a.Burnout, 0, 100);
        if (p.Motivation == 50) p.Motivation = Math.Clamp(a.Motivation, 0, 100);
        if (p.CurrentPerformance == 50) p.CurrentPerformance = Math.Clamp(a.CurrentPerformance, 0, 100);
        if (p.ProfessionalReputation == 50) p.ProfessionalReputation = Math.Clamp(a.ProfessionalReputation, 0, 100);
        p.Notes = Fill(p.Notes, a.Notes);

        if (_bundle.Education.Count == 0)
        {
            foreach (var x in _aiPreview.Education)
            {
                _bundle.Education.Add(new CanonicalEducationRecord
                {
                    NpcId = NpcId,
                    EducationType = x.EducationType,
                    InstitutionName = x.InstitutionName,
                    DegreeOrCredential = x.DegreeOrCredential,
                    ProgramName = x.ProgramName,
                    FieldOfStudy = x.FieldOfStudy,
                    Status = string.IsNullOrWhiteSpace(x.Status) ? "Completed" : x.Status,
                    StartAge = x.StartAge,
                    EndAge = x.EndAge,
                    Gpa = x.Gpa,
                    Honors = x.Honors,
                    Notes = x.Notes
                });
            }
        }

        if (_bundle.Qualifications.Count == 0)
        {
            foreach (var x in _aiPreview.Qualifications)
            {
                _bundle.Qualifications.Add(new CanonicalProfessionalQualification
                {
                    NpcId = NpcId,
                    RoleId = p.PrimaryRoleId,
                    QualificationType = x.QualificationType,
                    Name = x.Name,
                    IssuerName = x.IssuerName,
                    Status = string.IsNullOrWhiteSpace(x.Status) ? "Active" : x.Status,
                    CredentialNumber = x.CredentialNumber,
                    Notes = x.Notes
                });
            }
        }

        if (_bundle.Competencies.Count == 0)
        {
            foreach (var x in _aiPreview.Competencies)
            {
                _bundle.Competencies.Add(new CanonicalProfessionalCompetency
                {
                    NpcId = NpcId,
                    RoleId = p.PrimaryRoleId,
                    CompetencyId = x.CompetencyId,
                    CompetencyName = x.CompetencyName,
                    CurrentValue = Math.Clamp(x.CurrentValue, 0, 100),
                    SetPointValue = Math.Clamp(x.SetPointValue, 0, 100),
                    Confidence = Math.Clamp(x.Confidence, 0, 100),
                    ExperienceLevel = x.ExperienceLevel,
                    Notes = x.Notes
                });
            }
        }

        _message = "AI draft copied into the form only. Fine tune it now; nothing is saved yet.";
    }

    private void AddEducation()
    {
        if (_bundle is null) return;
        var next = EducationLevels.FirstOrDefault(level =>
            !_bundle.Education.Any(x => string.Equals(x.EducationType, level, StringComparison.OrdinalIgnoreCase)))
            ?? "Other";

        _bundle.Education.Add(new CanonicalEducationRecord
        {
            NpcId = NpcId,
            EducationType = next,
            Status = "Completed"
        });
    }

    private void AddQualification()
    {
        if (_bundle is null) return;
        _bundle.Qualifications.Add(new CanonicalProfessionalQualification
        {
            NpcId = NpcId,
            RoleId = _bundle.ProfessionalProfile.PrimaryRoleId,
            Status = "Active"
        });
    }

    private void AddCompetency()
    {
        if (_bundle is null) return;
        _bundle.Competencies.Add(new CanonicalProfessionalCompetency
        {
            NpcId = NpcId,
            RoleId = _bundle.ProfessionalProfile.PrimaryRoleId,
            CurrentValue = 50,
            SetPointValue = 50,
            Confidence = 50
        });
    }

    private Task SaveProfessionalAsync()
        => _bundle is null
            ? Task.CompletedTask
            : SaveAndReload(
                () => Repo.SaveCanonicalProfessionalProfileAsync(_bundle.ProfessionalProfile),
                "Professional profile saved.");

    private Task SaveEducationAsync(CanonicalEducationRecord item)
    {
        item.NpcId = NpcId;
        return SaveAndReload(() => Repo.SaveCanonicalEducationAsync(item), "Education saved.");
    }

    private Task SaveQualificationAsync(CanonicalProfessionalQualification item)
    {
        item.NpcId = NpcId;
        return SaveAndReload(() => Repo.SaveCanonicalQualificationAsync(item), "Qualification saved.");
    }

    private Task SaveCompetencyAsync(CanonicalProfessionalCompetency item)
    {
        item.NpcId = NpcId;
        return SaveAndReload(() => Repo.SaveCanonicalCompetencyAsync(item), "Competency saved.");
    }

    private async Task SaveAndReload(Func<Task> action, string success)
    {
        _busy = true;
        _message = "";
        _error = "";
        try
        {
            await action();
            _bundle = await Repo.GetCanonicalProfessionalBundleAsync(NpcId);
            _message = success + " Reload confirmed.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private RenderFragment ReviewFact(string label, string? value) => builder =>
    {
        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "review-fact");

        builder.OpenElement(sequence++, "span");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "b");
        builder.AddContent(sequence++, Safe(value, "Not set"));
        builder.CloseElement();

        builder.CloseElement();
    };

    private static string Safe(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;
}


