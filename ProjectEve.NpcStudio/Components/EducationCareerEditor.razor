@using ProjectEve.NpcStudio.Models
@using ProjectEve.NpcStudio.Services
@inject ProjectEve.NpcStudio.Data.NpcStudioRepository Repo
@inject AiEducationProfessionalAssistService AiAssist

<div class="embedded-edu">
    <section class="school-reference">
        <div>
            <span>BCS SCHOOL SYSTEM</span>
            <b>Real Bellefontaine buildings · fictional ProjectEve staff</b>
            <small>K–12 courses, teacher pools, counselors, nurses, principals, custodians and support staff are now modeled.</small>
        </div>
        <a href="/npc-studio/schools">School System Reference</a>
    </section>
    @if (_loading)
    {
        <div class="edu-status">Loading education & career...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="edu-status error">@_error</div>
    }
    else if (_bundle is null)
    {
        <div class="edu-status">Education & career data unavailable.</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="edu-status success">@_message</div>
        }

        <section class="edu-ai">
            <div>
                <span class="kicker">✦ AI ASSIST</span>
                <h3>AI builds the draft. You review and fine tune it.</h3>
                <p>
                    AI reads this NPC's existing canon and proposes education, professional,
                    qualification and competency data. Nothing is saved automatically.
                </p>
            </div>
            <div class="ai-buttons">
                <button class="primary" @onclick="GenerateAiPreviewAsync" disabled="@_aiBusy">
                    @(_aiBusy ? "Building Draft..." : "Generate AI Draft")
                </button>
                @if (_aiPreview is not null)
                {
                    <button @onclick="ApplyAiPreviewToForm">Apply Reviewed Draft</button>
                }
            </div>
        </section>

        @if (_aiPreview is not null)
        {
            <details class="ai-review" open>
                <summary>
                    <div>
                        <b>AI Draft Review</b>
                        <span>Review everything before applying it to the editable form</span>
                    </div>
                    <strong>@_aiPreview.Education.Count education · @_aiPreview.Qualifications.Count qualification · @_aiPreview.Competencies.Count skills</strong>
                </summary>

                <div class="review-body">
                    @if (!string.IsNullOrWhiteSpace(_aiPreview.Summary))
                    {
                        <div class="review-summary">@_aiPreview.Summary</div>
                    }

                    <div class="review-section">
                        <h4>Professional Proposal</h4>
                        <div class="review-grid">
                            @ReviewFact("Role", _aiPreview.Professional.PrimaryRoleId)
                            @ReviewFact("Career Field", _aiPreview.Professional.CareerField)
                            @ReviewFact("Training", _aiPreview.Professional.TrainingLevel)
                            @ReviewFact("Experience", $"{_aiPreview.Professional.YearsExperience} years")
                            @ReviewFact("License", _aiPreview.Professional.LicenseStanding)
                            @ReviewFact("Motivation", _aiPreview.Professional.Motivation.ToString())
                            @ReviewFact("Performance", _aiPreview.Professional.CurrentPerformance.ToString())
                            @ReviewFact("Reputation", _aiPreview.Professional.ProfessionalReputation.ToString())
                        </div>
                    </div>

                    <div class="review-section">
                        <h4>Education Proposal</h4>
                        @if (_aiPreview.Education.Count == 0)
                        {
                            <p class="muted">AI proposed no education records.</p>
                        }
                        else
                        {
                            <div class="review-list">
                                @foreach (var item in _aiPreview.Education)
                                {
                                    <article>
                                        <b>@Safe(item.EducationType, "Education")</b>
                                        <span>@Safe(item.InstitutionName, "Institution not set")</span>
                                        <small>
                                            @Safe(item.Status, "Status not set")
                                            @if (item.StartAge is not null || item.EndAge is not null)
                                            {
                                                <text> · age @(item.StartAge?.ToString() ?? "?")–@(item.EndAge?.ToString() ?? "?")</text>
                                            }
                                        </small>
                                        @if (!string.IsNullOrWhiteSpace(item.DegreeOrCredential))
                                        {
                                            <small>@item.DegreeOrCredential</small>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </div>

                    @if (_aiPreview.Qualifications.Count > 0)
                    {
                        <div class="review-section">
                            <h4>Qualifications Proposal</h4>
                            <div class="review-list">
                                @foreach (var item in _aiPreview.Qualifications)
                                {
                                    <article>
                                        <b>@Safe(item.Name, "Qualification")</b>
                                        <span>@Safe(item.QualificationType, "Type not set")</span>
                                        <small>@Safe(item.IssuerName, "Issuer not set") · @Safe(item.Status, "Status not set")</small>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (_aiPreview.Competencies.Count > 0)
                    {
                        <div class="review-section">
                            <h4>Competencies Proposal</h4>
                            <div class="review-list">
                                @foreach (var item in _aiPreview.Competencies)
                                {
                                    <article>
                                        <b>@Safe(item.CompetencyName, "Competency")</b>
                                        <span>@Safe(item.ExperienceLevel, "Level not set")</span>
                                        <small>Current @item.CurrentValue · Set point @item.SetPointValue · Confidence @item.Confidence</small>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    <div class="review-actions">
                        <button class="primary" @onclick="ApplyAiPreviewToForm">Apply This Draft to Form</button>
                        <button @onclick="GenerateAiPreviewAsync" disabled="@_aiBusy">Regenerate</button>
                    </div>
                </div>
            </details>
        }

        <details class="edu-section" open>
            <summary>
                <div><span class="num">1</span><div><b>Education</b><small>School progression and credentials</small></div></div>
                <span>@_bundle.Education.Count records</span>
            </summary>

            <div class="section-body">
                <div class="section-toolbar">
                    <p>Elementary → Middle School → High School → College / Trade only when appropriate.</p>
                    <button @onclick="AddEducation">+ Add Education</button>
                </div>

                @if (_bundle.Education.Count == 0)
                {
                    <div class="empty-box">No education records yet.</div>
                }

                @for (var i = 0; i < _bundle.Education.Count; i++)
                {
                    var item = _bundle.Education[i];
                    var number = i + 1;

                    <details class="record" open="@(i == 0)">
                        <summary>
                            <div><b>Education @number · @Safe(item.EducationType, "Choose level")</b><small>@Safe(item.InstitutionName, "Institution not set")</small></div>
                            <span>@Safe(item.Status, "")</span>
                        </summary>

                        <div class="record-body">
                            <div class="grid">
                                <label>
                                    <span>Education Level</span>
                                    <select @bind="item.EducationType">
                                        <option value="">Select level...</option>
                                        @foreach (var level in EducationLevels)
                                        {
                                            <option value="@level">@level</option>
                                        }
                                    </select>
                                </label>
                                <label><span>School / Institution</span><input @bind="item.InstitutionName" /></label>
                                <label>
                                    <span>Status</span>
                                    <select @bind="item.Status">
                                        <option>Completed</option>
                                        <option>Currently Enrolled</option>
                                        <option>Graduated</option>
                                        <option>Transferred</option>
                                        <option>Withdrawn</option>
                                        <option>Did Not Complete</option>
                                        <option>Not Applicable</option>
                                    </select>
                                </label>
                                <label><span>Degree / Credential</span><input @bind="item.DegreeOrCredential" /></label>
                                <label><span>Program</span><input @bind="item.ProgramName" /></label>
                                <label><span>Field of Study</span><input @bind="item.FieldOfStudy" /></label>
                                <label><span>Start Age</span><input type="number" min="3" max="100" @bind="item.StartAge" /></label>
                                <label><span>End Age</span><input type="number" min="3" max="110" @bind="item.EndAge" /></label>
                                <label><span>GPA</span><input type="number" min="0" max="4" step="0.01" @bind="item.Gpa" /></label>
                            </div>

                            <label class="wide"><span>Honors</span><input @bind="item.Honors" /></label>
                            <label class="wide"><span>Notes</span><textarea rows="2" @bind="item.Notes"></textarea></label>

                            <details class="advanced">
                                <summary>Advanced / Event Links</summary>
                                <div class="grid">
                                    <label><span>Institution ID</span><input @bind="item.InstitutionId" /></label>
                                    <label><span>Start Time</span><input @bind="item.StartGameTime" /></label>
                                    <label><span>End Time</span><input @bind="item.EndGameTime" /></label>
                                    <label><span>Start Event ID</span><input @bind="item.StartEventId" /></label>
                                    <label><span>Completion Event ID</span><input @bind="item.CompletionEventId" /></label>
                                    <label><span>Withdrawal Event ID</span><input @bind="item.WithdrawalEventId" /></label>
                                </div>
                            </details>

                            <div class="actions">
                                <button class="primary" @onclick="() => SaveEducationAsync(item)" disabled="@_busy">Save Education @number</button>
                            </div>
                        </div>
                    </details>
                }
            </div>
        </details>

        <details class="edu-section" open>
            <summary>
                <div><span class="num">2</span><div><b>Professional</b><small>Current work and career truth</small></div></div>
                <span>Current profile</span>
            </summary>
            <div class="section-body">
                <div class="grid">
                    <label><span>Primary Role ID</span><input @bind="_bundle.ProfessionalProfile.PrimaryRoleId" /></label>
                    <label><span>Career Field</span><input @bind="_bundle.ProfessionalProfile.CareerField" /></label>
                    <label>
                        <span>Training Level</span>
                        <select @bind="_bundle.ProfessionalProfile.TrainingLevel">
                            <option value="">Select...</option>
                            <option>None / Entry Level</option>
                            <option>On-the-Job Training</option>
                            <option>High School / Equivalent</option>
                            <option>Trade / Vocational</option>
                            <option>Associate Degree</option>
                            <option>Bachelor's Degree</option>
                            <option>Graduate Degree</option>
                            <option>Doctoral / Professional</option>
                            <option>Licensed Professional</option>
                            <option>Retired / Former Professional</option>
                            <option>Student</option>
                        </select>
                    </label>
                    <label><span>Years Experience</span><input type="number" min="0" max="80" @bind="_bundle.ProfessionalProfile.YearsExperience" /></label>
                    <label><span>License Standing</span><input @bind="_bundle.ProfessionalProfile.LicenseStanding" /></label>
                    <label class="checkbox"><span>Profile Status</span><div><input type="checkbox" @bind="_bundle.ProfessionalProfile.IsActive" /> Active</div></label>
                </div>

                <div class="metrics">
                    <label><span>Burnout</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.Burnout" /></label>
                    <label><span>Motivation</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.Motivation" /></label>
                    <label><span>Performance</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.CurrentPerformance" /></label>
                    <label><span>Reputation</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.ProfessionalReputation" /></label>
                </div>

                <label class="wide"><span>Professional Notes</span><textarea rows="3" @bind="_bundle.ProfessionalProfile.Notes"></textarea></label>
                <div class="actions"><button class="primary" @onclick="SaveProfessionalAsync" disabled="@_busy">Save Professional</button></div>
            </div>
        </details>

        <details class="edu-section">
            <summary>
                <div><span class="num">3</span><div><b>Qualifications</b><small>Licenses and certifications</small></div></div>
                <span>@_bundle.Qualifications.Count records</span>
            </summary>
            <div class="section-body">
                <div class="section-toolbar"><p>Add only what fits the NPC's education and job.</p><button @onclick="AddQualification">+ Add Qualification</button></div>
                @foreach (var item in _bundle.Qualifications)
                {
                    <details class="record">
                        <summary><div><b>@Safe(item.Name, "Qualification")</b><small>@Safe(item.QualificationType, "")</small></div><span>@Safe(item.Status, "")</span></summary>
                        <div class="record-body">
                            <div class="grid">
                                <label><span>Role ID</span><input @bind="item.RoleId" /></label>
                                <label><span>Type</span><input @bind="item.QualificationType" /></label>
                                <label><span>Name</span><input @bind="item.Name" /></label>
                                <label><span>Issuer</span><input @bind="item.IssuerName" /></label>
                                <label><span>Status</span><input @bind="item.Status" /></label>
                                <label><span>Credential #</span><input @bind="item.CredentialNumber" /></label>
                            </div>
                            <label class="wide"><span>Notes</span><textarea rows="2" @bind="item.Notes"></textarea></label>
                            <div class="actions"><button class="primary" @onclick="() => SaveQualificationAsync(item)">Save Qualification</button></div>
                        </div>
                    </details>
                }
            </div>
        </details>

        <details class="edu-section">
            <summary>
                <div><span class="num">4</span><div><b>Competencies</b><small>What this NPC can actually do</small></div></div>
                <span>@_bundle.Competencies.Count records</span>
            </summary>
            <div class="section-body">
                <div class="section-toolbar"><p>Skills should come from education, training or work.</p><button @onclick="AddCompetency">+ Add Competency</button></div>
                @foreach (var item in _bundle.Competencies)
                {
                    <div class="competency">
                        <input @bind="item.CompetencyName" placeholder="Competency" />
                        <label><span>Current</span><input type="number" min="0" max="100" @bind="item.CurrentValue" /></label>
                        <label><span>Set Point</span><input type="number" min="0" max="100" @bind="item.SetPointValue" /></label>
                        <label><span>Confidence</span><input type="number" min="0" max="100" @bind="item.Confidence" /></label>
                        <input @bind="item.ExperienceLevel" placeholder="Beginner / Skilled / Expert" />
                        <button class="primary" @onclick="() => SaveCompetencyAsync(item)">Save</button>
                    </div>
                }
            </div>
        </details>
    }
</div>

