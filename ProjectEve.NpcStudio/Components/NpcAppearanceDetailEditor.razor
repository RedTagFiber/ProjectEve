@@media(max-width:1200px){.ade-grid.five,.ade-grid.four{grid-template-columns:repeat(2,1fr)}}@@media(max-width:700px){.ade-grid.five,.ade-grid.four,.ade-grid.three{grid-template-columns:1fr}.wide{grid-column:auto}.ade-head{flex-direction:column}}
.ancestry-picker{grid-column:span 2;display:flex;flex-direction:column;gap:8px}
.ancestry-picker>span{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#8ea3c5}
.ancestry-current{min-height:44px;padding:10px 12px;border:1px solid #344965;border-radius:10px;background:#101c2d;color:#fff;font-weight:700}
.ancestry-options{max-height:260px;overflow:auto;padding:8px;border:1px solid #344965;border-radius:10px;background:#0b1625;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}
.ancestry-option{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:7px;cursor:pointer}
