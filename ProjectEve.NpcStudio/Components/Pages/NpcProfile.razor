    private async Task DraftSharedEventViewsWithAi()
    {
        if (_sheet is null)
            return;

        if (string.IsNullOrWhiteSpace(_sharedEventDraft.TrueEventSummary))
        {
            _sharedEventAiMessage = "Enter TRUE HISTORY first.";
            return;
        }

        if (_sharedEventDraft.Participants.Count == 0)
        {
            _sharedEventAiMessage = "Select participants first.";
            return;
        }

        _sharedEventAiBusy = true;
        _sharedEventAiMessage = "Drafting participant views with local AI...";
        _sharedEventAiExtraIdeas.Clear();

        try
        {
            var result = await Studio.DraftSharedEventParticipantViewsAsync(
                _sharedEventDraft,
                _sharedEventAiOptions);

            foreach (var aiView in result.Participants)
            {
                var target = _sharedEventDraft.Participants
                    .FirstOrDefault(x => x.CharacterId == aiView.CharacterId);

                if (target is null)
                    continue;

                target.KnownHistoryOverride = aiView.KnownHistory ?? "";
                target.MemoryViewOverride = aiView.MemoryView ?? "";
                target.Interpretation = aiView.Interpretation ?? "";
                target.EmotionalMeaning = aiView.EmotionalMeaning ?? "";
            }

            _sharedEventAiExtraIdeas = result.EventExtraIdeas ?? new List<string>();
            _sharedEventAiMessage =
                $"Drafted {result.Participants.Count} participant view(s). Review and edit before saving.";
        }
        catch (Exception ex)
        {
            _sharedEventAiMessage = "AI draft failed: " + ex.Message;
        }
        finally
        {
