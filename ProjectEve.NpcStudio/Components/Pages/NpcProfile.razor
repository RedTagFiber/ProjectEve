    private IReadOnlyList<RelationshipDossierItem> FilterPeople(string? search)
    {
        if (_sheet is null)
            return Array.Empty<RelationshipDossierItem>();

        var query = (search ?? "").Trim();

        return RelationshipSubjectOptions
            .Where(x => x.TargetCharacterId != _sheet.Id)
            .Where(x => string.IsNullOrWhiteSpace(query)
                || x.TargetName.Contains(query, StringComparison.OrdinalIgnoreCase)
                || x.RelationshipType.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.Importance)
            .ThenBy(x => x.TargetName)
            .Take(8)
            .ToArray();
    }

