    private async Task SaveSharedEvent()
    {
        if (_sheet is null)
            return;

        _sharedEventDraft.AuthoringCharacterId = _sheet.Id;
        if (_sharedEventDraft.Participants.All(x => x.CharacterId != _sheet.Id))
            _sharedEventDraft.Participants.Insert(0, new NpcSharedEventParticipantDraft { CharacterId = _sheet.Id });

        try
        {
            var result = await Studio.SaveSharedEventAsync(_sharedEventDraft);

            _relationshipDossier = RelationshipDossierService.Load(_sheet.Id);
            _canonicalHistoryEvents = await Studio.GetCanonicalHistoryEventsAsync(_sheet.Id);
            _sharedEventEditorOpen = false;

            _statusMessage =
                $"Created {result.EventId}: {result.ParticipantCount} selected people, " +
                $"{result.KnownHistoryRowsCreated} known-history rows, {result.MemoryRowsCreated} memories.";
        }
        catch (Exception ex)
        {
            _statusMessage = "Shared event save failed: " + ex.Message;
        }
    }

