    private async Task GenerateAiSummary()
    {
        if (_sheet is null) return;
        _aiWorking = true;
        try
        {
            var idea = await PromptEngineer.AnalyzeCharacterAsync(_sheet,
                "Dossier Summary. Review all supplied identity, traits, history, relationships, public/private persona, appearance and voice information. Write one concise professional character summary explaining who this person is, their contradictions, what matters to them, and what is still missing. Do not invent unsupported facts.");
            if (idea is not null)
            {
                _sheet.AiSummary = idea.IdeaText;
                await Studio.AddIdeaAsync(idea);
                await SaveOverview();
                _statusMessage = "AI reviewed the dossier. Summary saved and remains fully editable.";
            }
        }
        finally { _aiWorking = false; }
    }

    private string CurrentPortraitPath => !string.IsNullOrWhiteSpace(_sheet?.Appearance.ProfileImagePath)
        ? _sheet.Appearance.ProfileImagePath
