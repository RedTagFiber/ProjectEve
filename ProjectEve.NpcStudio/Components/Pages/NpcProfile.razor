@page "/npc-studio/npc/{NpcId:int}"
@rendermode InteractiveServer
@using ProjectEve.NpcStudio.Models
@using ProjectEve.Characters.Traits
@using ProjectEve.Relationships
@inject ProjectEve.NpcStudio.Services.NpcStudioService Studio
@inject ProjectEve.NpcStudio.Services.OllamaPromptEngineerService PromptEngineer

<PageTitle>@(_sheet?.Name ?? "NPC") — Dossier</PageTitle>

<section class="dossier-page">
@if (_sheet is null)
{
    <div class="dossier-loading">Loading NPC dossier...</div>
}
else
{
    <header class="dossier-topbar">
        <div>
            <div class="dossier-kicker">PROJECT EVE · NPC DOSSIER</div>
            <div class="dossier-world">World: <strong>Small Town / Contemporary</strong></div>
        </div>
        <div class="dossier-top-actions">
            <a class="dossier-button secondary" href="/npc-studio/browser">NPC Index</a>
            <button class="dossier-button primary" @onclick="SaveOverview">Save Dossier</button>
        </div>
    </header>

    @if (_tab != "overview")
    {
    <section class="dossier-identity">
        <div class="dossier-photo-frame">
            @if (HasImagePath(CurrentPortraitPath))
            {
                <img src="@BuildImagePreviewUrl(CurrentPortraitPath)" alt="@_sheet.Name" />
            }
            else
            {
                <div class="dossier-initials">@Initials(_sheet.Name)</div>
            }
            <span class="completion-dot @CompletionClass(PhotoReady)"></span>
        </div>

        <div class="dossier-id-copy">
            <div class="dossier-rowline">
                <h1>@_sheet.Name</h1>
                <span class="dossier-status-badge">@Safe(_sheet.Status, "ACTIVE")</span>
            </div>
            <p>@Safe(_sheet.Occupation, "Occupation missing") · @Safe(_sheet.Location, "Location missing")</p>
            <div class="dossier-chips">
                <span>ID @_sheet.Id</span>
                <span>Tier @_sheet.Tier</span>
                @foreach (var archetype in Archetypes)
                {
                    <span class="accent">@archetype</span>
                }
            </div>
        </div>

        <aside class="dossier-completion">
            <div class="completion-number">@CompletionPercent%</div>
            <div class="completion-label">Dossier Complete</div>
            <div class="completion-track"><span style="width:@CompletionPercent%"></span></div>
            <div class="completion-key"><i class="green"></i> done <i class="yellow"></i> partial <i class="red"></i> missing</div>
        </aside>
    </section>

    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="dossier-message">@_statusMessage</div>
    }

    <nav class="dossier-tabs" aria-label="NPC dossier tabs">
        @foreach (var item in _tabs)
        {
            <button class="@(_tab == item.Key ? "active" : "")" @onclick="@(() => _tab = item.Key)">@item.Label</button>
        }
    </nav>

    @if (_tab == "overview")
    {
        <div class="overview-actionbar overview-actionbar-top">
            <button @onclick="@(() => _overviewEdit = !_overviewEdit)">✎ Edit Overview</button>
            <button @onclick="GenerateAiSummary" disabled="@_aiWorking">✦ @(_aiWorking ? "Reviewing..." : "Generate with AI")</button>
            <button @onclick="@(() => _tab = "history")">▣ View Full Timeline</button>
            <button @onclick="@(() => _tab = "relationships")">⌁ Open Relationships</button>
            <button @onclick="@(() => _tab = "voice")">◉ Open Voice</button>
            <button @onclick="@(() => _tab = "media")">▧ Open Media</button>
        </div>
    }

    @if (_tab == "overview")
    {
        <div class="overview-shell">
            <aside class="overview-profile-rail">
                <div class="overview-hero-photo">
                    @if (HasImagePath(CurrentPortraitPath))
                    {
                        <img src="@BuildImagePreviewUrl(CurrentPortraitPath)" alt="@_sheet.Name" />
                    }
                    else
                    {
                        <div class="dossier-initials">@Initials(_sheet.Name)</div>
                    }
                    <span class="overview-active-badge">@Safe(_sheet.Status, "ACTIVE")</span>
                </div>

                <h1>@_sheet.Name</h1>
                <p class="overview-location">@Safe(_sheet.Location, "Location missing")</p>

                <div class="overview-quick-title">Quick Summary</div>
                <dl class="overview-quick-list">
                    <div><dt>Age</dt><dd>@(_sheet.Age > 0 ? _sheet.Age.ToString() : "Missing")</dd></div>
                    <div><dt>Occupation</dt><dd>@Safe(_sheet.Occupation, "Missing")</dd></div>
                    <div><dt>Location</dt><dd>@Safe(_sheet.Location, "Missing")</dd></div>
                    <div><dt>Archetype</dt><dd>@Safe(_sheet.Archetype1, "Missing")</dd></div>
                    <div><dt>Dossier Status</dt><dd><span class="mini-status">@Safe(_sheet.Status, "ACTIVE")</span></dd></div>
                </dl>

                <div class="overview-completion-block">
                    <div class="overview-quick-title">Dossier Completion</div>
                    <div class="overview-completion-number">@CompletionPercent%</div>
                    <div class="overview-completion-bar"><span style="width:@CompletionPercent%"></span></div>
                    <div class="overview-section-status"><span>Overview</span><b class="@CompletionClass(IdentityReady && WorldReady)">@((IdentityReady && WorldReady) ? "✓" : "!")</b></div>
                    <div class="overview-section-status"><span>Traits</span><b class="@CompletionClass(_sheet.Traits.Count > 0)">@(_sheet.Traits.Count > 0 ? "✓" : "!")</b></div>
                    <div class="overview-section-status"><span>History</span><b class="@CompletionClass(_sheet.HistoryEvents.Count > 0)">@(_sheet.HistoryEvents.Count > 0 ? "✓" : "!")</b></div>
                    <div class="overview-section-status"><span>Relationships</span><b class="@CompletionClass(_sheet.Relationships.Count > 0)">@(_sheet.Relationships.Count > 0 ? "✓" : "!")</b></div>
                    <div class="overview-section-status"><span>Voice</span><b class="@CompletionClass(VoiceReady)">@(VoiceReady ? "✓" : "!")</b></div>
                    <div class="overview-section-status"><span>Media</span><b class="@CompletionClass(PhotoReady)">@(PhotoReady ? "✓" : "!")</b></div>
                </div>
            </aside>

            <div class="overview-dashboard">
                <div class="overview-grid overview-grid-top">
                    <section class="overview-card identity-card">
                        <div class="overview-card-title"><span>◎</span><h2>Identity</h2></div>
                        <div class="overview-facts two-col">
                            <div><span>Full Name</span><strong>@Safe(_sheet.Name, "Missing")</strong></div>
                            <div><span>Known As / Nickname</span><strong>@Safe(string.IsNullOrWhiteSpace(_sheet.Nickname) ? _sheet.DisplayName : _sheet.Nickname, "Missing")</strong></div>
                            <div><span>Age</span><strong>@(_sheet.Age > 0 ? _sheet.Age.ToString() : "Missing")</strong></div>
                            <div><span>Gender</span><strong>@Safe(_sheet.Gender, "Missing")</strong></div>
                            <div><span>Hometown</span><strong>@Safe(_sheet.Hometown, "Missing")</strong></div>
                            <div><span>Current Location</span><strong>@Safe(_sheet.Location, "Missing")</strong></div>
                            <div><span>Home / Address</span><strong>@Safe(_sheet.Address, "Missing")</strong></div>
                            <div><span>IQ / Intelligence</span><strong>@(_sheet.IQ > 0 ? _sheet.IQ.ToString() : "Missing")</strong></div>
                        </div>
                        <button class="overview-edit-button" @onclick="@(() => _overviewEdit = !_overviewEdit)">@(_overviewEdit ? "Close Editor" : "Edit Identity")</button>
                    </section>

                    <section class="overview-card appearance-card">
                        <div class="overview-card-title"><span>♙</span><h2>Appearance</h2></div>
                        <div class="appearance-content">
                            <div class="overview-facts appearance-facts">
                                <div><span>Height</span><strong>@(_sheet.HeightCm > 0 ? $"{_heightFeet}' {_heightInches}\"" : "Missing")</strong></div>
                                <div><span>Weight</span><strong>@(_sheet.WeightKg > 0 ? $"{_weightPounds:0.#} lb" : "Missing")</strong></div>
                                <div><span>Eye Color</span><strong>@Safe(_sheet.Appearance.EyeColor, "Missing")</strong></div>
                                <div><span>Hair Color</span><strong>@Safe(_sheet.Appearance.HairColor, "Missing")</strong></div>
                                <div><span>Hair Style</span><strong>@Safe(_sheet.Appearance.HairStyle, "Missing")</strong></div>
                                <div><span>Skin Tone</span><strong>@Safe(_sheet.Appearance.SkinTone, "Missing")</strong></div>
                                <div><span>Build / Body Type</span><strong>@Safe(_sheet.Appearance.BodyType, "Missing")</strong></div>
                                <div><span>Distinguishing Features</span><strong>@Safe(_sheet.Appearance.DistinguishingFeatures, "None recorded")</strong></div>
                            </div>
                            <div class="overview-photo-grid">
                                @PhotoThumb("Canonical Profile", !string.IsNullOrWhiteSpace(_sheet.Appearance.ProfileImagePath) ? _sheet.Appearance.ProfileImagePath : _sheet.Appearance.ReferenceImagePath)
                                @PhotoThumb("Profile Picture", _sheet.Appearance.ProfileImagePath)
                                @PhotoThumb("Contact Picture", _sheet.Appearance.ContactImagePath)
                                @foreach (var image in AdditionalPhotoImages.Take(3))
                                {
                                    @PhotoThumb(string.IsNullOrWhiteSpace(image.ImageType) ? "Reference" : image.ImageType, image.ImagePath)
                                }
                            </div>
                        </div>
                        <button class="overview-edit-button" @onclick="@(() => _tab = "media")">Open in Media →</button>
                    </section>

                    <section class="overview-card personality-card">
                        <div class="overview-card-title"><span>☆</span><h2>Personality Snapshot</h2></div>
                        <div class="personality-chips">
                            @foreach (var archetype in Archetypes)
                            {
                                <span>@archetype</span>
                            }
                            @foreach (var trait in _sheet.Traits.Where(t => t.IsEnabled).OrderByDescending(t => t.CurrentValue).Take(8))
                            {
                                <span>@trait.TraitName</span>
                            }
                            @if (!Archetypes.Any() && _sheet.Traits.Count == 0)
                            {
                                <span class="missing-chip">Needs Traits</span>
                            }
                        </div>
                        <p class="personality-copy">@Safe(_sheet.PersonalityContext, Safe(_sheet.AiSummary, "No personality summary yet. Use AI Review or add traits and history."))</p>
                        <div class="personality-meta">
                            <div><span>Core Vibe</span><strong>@Safe(_sheet.Archetype1, "Missing")</strong></div>
                            <div><span>Energy</span><strong>@Safe(_sheet.Voice.Energy, "Not set")</strong></div>
                            <div><span>Public Persona</span><strong>@Safe(_sheet.PublicPersona, "Missing")</strong></div>
                            <div><span>Private Persona</span><strong>@Safe(_sheet.PrivatePersona, "Missing")</strong></div>
                        </div>
                        <button class="overview-edit-button" @onclick="OpenPersonalityEditor">Edit Personality</button>
                    </section>
                </div>

                <div class="overview-grid overview-grid-bottom">
                    <section class="overview-card background-card">
                        <div class="overview-card-title"><span>▣</span><h2>Background</h2></div>
                        <div class="overview-facts">
                            <div><span>Occupation</span><strong>@Safe(_sheet.Occupation, "Missing")</strong></div>
                            <div><span>Hometown</span><strong>@Safe(_sheet.Hometown, "Missing")</strong></div>
                            <div><span>Home / Address</span><strong>@Safe(_sheet.Address, "Missing")</strong></div>
                            <div><span>Family Links</span><strong>@(_sheet.Relationships.Count(r => r.RelationshipCategory.Equals("Family", StringComparison.OrdinalIgnoreCase))) recorded</strong></div>
                            <div><span>Relationship Links</span><strong>@_sheet.Relationships.Count total</strong></div>
                            <div><span>History</span><strong>@_sheet.HistoryEvents.Count authored events</strong></div>
                        </div>
                        <button class="overview-edit-button" @onclick="@(() => _tab = "history")">Open History →</button>
                    </section>

                    <section class="overview-card vibe-card">
                        <div class="overview-card-title"><span>◉</span><h2>Vibe & Core Identity</h2></div>
                        <div class="overview-facts">
                            <div><span>Primary Archetype</span><strong>@Safe(_sheet.Archetype1, "Missing")</strong></div>
                            <div><span>Secondary</span><strong>@Safe(_sheet.Archetype2, "Not set")</strong></div>
                            <div><span>Third Type</span><strong>@Safe(_sheet.Archetype3, "Not set")</strong></div>
                            <div><span>Goal</span><strong>@Safe(_sheet.Goal, "Missing")</strong></div>
                            <div><span>Need</span><strong>@Safe(_sheet.Need, "Missing")</strong></div>
                            <div><span>Hidden Fear</span><strong>@Safe(_sheet.Fear, "Missing")</strong></div>
                            <div><span>What Drives Them</span><strong>@Safe(_sheet.Want, "Missing")</strong></div>
                        </div>
                        <button class="overview-edit-button" @onclick="@(() => _overviewEdit = !_overviewEdit)">Edit Core Identity</button>
                    </section>

                    <section class="overview-card status-card">
                        <div class="overview-card-title status-heading"><span>⚑</span><h2>Status & Notes</h2><span class="mini-status">@Safe(_sheet.Status, "ACTIVE")</span></div>
                        <div class="ai-dossier-read">
                            <div class="ai-label">AI Dossier Summary</div>
                            <p>@Safe(_sheet.AiSummary, "AI summary has not been generated yet. Review the dossier to create one from the current canon data.")</p>
                        </div>
                        <div class="insight-grid">
                            <div><h3>AI Insights</h3><p>@(ArchetypeReady ? $"Primary social/story identity: {_sheet.Archetype1}." : "Choose a primary NPC type to give AI a stronger behavioral anchor.")</p></div>
                            <div><h3>Current Gaps</h3><p>@MissingOverviewSummary</p></div>
                            <div class="attention"><h3>Needs Attention</h3><p>@NeedsAttentionSummary</p></div>
                        </div>
                        <div class="integrity-row"><span>Data Integrity</span><strong>@(CompletionPercent >= 80 ? "Verified / Strong" : "In Progress")</strong><span>AI Confidence</span><strong>@CompletionPercent%</strong></div>
                    </section>
                </div>
            </div>
        </div>

        @if (_overviewEdit)
        {
            <div class="overview-editor-zone">
                <div class="overview-editor-head"><div><span>EDIT MODE</span><h2>Update Canon Dossier Data</h2></div><button class="dossier-button secondary" @onclick="@(() => _overviewEdit = false)">Close Editor</button></div>

        <div class="dossier-layout">
            <main class="dossier-main">
                <details class="dossier-panel editor-collapsible" open>
                    <summary class="panel-title collapsible-title"><div><span>01</span><h2>Identity & Physical Profile</h2></div><div class="collapsible-meta"><span class="field-state @CompletionClass(IdentityReady)">@CompletionText(IdentityReady)</span><span class="collapse-chevron">⌄</span></div></summary>
        <div class="appearance-owner-note">
            Body, eyes, hair, skin, race and wardrobe are managed in Canonical Appearance below.
        </div>
                    <div class="dossier-grid four">
                        <DossierField Label="Full Name" Missing="@IsMissing(_sheet.Name)"><input @bind="_sheet.Name" /></DossierField>
                        <DossierField Label="Display Name"><input @bind="_sheet.DisplayName" /></DossierField>
                        <DossierField Label="Age" Missing="@(_sheet.Age <= 0)"><input type="number" min="0" @bind="_sheet.Age" /></DossierField>
                        <DossierField Label="Gender" Missing="@IsMissing(_sheet.Gender)"><input @bind="_sheet.Gender" /></DossierField>
                        <DossierField Label="Height" Missing="@(_sheet.HeightCm <= 0)">
                            <div class="unit-row"><input type="number" min="0" max="9" aria-label="feet" @bind="_heightFeet" /><span>ft</span><input type="number" min="0" max="11" aria-label="inches" @bind="_heightInches" /><span>in</span></div>
                        </DossierField>
                        <DossierField Label="Weight" Missing="@(_sheet.WeightKg <= 0)"><div class="unit-row single"><input type="number" min="0" step="0.1" @bind="_weightPounds" /><span>lb</span></div></DossierField>
                        <DossierField Label="IQ / Intelligence" Missing="@(_sheet.IQ <= 0)"><input type="number" min="0" max="200" @bind="_sheet.IQ" /></DossierField>
                    </div>
                </details>

                    <NpcAppearanceDetailEditor NpcId="NpcId" />

                <details class="dossier-panel editor-collapsible" open>
                    <summary class="panel-title collapsible-title"><div><span>02</span><h2>Life & World Placement</h2></div><div class="collapsible-meta"><span class="field-state @CompletionClass(WorldReady)">@CompletionText(WorldReady)</span><span class="collapse-chevron">⌄</span></div></summary>
                    <div class="dossier-grid three">
                        <DossierField Label="Occupation" Missing="@IsMissing(_sheet.Occupation)"><input @bind="_sheet.Occupation" /></DossierField>
                        <DossierField Label="Current Location" Missing="@IsMissing(_sheet.Location)"><input @bind="_sheet.Location" /></DossierField>
                        <DossierField Label="Hometown" Missing="@IsMissing(_sheet.Hometown)"><input @bind="_sheet.Hometown" /></DossierField>
                        <DossierField Label="Home / Address"><input @bind="_sheet.Address" /></DossierField>
                        <DossierField Label="Status"><input @bind="_sheet.Status" /></DossierField>
                        <DossierField Label="Tier"><input type="number" min="1" max="9" @bind="_sheet.Tier" /></DossierField>
                    </div>
                </details>

                <details class="dossier-panel editor-collapsible" open>
                    <summary class="panel-title collapsible-title"><div><span>03</span><h2>NPC Type / Archetype Seed</h2></div><div class="collapsible-meta"><span class="field-state @CompletionClass(ArchetypeReady)">@CompletionText(ArchetypeReady)</span><span class="collapse-chevron">⌄</span></div></summary>
                    <p class="panel-help">Choose up to three. Primary carries the most weight; secondary and third add contradiction and texture. These guide AI drafts but never lock the character.</p>
                    <div class="dossier-grid three">
                        <DossierField Label="Primary Type" Missing="@IsMissing(_sheet.Archetype1)"><select @bind="_sheet.Archetype1">@ArchetypeOptions(_sheet.Archetype1)</select></DossierField>
                        <DossierField Label="Secondary Type"><select @bind="_sheet.Archetype2">@ArchetypeOptions(_sheet.Archetype2, true)</select></DossierField>
                        <DossierField Label="Third Type"><select @bind="_sheet.Archetype3">@ArchetypeOptions(_sheet.Archetype3, true)</select></DossierField>
                    </div>
                </details>

                <details class="dossier-panel editor-collapsible" open>
                    <summary class="panel-title collapsible-title"><div><span>04</span><h2>Public vs Private Person</h2></div><div class="collapsible-meta"><span class="field-state @CompletionClass(PersonaReady)">@CompletionText(PersonaReady)</span><span class="collapse-chevron">⌄</span></div></summary>
                    <div class="dossier-grid three">
                        <DossierField Label="Public Persona" Missing="@IsMissing(_sheet.PublicPersona)"><textarea rows="5" @bind="_sheet.PublicPersona"></textarea></DossierField>
                        <DossierField Label="Private Persona"><textarea rows="5" @bind="_sheet.PrivatePersona"></textarea></DossierField>
                        <DossierField Label="Hidden Traits / Behavior"><textarea rows="5" @bind="_sheet.HiddenBehavior"></textarea></DossierField>
                    </div>
                </details>

                <details class="dossier-panel editor-collapsible" open>
                    <summary class="panel-title collapsible-title"><div><span>05</span><h2>Inner Life</h2></div><div class="collapsible-meta"><span class="field-state @CompletionClass(InnerLifeReady)">@CompletionText(InnerLifeReady)</span><span class="collapse-chevron">⌄</span></div></summary>
                    <div class="dossier-grid two">
                        <DossierField Label="Goal" Missing="@IsMissing(_sheet.Goal)"><textarea rows="3" @bind="_sheet.Goal"></textarea></DossierField>
                        <DossierField Label="Need" Missing="@IsMissing(_sheet.Need)"><textarea rows="3" @bind="_sheet.Need"></textarea></DossierField>
                        <DossierField Label="Fear" Missing="@IsMissing(_sheet.Fear)"><textarea rows="3" @bind="_sheet.Fear"></textarea></DossierField>
                        <DossierField Label="Want" Missing="@IsMissing(_sheet.Want)"><textarea rows="3" @bind="_sheet.Want"></textarea></DossierField>
                    </div>
                </details>

                <div class="save-strip">
                    <button class="dossier-button primary" @onclick="SaveOverview">Save Overview</button>
                    <button class="dossier-button secondary" @onclick="SaveAppearance">Save Height / Weight Core</button>
                </div>
            </main>

            <aside class="dossier-side">
                <section class="dossier-panel personality-snapshot">
                    <div class="panel-title compact"><div><h2>Personality Snapshot</h2></div></div>
                    @if (_sheet.Traits.Count == 0)
                    {
                        <p class="empty-copy">No trait values yet. Add them under Traits.</p>
                    }
                    else
                    {
                        @foreach (var trait in _sheet.Traits.Where(t => t.IsEnabled).OrderByDescending(t => t.CurrentValue).Take(6))
                        {
                            <div class="trait-meter">
                                <div><span>@trait.TraitName</span><strong>@trait.CurrentValue</strong></div>
                                <div class="meter"><span style="width:@ClampPercent(trait.CurrentValue)%"></span></div>
                            </div>
                        }
                    }
                    <button class="text-button" @onclick="@(() => _tab = "traits")">Open full Traits →</button>
                </section>

                <section class="dossier-panel ai-summary">
                    <div class="panel-title compact"><div><h2>AI Dossier Summary</h2></div><span class="ai-mark">AI</span></div>
                    <textarea rows="9" placeholder="AI can summarize the complete dossier here. You can edit or override every word." @bind="_sheet.AiSummary"></textarea>
                    <button class="dossier-button primary full" @onclick="GenerateAiSummary" disabled="@_aiWorking">@(_aiWorking ? "Reviewing dossier..." : "Review Everything & Refresh Summary")</button>
                    <p class="panel-help">AI draft only. You remain the final authority on canon.</p>
                </section>

                <section class="dossier-panel quick-status">
                    <div class="panel-title compact"><div><h2>Status & Notes</h2></div></div>
                    <textarea rows="6" placeholder="Current build notes, missing work, author notes..." @bind="_sheet.StatusNotes"></textarea>
                    <div class="status-list">
                        <span><i class="@CompletionClass(PhotoReady)"></i> Photo identity</span>
                        <span><i class="@CompletionClass(VoiceReady)"></i> Voice identity</span>
                        <span><i class="@CompletionClass(_sheet.HistoryEvents.Count > 0)"></i> Life history</span>
                        <span><i class="@CompletionClass(_sheet.Relationships.Count > 0)"></i> Relationships</span>
                    </div>
                </section>
            </aside>
        </div>

            </div>
        }
    }

    else if (_tab == "personal")
    {
        <NpcPersonalPanel NpcId="_sheet.Id" Character="_sheet" />
    }
    else if (_tab == "traits")
    {
        <div class="trait-subtab-row">
            <nav class="trait-subtabs" aria-label="Trait sections">
                @foreach (var item in _traitSubTabs)
                {
                    <button class="@(_traitSubTab == item.Key ? "active" : "")"
                            @onclick="@(() => SelectTraitSubTab(item.Key))">
                        @item.Label
                    </button>
                }
            </nav>

            @if (_traitSubTab != "summary")
            {
                <button class="trait-back-summary"
                        type="button"
                        @onclick="BackToTraitSummary">
                    ← Back to Summary
                </button>
            }
        </div>

        @if (_traitSubTab == "summary")
        {
        <section class="dossier-panel wide-panel trait-summary-panel">
            <div class="panel-title">
                <div><span>Σ</span><h2>Trait Summary</h2></div>
                <span class="field-state green">READ ONLY</span>
            </div>
            <p class="panel-help">
                Scan only — nothing can be changed here. Click any trait that looks wrong and NpcStudio opens that exact Fast20, Mid, or Slow editor.
            </p>

            <div class="trait-summary-stats">
                <div>
                    <span>FAST20</span>
                    <strong>@_fast20Dossier.Count</strong>
                    <small>@_fast20Dossier.Count(x => x.IsWildcard) wildcard</small>
                </div>
                <div>
                    <span>MID</span>
                    <strong>@_midDossier.Active.Count</strong>
                    <small>@_midDossier.Active.Count(x => Math.Abs(x.DeviationFromBaseline) >= 30) strong deviation</small>
                </div>
                <div>
                    <span>SLOW</span>
                    <strong>@_slowDossier.Active.Count</strong>
                    <small>@_slowDossier.Active.Count(x => Math.Abs(x.DeviationFromBaseline) >= 30) strong deviation</small>
                </div>
            </div>

            @{
                var fastAttention = _fast20Dossier
                    .Where(x => x.IsWildcard || Math.Abs(x.DeviationFromBaseline) >= 30)
                    .OrderByDescending(x => x.IsWildcard)
                    .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                    .Take(8)
                    .ToArray();

                var midAttention = _midDossier.Active
                    .Where(x => x.DefinitionMissing || Math.Abs(x.DeviationFromBaseline) >= 30)
                    .OrderByDescending(x => x.DefinitionMissing)
                    .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                    .Take(6)
                    .ToArray();

                var slowAttention = _slowDossier.Active
                    .Where(x => x.DefinitionMissing || Math.Abs(x.DeviationFromBaseline) >= 30)
                    .OrderByDescending(x => x.DefinitionMissing)
                    .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                    .Take(6)
                    .ToArray();
            }

            @if (fastAttention.Length > 0 || midAttention.Length > 0 || slowAttention.Length > 0)
            {
                <section class="trait-attention-panel">
                    <header>
                        <div>
                            <span>QUICK CHECK</span>
                            <h3>Things worth looking at first</h3>
                        </div>
                        <small>Click to open the exact trait</small>
                    </header>

                    <div class="trait-attention-list">
                        @foreach (var item in fastAttention)
                        {
                            <button type="button"
                                    class="@(item.IsWildcard ? "wildcard" : "")"
                                    @onclick="@(() => OpenTraitEditor("fast", item.TraitId))">
                                <span class="attention-layer">FAST20</span>
                                <strong>@item.TraitName</strong>
                                <small>@item.StageLabel · deviation @Signed(item.DeviationFromBaseline)</small>
                                <b>@item.CurrentValue.ToString("0")</b>
                            </button>
                        }

                        @foreach (var item in midAttention)
                        {
                            <button type="button"
                                    class="@(item.DefinitionMissing ? "missing" : "")"
                                    @onclick="@(() => OpenTraitEditor("mid", item.TraitId))">
                                <span class="attention-layer">MID</span>
                                <strong>@item.TraitName</strong>
                                <small>@(item.DefinitionMissing ? "definition missing" : $"deviation {Signed(item.DeviationFromBaseline)}")</small>
                                <b>@item.CurrentValue.ToString("0")</b>
                            </button>
                        }

                        @foreach (var item in slowAttention)
                        {
                            <button type="button"
                                    class="@(item.DefinitionMissing ? "missing" : "")"
                                    @onclick="@(() => OpenTraitEditor("slow", item.TraitId))">
                                <span class="attention-layer">SLOW</span>
                                <strong>@item.TraitName</strong>
                                <small>@(item.DefinitionMissing ? "definition missing" : $"deviation {Signed(item.DeviationFromBaseline)}")</small>
                                <b>@item.CurrentValue.ToString("0")</b>
                            </button>
                        }
                    </div>
                </section>
            }

            <div class="trait-summary-grid">
                <section class="trait-summary-group fast-summary">
                    <header>
                        <div>
                            <span>FAST20</span>
                            <h3>Emotional State</h3>
                        </div>
                        <span>@_fast20Dossier.Count traits</span>
                    </header>

                    <div class="trait-summary-list">
                        @foreach (var item in _fast20Dossier
                            .OrderByDescending(x => x.IsWildcard)
                            .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                            .ThenBy(x => x.TraitName))
                        {
                            <button type="button"
                                    class="@(item.IsWildcard ? "summary-wildcard" : "")"
                                    @onclick="@(() => OpenTraitEditor("fast", item.TraitId))">
                                <span>
                                    <strong>@item.TraitName</strong>
                                    <small>
                                        @item.StageLabel · Δ @Signed(item.DeviationFromBaseline)
                                        @if (!string.IsNullOrWhiteSpace(item.Style))
                                        {
                                            <text> · @StyleLabel(item.Style)</text>
                                        }
                                    </small>
                                </span>
                                <b>@item.CurrentValue.ToString("0")</b>
                            </button>
                        }
                    </div>
                </section>

                <section class="trait-summary-group mid-summary">
                    <header>
                        <div>
                            <span>MID</span>
                            <h3>Personality</h3>
                        </div>
                        <span>@_midDossier.Active.Count active</span>
                    </header>

                    @if (_midDossier.Active.Count == 0)
                    {
                        <p class="empty-copy">No Mid traits assigned.</p>
                    }
                    else
                    {
                        <div class="trait-summary-list">
                            @foreach (var item in _midDossier.Active
                                .OrderByDescending(x => x.DefinitionMissing)
                                .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                                .ThenBy(x => x.TraitName))
                            {
                                <button type="button"
                                        class="@(item.DefinitionMissing ? "summary-missing" : "")"
                                        @onclick="@(() => OpenTraitEditor("mid", item.TraitId))">
                                    <span>
                                        <strong>@item.TraitName</strong>
                                        <small>
                                            Δ @Signed(item.DeviationFromBaseline)
                                            @if (!string.IsNullOrWhiteSpace(item.Style))
                                            {
                                                <text> · @StyleLabel(item.Style)</text>
                                            }
                                            @if (item.DefinitionMissing)
                                            {
                                                <text> · definition missing</text>
                                            }
                                        </small>
                                    </span>
                                    <b>@item.CurrentValue.ToString("0")</b>
                                </button>
                            }
                        </div>
                    }
                </section>

                <section class="trait-summary-group slow-summary">
                    <header>
                        <div>
                            <span>SLOW</span>
                            <h3>Preferences</h3>
                        </div>
                        <span>@_slowDossier.Active.Count active</span>
                    </header>

                    @if (_slowDossier.Active.Count == 0)
                    {
                        <p class="empty-copy">No Slow traits assigned.</p>
                    }
                    else
                    {
                        @foreach (var group in _slowDossier.Active
                            .GroupBy(x => GetSlowCategory(x.TraitId))
                            .OrderBy(x => SlowCategoryOrder(x.Key))
                            .ThenBy(x => x.Key))
                        {
                            <div class="summary-slow-category">
                                <header>
                                    <strong>@group.Key</strong>
                                    <span>@group.Count()</span>
                                </header>

                                <div class="trait-summary-list">
                                    @foreach (var item in group
                                        .OrderByDescending(x => x.DefinitionMissing)
                                        .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                                        .ThenBy(x => x.TraitName))
                                    {
                                        <button type="button"
                                                class="@(item.DefinitionMissing ? "summary-missing" : "")"
                                                @onclick="@(() => OpenTraitEditor("slow", item.TraitId))">
                                            <span>
                                                <strong>@item.TraitName</strong>
                                                <small>
                                                    Δ @Signed(item.DeviationFromBaseline)
                                                    @if (!string.IsNullOrWhiteSpace(item.Style))
                                                    {
                                                        <text> · @StyleLabel(item.Style)</text>
                                                    }
                                                    @if (item.DefinitionMissing)
                                                    {
                                                        <text> · definition missing</text>
                                                    }
                                                </small>
                                            </span>
                                            <b>@item.CurrentValue.ToString("0")</b>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </section>
            </div>
        </section>

        }
        else if (_traitSubTab == "fast")
        {
        <section class="dossier-panel wide-panel fast20-dossier-panel">
            <div class="panel-title">
                <div><span>20</span><h2>Fast20 Emotional State</h2></div>
                <span class="field-state @CompletionClass(_fast20Dossier.Count == 20)">@_fast20Dossier.Count / 20</span>
            </div>
            <p class="panel-help">Live Fast20 state assembled from canonical trait values plus causal reason/history records. Stage and Wildcard are derived from CurrentValue; they are not duplicated in SQL.</p>

            @if (_fast20Dossier.Count == 0)
            {
                <div class="empty-state">
                    <strong>No Fast20 dossier rows loaded.</strong>
                    <span>Persisted trait values may not exist for this NPC yet.</span>
                </div>
            }
            else
            {
                <div class="fast20-grid">
                    @foreach (var item in _fast20Dossier.OrderByDescending(x => IsTraitFocused(x.TraitId)).ThenByDescending(x => x.IsWildcard).ThenByDescending(x => Math.Abs(x.DeviationFromBaseline)).ThenBy(x => x.TraitName))
                    {
                        <article class="fast20-card @(item.IsWildcard ? "wildcard" : "") @(IsTraitFocused(item.TraitId) ? "trait-focus" : "")">
                            <header>
                                <div>
                                    <h3>@item.TraitName</h3>
                                    <span class="fast20-id">@item.TraitId</span>
                                </div>
                                <div class="fast20-score">@item.CurrentValue.ToString("0")</div>
                            </header>

                            <div class="fast20-stage-row">
                                <span class="fast20-stage">@item.StageLabel · @item.StageMin–@item.StageMax</span>
                                @if (item.IsWildcard)
                                {
                                    <span class="wildcard-badge">WILDCARD</span>
                                }
                            </div>

                            <div class="fast20-meter">
                                <span style="width:@ClampFastPercent(item.CurrentValue)%"></span>
                                <i style="left:@ClampFastPercent(item.Baseline)%"></i>
                            </div>

                            <div class="fast20-edit-grid">
                                <label class="fast20-slider-field">
                                    <span>Current</span>
                                    <div class="fast20-slider-row">
                                        <input class="fast20-range"
                                               type="range"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.CurrentValue"
                                               @bind:event="oninput" />
                                        <input class="fast20-number"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.CurrentValue" />
                                    </div>
                                </label>
                                <label class="fast20-slider-field">
                                    <span>Baseline</span>
                                    <div class="fast20-slider-row">
                                        <input class="fast20-range"
                                               type="range"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.Baseline"
                                               @bind:event="oninput" />
                                        <input class="fast20-number"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.Baseline" />
                                    </div>
                                </label>
                                <label>
                                    <span>Deviation</span>
                                    <strong class="@DeviationClass(item.DeviationFromBaseline)">@Signed(item.DeviationFromBaseline)</strong>
                                </label>
                                <label class="style-editor">
                                    <span>Style</span>
                                    <select @bind="item.Style">
                                        <option value="">— default —</option>
                                        @foreach (var styleOption in item.StyleOptions)
                                        {
                                            <option value="@styleOption">@StyleLabel(styleOption)</option>
                                        }
                                    </select>
                                </label>
                                <button class="dossier-button tiny fast20-save" @onclick="@(() => SaveFastTrait(item))">Save Trait</button>
                            </div>

                            <div class="fast20-why">
                                <div class="fast20-why-head">
                                    <span class="fast20-mini-label">Why now</span>
                                    <span class="reason-count">@item.ActiveReasons.Count active</span>
                                </div>

                                @if (item.ActiveReasons.Count == 0)
                                {
                                    <p class="muted">No active causal reason recorded yet.</p>
                                }
                                else
                                {
                                    @foreach (var reason in item.ActiveReasons.Take(8))
                                    {
                                        var edit = GetReasonEdit(reason);

                                        <details class="reason-editor">
                                            <summary>
                                                <b class="@ImpactClass(reason.Impact)">@Signed(reason.Impact)</b>
                                                <span>@FastValue(reason.Reason, reason.ReasonType)</span>
                                                <small>@FastValue(reason.ReasonType, "reason")</small>
                                            </summary>

                                            <div class="reason-editor-grid">
                                                <label class="reason-wide">
                                                    <span>Reason</span>
                                                    <input @bind="edit.Reason" />
                                                </label>

                                                <label>
                                                    <span>Type</span>
                                                    <input @bind="edit.ReasonType" placeholder="event, memory, relationship..." />
                                                </label>

                                                <label>
                                                    <span>Impact</span>
                                                    <input type="number" min="-100" max="100" step="1" @bind="edit.Impact" />
                                                </label>

                                                <label>
                                                    <span>Confidence</span>
                                                    <input type="number" min="0" max="100" step="1" @bind="edit.Confidence" />
                                                </label>

                                                <label>
                                                    <span>Target NPC</span>
                                                    <input type="number" min="-1" step="1" @bind="edit.TargetCharacterId" />
                                                </label>

                                                <label>
                                                    <span>Source Type</span>
                                                    <input @bind="edit.SourceType" placeholder="event / memory / author" />
                                                </label>

                                                <label>
                                                    <span>Event Ref</span>
                                                    <input @bind="edit.SourceEventId" />
                                                </label>

                                                <label>
                                                    <span>Memory Ref</span>
                                                    <input @bind="edit.SourceMemoryId" />
                                                </label>

                                                <div class="reason-actions reason-wide">
                                                    <button class="dossier-button tiny" @onclick="@(() => SaveReason(item, edit))">Save Reason</button>
                                                    <button class="danger-link" @onclick="@(() => DeactivateReason(item, edit.Id))">Deactivate</button>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                }

                                @{
                                    var draft = GetNewReasonDraft(item.TraitId);
                                }
                                <details class="reason-editor add-reason-editor">
                                    <summary>
                                        <b>+</b>
                                        <span>Add causal reason</span>
                                        <small>subjective evidence</small>
                                    </summary>

                                    <div class="reason-editor-grid">
                                        <label class="reason-wide">
                                            <span>Reason</span>
                                            <input @bind="draft.Reason" placeholder="What is causing this trait state?" />
                                        </label>

                                        <label>
                                            <span>Type</span>
                                            <input @bind="draft.ReasonType" placeholder="event, memory, relationship..." />
                                        </label>

                                        <label>
                                            <span>Impact</span>
                                            <input type="number" min="-100" max="100" step="1" @bind="draft.Impact" />
                                        </label>

                                        <label>
                                            <span>Confidence</span>
                                            <input type="number" min="0" max="100" step="1" @bind="draft.Confidence" />
                                        </label>

                                        <label>
                                            <span>Target NPC</span>
                                            <input type="number" min="-1" step="1" @bind="draft.TargetCharacterId" />
                                        </label>

                                        <label>
                                            <span>Source Type</span>
                                            <input @bind="draft.SourceType" placeholder="author / event / memory" />
                                        </label>

                                        <label>
                                            <span>Event Ref</span>
                                            <input @bind="draft.SourceEventId" />
                                        </label>

                                        <label>
                                            <span>Memory Ref</span>
                                            <input @bind="draft.SourceMemoryId" />
                                        </label>

                                        <div class="reason-actions reason-wide">
                                            <button class="dossier-button tiny primary" @onclick="@(() => AddReason(item, draft))">Add Reason</button>
                                        </div>
                                    </div>
                                </details>
                            </div>

                            <div class="fast20-last">
                                <span class="fast20-mini-label">Last meaningful change</span>
                                @if (item.LastChange is null)
                                {
                                    <p class="muted">No change history recorded.</p>
                                }
                                else
                                {
                                    <div class="last-change-line">
                                        <strong>@item.LastChange.BeforeValue.ToString("0.#") → @item.LastChange.AfterValue.ToString("0.#")</strong>
                                        <span>@FastValue(item.LastChange.Reason, item.LastChange.ReasonType)</span>
                                    </div>
                                    <small>@FastValue(item.LastChange.GameTime, item.LastChange.CreatedRealAt)</small>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        }
        else if (_traitSubTab == "mid")
        {
        <section class="dossier-panel wide-panel personality-editor-panel">
            <div class="panel-title">
                <div><span>P</span><h2>Personality & Presentation</h2></div>
                <span class="field-state @CompletionClass(PersonaReady)">@CompletionText(PersonaReady)</span>
            </div>
            <p class="panel-help">This is the editable source behind the Personality Snapshot. Public image, private reality and hidden behavior can all be different.</p>
            <div class="dossier-grid four personality-editor-grid">
                <DossierField Label="Primary NPC Type" Missing="@IsMissing(_sheet.Archetype1)"><select @bind="_sheet.Archetype1">@ArchetypeOptions(_sheet.Archetype1)</select></DossierField>
                <DossierField Label="Secondary Type"><select @bind="_sheet.Archetype2">@ArchetypeOptions(_sheet.Archetype2, true)</select></DossierField>
                <DossierField Label="Third Type"><select @bind="_sheet.Archetype3">@ArchetypeOptions(_sheet.Archetype3, true)</select></DossierField>
                <DossierField Label="Energy" Missing="@IsMissing(_sheet.Voice.Energy)"><input placeholder="Warm & steady, intense, low-key..." @bind="_sheet.Voice.Energy" /></DossierField>
            </div>
            <div class="dossier-grid three personality-text-grid">
                <DossierField Label="Public Persona" Missing="@IsMissing(_sheet.PublicPersona)"><textarea rows="5" placeholder="How the world usually sees this person..." @bind="_sheet.PublicPersona"></textarea></DossierField>
                <DossierField Label="Private Persona"><textarea rows="5" placeholder="Who they are behind closed doors..." @bind="_sheet.PrivatePersona"></textarea></DossierField>
                <DossierField Label="Hidden Traits / Behavior"><textarea rows="5" placeholder="Secrets, contradictions, habits or behavior most people do not see..." @bind="_sheet.HiddenBehavior"></textarea></DossierField>
            </div>
            <DossierField Label="Personality Snapshot / Author Context"><textarea rows="4" placeholder="Short author-facing summary of how this person tends to think, feel and behave..." @bind="_sheet.PersonalityContext"></textarea></DossierField>
            <div class="personality-editor-footer">
                <span>Changes update the same canon data used by In-Person and Message behavior tests.</span>
                <button class="dossier-button primary" @onclick="SavePersonality">Save Personality</button>
            </div>
        </section>

        <section class="dossier-panel wide-panel mid-dossier-panel">
            <div class="panel-title">
                <div><span>M</span><h2>Mid Personality Traits</h2></div>
                <span class="field-state @CompletionClass(_midDossier.Active.Count > 0)">
                    @_midDossier.Active.Count active / @_midDossier.TotalDefinitions available
                </span>
            </div>
            <p class="panel-help">
                Mid traits are authored personality tendencies. Only explicitly assigned traits become NPC facts;
                unassigned definitions remain available vocabulary and are not silently created at 50.
            </p>

            @if (_midDossier.Active.Count == 0)
            {
                <div class="empty-state mid-empty">
                    <strong>No Mid personality traits assigned.</strong>
                    <span>Choose a definition below to intentionally add one to this NPC.</span>
                </div>
            }
            else
            {
                <div class="mid-grid">
                    @foreach (var item in _midDossier.Active
                        .OrderByDescending(x => IsTraitFocused(x.TraitId))
                        .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                        .ThenBy(x => x.TraitName))
                    {
                        <article class="mid-card @(item.DefinitionMissing ? "definition-missing" : "") @(IsTraitFocused(item.TraitId) ? "trait-focus" : "")">
                            <header>
                                <div>
                                    <h3>@item.TraitName</h3>
                                    <span class="mid-id">@item.TraitId</span>
                                </div>
                                <div class="mid-score">@item.CurrentValue.ToString("0")</div>
                            </header>

                            @if (item.DefinitionMissing)
                            {
                                <div class="mid-warning">JSON definition missing — persisted row preserved.</div>
                            }

                            <div class="mid-meter">
                                <span style="width:@ClampFastPercent(item.CurrentValue)%"></span>
                                <i style="left:@ClampFastPercent(item.Baseline)%"></i>
                            </div>

                            <div class="mid-edit-grid">
                                <label class="mid-slider-field">
                                    <span>Intensity</span>
                                    <div class="mid-slider-row">
                                        <input class="mid-range"
                                               type="range"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.CurrentValue"
                                               @bind:event="oninput" />
                                        <input class="mid-number"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.CurrentValue" />
                                    </div>
                                </label>

                                <label class="mid-slider-field">
                                    <span>Set-point</span>
                                    <div class="mid-slider-row">
                                        <input class="mid-range"
                                               type="range"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.Baseline"
                                               @bind:event="oninput" />
                                        <input class="mid-number"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="1"
                                               @bind="item.Baseline" />
                                    </div>
                                </label>

                                <label>
                                    <span>Deviation</span>
                                    <strong class="@DeviationClass(item.DeviationFromBaseline)">
                                        @Signed(item.DeviationFromBaseline)
                                    </strong>
                                </label>

                                <label class="mid-style-editor">
                                    <span>Style</span>
                                    <select @bind="item.Style">
                                        <option value="">— default —</option>
                                        @foreach (var style in item.StyleOptions)
                                        {
                                            <option value="@style">@StyleLabel(style)</option>
                                        }
                                    </select>

                                    @if (item.StyleOptions.Count > 0)
                                    {
                                        <div class="mid-style-preview">
                                            @foreach (var previewStyle in item.StyleOptions.Take(4))
                                            {
                                                <button type="button"
                                                        class="mid-style-chip @(string.Equals(item.Style, previewStyle, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                                        @onclick="@(() => item.Style = previewStyle)">
                                                    @StyleLabel(previewStyle)
                                                </button>
                                            }

                                            @if (item.StyleOptions.Count > 4)
                                            {
                                                <span class="mid-style-more">
                                                    +@(item.StyleOptions.Count - 4) more
                                                </span>
                                            }
                                        </div>
                                    }
                                </label>

                                <div class="mid-actions">
                                    <button class="dossier-button tiny" @onclick="@(() => SaveMidTrait(item))">
                                        Save
                                    </button>
                                    <button class="danger-link" @onclick="@(() => DeactivateMidTrait(item))">
                                        Deactivate
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

            <div class="mid-add-strip">
                <label>
                    <span>Add Mid trait</span>
                    <select @bind="_newMidTraitId">
                        <option value="">Choose available definition…</option>
                        @foreach (var definition in _midDossier.Available)
                        {
                            <option value="@definition.TraitId">
                                @definition.Label (@definition.TraitId)
                            </option>
                        }
                    </select>
                </label>
                <button class="dossier-button primary"
                        disabled="@string.IsNullOrWhiteSpace(_newMidTraitId)"
                        @onclick="AddMidTrait">
                    Add Mid Trait
                </button>
            </div>
        </section>

        }
        else if (_traitSubTab == "slow")
        {
        <section class="dossier-panel wide-panel slow-dossier-panel">
            <div class="panel-title">
                <div><span>S</span><h2>Slow Traits / Long-Term Preferences</h2></div>
                <span class="field-state @CompletionClass(_slowDossier.Active.Count > 0)">
                    @_slowDossier.Active.Count active / @_slowDossier.TotalDefinitions available
                </span>
            </div>
            <p class="panel-help">
                Slow traits describe longer-term tastes and preferences. Missing definitions stay missing;
                only explicitly assigned Slow traits become NPC facts.
            </p>

            @if (_slowDossier.Active.Count == 0)
            {
                <div class="empty-state">
                    <strong>No Slow traits assigned.</strong>
                    <span>Choose an available definition below to intentionally add one.</span>
                </div>
            }
            else
            {
                <div class="slow-sections">
                    @foreach (var group in _slowDossier.Active
                        .GroupBy(x => GetSlowCategory(x.TraitId))
                        .OrderBy(x => SlowCategoryOrder(x.Key))
                        .ThenBy(x => x.Key))
                    {
                        <section class="slow-category-section">
                            <header class="slow-category-header">
                                <div>
                                    <span class="slow-category-kicker">SLOW LAYER</span>
                                    <h3>@group.Key</h3>
                                </div>
                                <span>@group.Count() active</span>
                            </header>

                            <div class="slow-grid">
                                @foreach (var item in group
                                    .OrderByDescending(x => IsTraitFocused(x.TraitId))
                                    .ThenByDescending(x => Math.Abs(x.DeviationFromBaseline))
                                    .ThenBy(x => x.TraitName))
                                {
                                    <article class="slow-card @(IsTraitFocused(item.TraitId) ? "trait-focus" : "")">
                                        <header>
                                            <div>
                                                <h3>@item.TraitName</h3>
                                                <span>@item.TraitId</span>
                                            </div>
                                            <strong>@item.CurrentValue.ToString("0")</strong>
                                        </header>

                                        <div class="slow-meter">
                                            <span style="width:@ClampFastPercent(item.CurrentValue)%"></span>
                                            <i style="left:@ClampFastPercent(item.Baseline)%"></i>
                                        </div>

                                        <div class="slow-edit-grid">
                                            <label>
                                                <span>Preference Strength</span>
                                                <div class="slow-slider-row">
                                                    <input class="slow-range"
                                                           type="range"
                                                           min="0"
                                                           max="100"
                                                           step="1"
                                                           @bind="item.CurrentValue"
                                                           @bind:event="oninput" />
                                                    <input class="slow-number"
                                                           type="number"
                                                           min="0"
                                                           max="100"
                                                           step="1"
                                                           @bind="item.CurrentValue" />
                                                </div>
                                            </label>

                                            <label>
                                                <span>Set-point</span>
                                                <div class="slow-slider-row">
                                                    <input class="slow-range"
                                                           type="range"
                                                           min="0"
                                                           max="100"
                                                           step="1"
                                                           @bind="item.Baseline"
                                                           @bind:event="oninput" />
                                                    <input class="slow-number"
                                                           type="number"
                                                           min="0"
                                                           max="100"
                                                           step="1"
                                                           @bind="item.Baseline" />
                                                </div>
                                            </label>

                                            <label>
                                                <span>Deviation</span>
                                                <strong class="@DeviationClass(item.DeviationFromBaseline)">
                                                    @Signed(item.DeviationFromBaseline)
                                                </strong>
                                            </label>

                                            @if (item.StyleOptions.Count > 0)
                                            {
                                                <label class="slow-style-editor">
                                                    <span>Style / Leaning</span>
                                                    <select @bind="item.Style">
                                                        <option value="">— default —</option>
                                                        @foreach (var style in item.StyleOptions)
                                                        {
                                                            <option value="@style">@StyleLabel(style)</option>
                                                        }
                                                    </select>
                                                </label>
                                            }

                                            <div class="slow-actions">
                                                @if (SubSlowTraitCount(item.TraitId) > 0)
                                                {
                                                    <button class="dossier-button tiny secondary"
                                                            @onclick="@(() => ToggleSubSlowDetails(item.TraitId))">
                                                        @(_expandedSubSlowParents.Contains(item.TraitId) ? "Hide Details" : $"Details ({SubSlowTraitCount(item.TraitId)})")
                                                    </button>
                                                }
                                                <button class="dossier-button tiny" @onclick="@(() => SaveSlowTrait(item))">Save</button>
                                                <button class="danger-link" @onclick="@(() => DeactivateSlowTrait(item))">Deactivate</button>
                                            </div>

                                            @if (_expandedSubSlowParents.Contains(item.TraitId))
                                            {
                                                <div class="subslow-panel">
                                                    <div class="subslow-head">
                                                        <div>
                                                            <span>SUBSLOW DETAILS</span>
                                                            <strong>@item.TraitName</strong>
                                                        </div>
                                                        <small>Blank = definition default · nothing is authored until you save it.</small>
                                                    </div>

                                                    @{
                                                        var details = GetSubSlowDetails(item.TraitId);
                                                    }

                                                    @if (details.Count == 0)
                                                    {
                                                        <div class="subslow-empty">No bool/enum details are defined for this parent yet.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="subslow-grid">
                                                            @foreach (var detail in details)
                                                            {
                                                                <div class="subslow-field @($"subslow-{detail.ValueType}")">
                                                                    <span>
                                                                        @detail.Label
                                                                        @if (detail.HasExplicitValue)
                                                                        {
                                                                            <i>AUTHORED</i>
                                                                        }
                                                                    </span>

                                                                    @if (detail.ValueType == "bool" || detail.ValueType == "enum")
                                                                    {
                                                                        <select @bind="detail.EditValue">
                                                                            <option value="">
                                                                                — default: @SubSlowDisplay(detail.DefaultValue) —
                                                                            </option>

                                                                            @foreach (var option in detail.Options)
                                                                            {
                                                                                <option value="@option.Value">@option.Label</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else if (detail.ValueType == "catalog_ref" && detail.PickCount <= 1)
                                                                    {
                                                                        <select @bind="detail.EditValue">
                                                                            <option value="">— not selected —</option>
                                                                            @foreach (var option in detail.Options)
                                                                            {
                                                                                <option value="@option.Value">@option.Label</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else if (detail.ValueType == "catalog_ref" || detail.ValueType == "string_list")
                                                                    {
                                                                        <div class="subslow-picker-meta">
                                                                            <span>@SubSlowSelectedCount(detail) selected</span>
                                                                            <span>
                                                                                @(detail.ValueType == "catalog_ref"
                                                                                    ? $"pick up to {Math.Max(1, detail.PickCount)}"
                                                                                    : $"up to {Math.Max(1, detail.MaxItems)}")
                                                                            </span>
                                                                        </div>

                                                                        <div class="subslow-option-picker">
                                                                            @foreach (var option in detail.Options)
                                                                            {
                                                                                <button type="button"
                                                                                        class="@(SubSlowOptionSelected(detail, option.Value) ? "selected" : "")"
                                                                                        @onclick="@(() => ToggleSubSlowMultiValue(detail, option.Value))">
                                                                                    @option.Label
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    else if (detail.ValueType == "string")
                                                                    {
                                                                        <input class="subslow-text-input"
                                                                               type="text"
                                                                               placeholder="Enter value…"
                                                                               @bind="detail.EditValue" />
                                                                    }

                                                                    <small>@detail.SubTraitId</small>

                                                                    <div class="subslow-actions">
                                                                        <button type="button"
                                                                                class="dossier-button tiny"
                                                                                @onclick="@(() => SaveSubSlowDetail(detail))">
                                                                            Save
                                                                        </button>
                                                                        @if (detail.HasExplicitValue)
                                                                        {
                                                                            <button type="button"
                                                                                    class="danger-link"
                                                                                    @onclick="@(() => ClearSubSlowDetail(detail))">
                                                                                Use Default
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }

            <div class="slow-add-strip">
                <label>
                    <span>Add Slow trait</span>
                    <select @bind="_newSlowTraitId">
                        <option value="">Choose available definition…</option>
                        @foreach (var group in _slowDossier.Available
                            .GroupBy(x => GetSlowCategory(x.TraitId))
                            .OrderBy(x => SlowCategoryOrder(x.Key))
                            .ThenBy(x => x.Key))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var definition in group.OrderBy(x => x.Label))
                                {
                                    <option value="@definition.TraitId">@definition.Label (@definition.TraitId)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <button class="dossier-button primary"
                        disabled="@string.IsNullOrWhiteSpace(_newSlowTraitId)"
                        @onclick="AddSlowTrait">
                    Add Slow Trait
                </button>
            </div>
        </section>
        }
        else if (_traitSubTab == "behavior")
        {
        <section class="dossier-panel wide-panel">
            <NpcBehaviorLab Sheet="_sheet" />
        </section>
        }
    }
    else if (_tab == "history")
    {
        <div class="dossier-layout history-layout">
            <main class="dossier-main">
                <section class="dossier-panel">
                    <div class="panel-title"><div><span>H</span><h2>Life History Timeline</h2></div><span class="field-state @CompletionClass(_sheet.HistoryEvents.Count > 0)">@_sheet.HistoryEvents.Count events</span></div>
                    @if (_sheet.HistoryEvents.Count == 0)
                    {
                        <div class="empty-state"><strong>No authored life history yet.</strong><span>Add the events that explain why this person became who they are.</span></div>
                    }
                    else
                    {
                        <div class="timeline">
                        @foreach (var item in _sheet.HistoryEvents)
                        {
                            <article class="timeline-item">
                                <div class="timeline-marker"></div>
                                <div class="timeline-card">
                                    <div class="timeline-head"><div><span>@Safe(item.EventDate, item.AgeAtEvent > 0 ? $"Age {item.AgeAtEvent}" : "Undated")</span><h3>@item.Title</h3></div><button class="danger-link" @onclick="@(() => DeleteHistory(item.Id))">Delete</button></div>
                                    <span class="event-type">@item.EventType</span>
                                    <p>@item.Details</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Meaning)) { <div class="meaning"><strong>Why it matters:</strong> @item.Meaning</div> }
                                </div>
                            </article>
                        }
                        </div>
                    }
                </section>
            </main>
            <aside class="dossier-side">
                <section class="dossier-panel">
                    <div class="panel-title compact"><div><h2>Add History</h2></div></div>
                    <DossierField Label="Date / Period"><input placeholder="2018, High school, age 13..." @bind="_newHistory.EventDate" /></DossierField>
                    <DossierField Label="Age at Event"><input type="number" min="0" @bind="_newHistory.AgeAtEvent" /></DossierField>
                    <DossierField Label="Type"><input placeholder="Family, Work, Relationship..." @bind="_newHistory.EventType" /></DossierField>
                    <DossierField Label="Title" Missing="@IsMissing(_newHistory.Title)"><input @bind="_newHistory.Title" /></DossierField>
                    <DossierField Label="What Happened"><textarea rows="5" @bind="_newHistory.Details"></textarea></DossierField>
                    <DossierField Label="What It Means to This NPC"><textarea rows="5" @bind="_newHistory.Meaning"></textarea></DossierField>
                    <button class="dossier-button primary full" @onclick="AddHistory">Add Canon Event</button>
                </section>
            </aside>
        </div>
    }
    else if (_tab == "relationships")
    {
        <div class="relationship-workspace">
            <div class="relationship-subtab-row">
                <nav class="relationship-subtabs" aria-label="Relationship sections">
                    @foreach (var item in _relationshipSubTabs)
                    {
                        <button class="@(_relationshipSubTab == item.Key ? "active" : "")"
                                @onclick="@(() => SelectRelationshipSubTab(item.Key))">
                            @item.Label
                        </button>
                    }
                </nav>

                @if (_relationshipSubTab != "summary")
                {
                    <button class="relationship-back-summary"
                            type="button"
                            @onclick="BackToRelationshipSummary">
                        ← Back to Summary
                    </button>
                }
            </div>

            @if (_relationshipSubTab == "summary")
            {
                <section class="dossier-panel wide-panel relationship-summary-panel">
                    <div class="panel-title">
                        <div><span>R</span><h2>Relationship Summary</h2></div>
                        <span class="field-state green">READ ONLY</span>
                    </div>
                    <p class="panel-help">
                        Directed human truth from this NPC's point of view. Nothing changes here.
                        Click a person to open the relationship editor, or jump directly to reasons, memories, or beliefs.
                    </p>

                    <div class="relationship-summary-stats">
                        <div><span>PEOPLE</span><strong>@_relationshipDossier.Relationships.Count</strong><small>directed bonds</small></div>
                        <div><span>ACTIVE REASONS</span><strong>@_relationshipDossier.Reasons.Count(x => x.IsStillActive)</strong><small>why scores feel this way</small></div>
                        <div><span>MEMORIES</span><strong>@_relationshipDossier.Memories.Count</strong><small>subjective recall</small></div>
                        <div><span>BELIEFS</span><strong>@_relationshipDossier.Knowledge.Count</strong><small>@_relationshipDossier.Knowledge.Count(x => x.IsFalseBelief) false · @_relationshipDossier.Knowledge.Count(x => x.IsRumor) rumor</small></div>
                    </div>

                    @if (_relationshipDossier.Relationships.Count == 0)
                    {
                        <div class="empty-state">
                            <strong>No directed relationships found.</strong>
                            <span>Open People to author the NPC's first relationship.</span>
                        </div>
                    }
                    else
                    {
                        <div class="relationship-summary-grid">
                            @foreach (var relation in _relationshipDossier.Relationships
                                .OrderByDescending(x => x.Importance)
                                .ThenBy(x => x.TargetName))
                            {
                                <article class="relationship-summary-card @(_selectedRelationshipId == relation.RelationshipId ? "selected" : "")">
                                    <header>
                                        <button type="button"
                                                class="relationship-person-link"
                                                @onclick="@(() => OpenRelationshipPerson(relation))">
                                            <strong>@relation.TargetName</strong>
                                            <span>@RelationshipLabel(relation)</span>
                                        </button>
                                        <b>@relation.Importance</b>
                                    </header>

                                    <div class="relationship-score-row">
                                        <span><small>Trust</small><strong>@relation.Trust</strong></span>
                                        <span><small>Love</small><strong>@relation.Love</strong></span>
                                        <span><small>Respect</small><strong>@relation.Respect</strong></span>
                                        <span><small>Loyalty</small><strong>@relation.Loyalty</strong></span>
                                    </div>

                                    <div class="relationship-score-row friction">
                                        <span><small>Anger</small><strong>@relation.Anger</strong></span>
                                        <span><small>Resent</small><strong>@relation.Resentment</strong></span>
                                        <span><small>Fear</small><strong>@relation.Fear</strong></span>
                                        <span><small>Tension</small><strong>@relation.Tension</strong></span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(relation.Notes))
                                    {
                                        <p>@relation.Notes</p>
                                    }

                                    <footer>
                                        <button type="button" @onclick="@(() => OpenRelationshipReasons(relation))">
                                            @relation.ActiveReasonCount reasons
                                        </button>
                                        <button type="button" @onclick="@(() => OpenRelationshipMemory(relation))">
                                            @relation.MemoryCount memories
                                        </button>
                                        <button type="button" @onclick="@(() => OpenRelationshipMemory(relation))">
                                            @relation.KnowledgeCount beliefs
                                        </button>
                                    </footer>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
            else if (_relationshipSubTab == "people")
            {
                @if (!string.IsNullOrWhiteSpace(_selectedRelationshipId))
                {
                    var selected = SelectedRelationship;
                    if (selected is not null)
                    {
                        <div class="relationship-focus-banner">
                            <span>SELECTED RELATIONSHIP</span>
                            <strong>@_sheet.Name → @selected.TargetName</strong>
                            <small>@RelationshipLabel(selected)</small>
                        </div>
                    }
                }

                <section class="wide-panel">
                    <NpcRelationshipWeb Sheet="_sheet" OnChanged="ReloadRelationships" />
                </section>
            }
            else if (_relationshipSubTab == "reasons")
            {
                <section class="dossier-panel wide-panel relationship-reasons-panel">
                    <div class="panel-title">
                        <div><span>W</span><h2>Relationship Reasons / Why</h2></div>
                        <span class="field-state">@FilteredRelationshipReasons.Count items</span>
                    </div>
                    <p class="panel-help">
                        Subjective reasons and interpretations. Objective events remain in History.
                    </p>

                    <div class="relationship-filter-row">
                        <button class="@(_selectedRelationshipId == "" ? "active" : "")"
                                @onclick="@(() => SelectRelationshipFilter(""))">
                            All People
                        </button>
                        @foreach (var relation in _relationshipDossier.Relationships)
                        {
                            <button class="@(_selectedRelationshipId == relation.RelationshipId ? "active" : "")"
                                    @onclick="@(() => SelectRelationshipFilter(relation.RelationshipId))">
                                @relation.TargetName
                            </button>
                        }
                    </div>

                    @if (FilteredRelationshipReasons.Count == 0)
                    {
                        <div class="empty-state">
                            <strong>No relationship reasons for this view.</strong>
                            <span>The current relationship state can still exist without an authored reason row.</span>
                        </div>
                    }
                    else
                    {
                        <div class="relationship-reason-list">
                            @foreach (var reason in FilteredRelationshipReasons)
                            {
                                <article class="@(!reason.IsStillActive ? "inactive" : "")">
                                    <header>
                                        <div>
                                            <strong>@reason.TargetName</strong>
                                            <span>@Safe(reason.ScoreName, "relationship") · Δ @Signed(reason.Delta)</span>
                                        </div>
                                        <b>@(reason.IsStillActive ? "ACTIVE" : "PAST")</b>
                                    </header>
                                    <p>@Safe(reason.Reason, "Reason not recorded.")</p>
                                    @if (!string.IsNullOrWhiteSpace(reason.Interpretation))
                                    {
                                        <blockquote>@reason.Interpretation</blockquote>
                                    }
                                    <footer>
                                        <span>Importance @reason.Importance</span>
                                        @if (!string.IsNullOrWhiteSpace(reason.EventId))
                                        {
                                            <span>History: @reason.EventId</span>
                                        }
                                        <span>@Safe(reason.GameTime, reason.CreatedRealAt)</span>
                                    </footer>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
            else if (_relationshipSubTab == "memory")
            {
                <section class="dossier-panel wide-panel relationship-memory-panel">
                    <div class="panel-title">
                        <div><span>M</span><h2>Memories & Beliefs</h2></div>
                        <span class="field-state">SUBJECTIVE</span>
                    </div>
                    <div class="subjective-dossier-note">
                        Subjective state only. Objective truth remains in HISTORY.
                        Existing unassigned memories stay unassigned until explicitly authored.
                    </div>

                    <div class="relationship-filter-row">
                        <button class="@(_selectedTargetCharacterId is null ? "active" : "")"
                                @onclick="ClearRelationshipTargetFilter">
                            All Subjects
                        </button>
                        @foreach (var relation in RelationshipSubjectOptions)
                        {
                            <button class="@(_selectedTargetCharacterId == relation.TargetCharacterId ? "active" : "")"
                                    @onclick="@(() => SelectRelationshipTargetFilter(relation))">
                                @relation.TargetName
                            </button>
                        }
                    </div>

                    <div class="subjective-toolbar">
                        <button type="button" class="dossier-button primary tiny" @onclick="OpenSharedEventEditor">
                            + Shared Event
                        </button>
                        <button type="button" class="dossier-button secondary tiny" @onclick="OpenNewMemoryEditor">
                            + Personal Memory
                        </button>
                        <button type="button" class="dossier-button secondary tiny" @onclick="OpenNewKnowledgeEditor">
                            + Knowledge / Belief
                        </button>
                        <span>@FilteredMemories.Count memories · @FilteredKnowledge.Count knowledge/beliefs</span>
                    </div>

                    @if (_sharedEventEditorOpen)
                    {
                        <section class="shared-event-authoring">
                            <header>
                                <div>
                                    <strong>Shared Event Authoring</strong>
                                    <small>TRUE HISTORY is the anchor. Each participant receives their own Known History + Personal Memory tied to the same EventId.</small>
                                </div>
                                <button type="button" class="subjective-edit-button" @onclick="CloseSharedEventEditor">Close</button>
                            </header>

                            <div class="shared-event-grid">
                                <label>
                                    <span>True Event Title</span>
                                    <input @bind="_sharedEventDraft.Title" placeholder="Sinclair family vacation" />
                                </label>
                                <label>
                                    <span>Event Type</span>
                                    <input @bind="_sharedEventDraft.EventType" placeholder="Vacation, Party, Meeting..." />
                                </label>
                                <label>
                                    <span>Place</span>
                                    <input @bind="_sharedEventDraft.PlaceText" placeholder="Myrtle Beach, South Carolina" />
                                </label>
                                <label>
                                    <span>Game Time / Date</span>
                                    <input @bind="_sharedEventDraft.GameTime" placeholder="Optional canonical game time" />
                                </label>

                                <label class="shared-event-wide">
                                    <span>TRUE HISTORY — what objectively happened</span>
                                    <textarea rows="2" @bind="_sharedEventDraft.TrueEventSummary"
                                              placeholder="Objective facts only. This is the canonical truth."></textarea>
                                </label>

                                <label class="shared-event-wide">
                                    <span>Shared Known History — what everyone present can reasonably know</span>
                                    <textarea rows="2" @bind="_sharedEventDraft.SharedKnownHistory"
                                              placeholder="Baseline knowledge shared by everyone present. Individual views can override this below."></textarea>
                                </label>

                                <label class="shared-event-wide">
                                    <span>Shared Base Memory — starting memory for everyone present</span>
                                    <textarea rows="2" @bind="_sharedEventDraft.SharedBaseMemory"
                                              placeholder="Common memory of the event. Individual memory views can override this below."></textarea>
                                </label>

                                <div class="shared-event-wide shared-ai-draft-bar">
                                    <div class="shared-ai-head">
                                        <div>
                                            <strong>AI Draft Participant Views</strong>
                                            <small>Draft only — nothing becomes canon until you review and save.</small>
                                        </div>
                                        <button type="button"
                                                class="dossier-button primary tiny"
                                                disabled="@_sharedEventAiBusy"
                                                @onclick="DraftSharedEventViewsWithAi">
                                            @(_sharedEventAiBusy ? "Drafting..." : "Generate Views")
                                        </button>
                                    </div>

                                    <div class="shared-ai-options">
                                        <label>
                                            <span>Depth</span>
                                            <select @bind="_sharedEventAiOptions.DetailLevel">
                                                <option>Brief</option>
                                                <option>Normal</option>
                                                <option>Rich</option>
                                            </select>
                                        </label>
                                        <label class="shared-ai-check">
                                            <input type="checkbox" @bind="_sharedEventAiOptions.SuggestPrivateMoments" />
                                            <span>Private moments</span>
                                        </label>
                                        <label class="shared-ai-check">
                                            <input type="checkbox" @bind="_sharedEventAiOptions.SuggestMisunderstandings" />
                                            <span>Misunderstandings</span>
                                        </label>
                                        <label class="shared-ai-check">
                                            <input type="checkbox" @bind="_sharedEventAiOptions.SuggestSecretsOrRumors" />
                                            <span>Secrets / rumors</span>
                                        </label>
                                        <label class="shared-ai-check">
                                            <input type="checkbox" @bind="_sharedEventAiOptions.SuggestRelationshipEffects" />
                                            <span>Relationship ideas</span>
                                        </label>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(_sharedEventAiMessage))
                                    {
                                        <div class="shared-ai-message">@_sharedEventAiMessage</div>
                                    }

                                    @if (_sharedEventAiExtraIdeas.Count > 0)
                                    {
                                        <details class="shared-ai-extra-ideas">
                                            <summary>AI extra ideas (@_sharedEventAiExtraIdeas.Count)</summary>
                                            @foreach (var idea in _sharedEventAiExtraIdeas)
                                            {
                                                <div>@idea</div>
                                            }
                                        </details>
                                    }
                                </div>

                                <div class="shared-event-wide shared-participants">
                                    <div class="shared-participants-head">
                                        <span>Real NPC Participants (@_sharedEventDraft.Participants.Count)</span>
                                        <small>Every selected person gets Known History + Memory tied to this same EventId.</small>
                                    </div>

                                    <input class="people-picker-search"
                                           @bind="_sharedParticipantSearch"
                                           @bind:event="oninput"
                                           placeholder="Search any real NPC by name, job, or location..." />

                                    <div class="shared-participant-results">
                                        @foreach (var person in FilterSharedParticipantOptions)
                                        {
                                            <button type="button"
                                                    class="@(IsSharedParticipant(person.CharacterId) ? "active" : "")"
                                                    @onclick="@(() => ToggleSharedParticipant(person.CharacterId))">
                                                <strong>@person.Name</strong>
                                                <small>Tier @person.Tier · @Safe(person.Occupation, "No job") · @Safe(person.Location, "No location")</small>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="shared-event-wide shared-event-summary">
                                    <header>
                                        <strong>Event Summary</strong>
                                        <small>Review who is truly in the event, what they know, and whether they get a memory before saving.</small>
                                    </header>
                                    <div class="shared-summary-table">
                                        <div class="shared-summary-row head">
                                            <span>Person</span>
                                            <span>True Event</span>
                                            <span>Knowledge</span>
                                            <span>Memory</span>
                                        </div>
                                        @foreach (var view in _sharedEventDraft.Participants)
                                        {
                                            var person = ParticipantOption(view.CharacterId);
                                            <div class="shared-summary-row">
                                                <strong>@(person?.Name ?? $"Character #{view.CharacterId}")</strong>
                                                <label class="shared-summary-check">
                                                    <input type="checkbox" @bind="view.IsTrueEventParticipant" />
                                                    <span>@(view.IsTrueEventParticipant ? "Present" : "Not present")</span>
                                                </label>
                                                <select @bind="view.KnowledgeLevel">
                                                    <option value="Shared">Shared</option>
                                                    <option value="FullTruth">Full truth</option>
                                                    <option value="Limited">Limited</option>
                                                    <option value="None">None</option>
                                                </select>
                                                <label class="shared-summary-check">
                                                    <input type="checkbox" @bind="view.CreateMemory" />
                                                    <span>@(view.CreateMemory ? "Create" : "No memory")</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="shared-event-wide participant-view-list">
                                    @foreach (var view in _sharedEventDraft.Participants)
                                    {
                                        var person = ParticipantOption(view.CharacterId);
                                        <details class="participant-view-card">
                                            <summary>
                                                <strong>@(person?.Name ?? $"Character #{view.CharacterId}")</strong>
                                                <span>
                                                    @(view.IsTrueEventParticipant ? "TRUE participant" : "Knows later")
                                                    · @view.KnowledgeLevel knowledge
                                                    · @(view.CreateMemory ? "memory on" : "memory off")
                                                </span>
                                            </summary>
                                            <div class="participant-view-grid">
                                                <label>
                                                    <span>Known History Override</span>
                                                    <textarea rows="2" @bind="view.KnownHistoryOverride"
                                                              placeholder="@_sharedEventDraft.SharedKnownHistory"></textarea>
                                                </label>
                                                <label>
                                                    <span>Personal Memory View</span>
                                                    <textarea rows="2" @bind="view.MemoryViewOverride"
                                                              placeholder="@_sharedEventDraft.SharedBaseMemory"></textarea>
                                                </label>
                                                <label>
                                                    <span>Interpretation</span>
                                                    <input @bind="view.Interpretation" placeholder="What they think it meant" />
                                                </label>
                                                <label>
                                                    <span>Emotional Meaning</span>
                                                    <input @bind="view.EmotionalMeaning" placeholder="How it felt to them" />
                                                </label>
                                            </div>
                                        </details>
                                    }
                                </div>

                                <label>
                                    <span>Importance</span>
                                    <input type="number" min="0" max="100" @bind="_sharedEventDraft.Importance" />
                                </label>
                                <label>
                                    <span>Strength</span>
                                    <input type="number" min="0" max="100" @bind="_sharedEventDraft.Strength" />
                                </label>
                                <label>
                                    <span>Confidence</span>
                                    <input type="number" min="0" max="100" @bind="_sharedEventDraft.Confidence" />
                                </label>
                            </div>

                            <footer>
                                <span>
                                    Saves 1 TRUE WorldEvent. Only people marked Present become EventParticipants; knowledge and memory rows follow each person's summary settings.
                                </span>
                                <button type="button" class="dossier-button primary tiny" @onclick="SaveSharedEvent">
                                    Save Shared Event
                                </button>
                            </footer>
                        </section>
                    }

                    <div class="relationship-memory-grid authored-subjective-grid">
                        <section>
                            <header>
                                <div>
                                    <h3>Personal Memories</h3>
                                    <small>Subjective recall, interpretation, emotional meaning</small>
                                </div>
                                <span>@FilteredMemories.Count</span>
                            </header>

                            <details class="subjective-editor" open="@_memoryEditorOpen">
                                <summary>
                                    <strong>@(string.IsNullOrWhiteSpace(_memoryDraft.Id) ? "Personal Memory Editor" : "Editing Memory")</strong>
                                    <span>@(string.IsNullOrWhiteSpace(_memoryDraft.Id) ? "collapsed until needed" : "save or cancel")</span>
                                </summary>

                                <div class="subjective-editor-grid">
                                    <div class="subject-picker people-picker">
                                        <span>Subject</span>
                                        <div class="people-picker-selected">
                                            <strong>@KnowledgeSubjectLabel</strong>
                                            @if (_knowledgeDraft.SubjectCharacterId is not null)
                                            {
                                                <button type="button" @onclick="@(() => SetKnowledgeSubject(null))">×</button>
                                            }
                                        </div>
                                        <input class="people-picker-search"
                                               @bind="_knowledgeSubjectSearch"
                                               @bind:event="oninput"
                                               placeholder="Search people..." />
                                        <div class="people-picker-results">
                                            @foreach (var relation in FilterPeople(_knowledgeSubjectSearch))
                                            {
                                                <button type="button"
                                                        class="@(_knowledgeDraft.SubjectCharacterId == relation.TargetCharacterId ? "active" : "")"
                                                        @onclick="@(() => SetKnowledgeSubject(relation.TargetCharacterId))">
                                                    <strong>@relation.TargetName</strong>
                                                    <small>@relation.RelationshipType</small>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <label>
                                        <span>Memory Type</span>
                                        <input @bind="_memoryDraft.MemoryType" placeholder="General, Family, Social, Work..." />
                                    </label>

                                    <div class="subjective-wide history-link-browser">
                                        <div class="history-link-head">
                                            <div>
                                                <span>Canonical History Event</span>
                                                <strong>@MemoryHistoryLinkLabel</strong>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_memoryDraft.EventId))
                                            {
                                                <button type="button" class="subjective-edit-button"
                                                        @onclick="ClearMemoryHistoryLink">
                                                    Clear Link
                                                </button>
                                            }
                                        </div>

                                        @if (_canonicalHistoryEvents.Count == 0)
                                        {
                                            <div class="history-link-empty">
                                                <strong>No canonical HISTORY events involving @_sheet.Name yet.</strong>
                                                <span>
                                                    This memory can still be saved as subjective memory, but it cannot honestly be linked
                                                    to an objective event until one exists in HISTORY.
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="history-event-options">
                                                @foreach (var historyEvent in _canonicalHistoryEvents.Take(12))
                                                {
                                                    <button type="button"
                                                            class="@(_memoryDraft.EventId == historyEvent.EventId ? "selected" : "")"
                                                            @onclick="@(() => SelectMemoryHistoryEvent(historyEvent.EventId))">
                                                        <div class="history-event-card-top">
                                                            <strong>@Safe(historyEvent.Title, Safe(historyEvent.Summary, "Untitled event"))</strong>
                                                            <code>@historyEvent.EventId</code>
                                                        </div>
                                                        <span>@Safe(historyEvent.GameTime, "Undated") · @Safe(historyEvent.EventType, "Event")</span>
                                                        @if (!string.IsNullOrWhiteSpace(historyEvent.PlaceText))
                                                        {
                                                            <small>@historyEvent.PlaceText</small>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <label class="subjective-wide">
                                        <span>What They Remember</span>
                                        <textarea rows="3" @bind="_memoryDraft.MemoryText"></textarea>
                                    </label>

                                    <label class="subjective-wide">
                                        <span>Interpretation</span>
                                        <textarea rows="2" @bind="_memoryDraft.Interpretation"
                                                  placeholder="What this NPC thinks the memory means..."></textarea>
                                    </label>

                                    <label class="subjective-wide">
                                        <span>Emotional Meaning</span>
                                        <textarea rows="2" @bind="_memoryDraft.EmotionalMeaning"
                                                  placeholder="Why this memory matters emotionally..."></textarea>
                                    </label>

                                    <label>
                                        <span>Importance</span>
                                        <input type="number" min="0" max="100" @bind="_memoryDraft.Importance" />
                                    </label>

                                    <label>
                                        <span>Strength</span>
                                        <input type="number" min="0" max="100" @bind="_memoryDraft.Strength" />
                                    </label>

                                    <label>
                                        <span>Confidence</span>
                                        <input type="number" min="0" max="100" @bind="_memoryDraft.Confidence" />
                                    </label>

                                    <label class="subjective-check">
                                        <input type="checkbox" @bind="_memoryDraft.IsLockedPeak" />
                                        <span>Locked Peak Memory</span>
                                    </label>
                                </div>

                                <div class="subjective-editor-actions">
                                    <button type="button" class="dossier-button primary tiny" @onclick="SavePersonalMemory">
                                        @(string.IsNullOrWhiteSpace(_memoryDraft.Id) ? "Add Memory" : "Save Memory")
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(_memoryDraft.Id))
                                    {
                                        <button type="button" class="dossier-button secondary tiny" @onclick="ResetMemoryDraft">
                                            Cancel Edit
                                        </button>
                                    }
                                </div>
                            </details>

                            @if (FilteredMemories.Count == 0)
                            {
                                <div class="empty-copy">No memories for this filter.</div>
                            }
                            else
                            {
                                <div class="subjective-list-scroll">
                                    <div class="relationship-memory-list compact-subjective-list">
                                    @foreach (var memory in FilteredMemories)
                                    {
                                        <article class="subjective-authored-card">
                                            <header>
                                                <div>
                                                    <strong>@Safe(memory.MemoryType, "General")</strong>
                                                    <span>Importance @memory.Importance · Strength @memory.Strength</span>
                                                </div>
                                                <button type="button" class="subjective-edit-button" @onclick="@(() => BeginEditMemory(memory))">Edit</button>
                                            </header>
                                            <p>@memory.MemoryText</p>
                                            @if (!string.IsNullOrWhiteSpace(memory.Interpretation))
                                            {
                                                <small>Interpretation: @memory.Interpretation</small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(memory.EmotionalMeaning))
                                            {
                                                <small>Meaning: @memory.EmotionalMeaning</small>
                                            }
                                            <footer>
                                                @if (!string.IsNullOrWhiteSpace(memory.SubjectName))
                                                {
                                                    <span>About @memory.SubjectName</span>
                                                }
                                                else
                                                {
                                                    <span>Subject unassigned</span>
                                                }
                                                <span>Confidence @memory.Confidence</span>
                                                @if (memory.IsLockedPeak)
                                                {
                                                    <b>PEAK</b>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(memory.EventId))
                                                {
                                                    <span class="history-linked-badge">History linked · @GetHistoryEventLabel(memory.EventId)</span>
                                                }
                                            </footer>
                                        </article>
                                    }
                                    </div>
                                </div>
                            }
                        </section>

                        <section>
                            <header>
                                <div>
                                    <h3>Knowledge / Beliefs</h3>
                                    <small>What they know, suspect, heard, or falsely believe</small>
                                </div>
                                <span>@FilteredKnowledge.Count</span>
                            </header>

                            <details class="subjective-editor" open="@_knowledgeEditorOpen">
                                <summary>
                                    <strong>@(string.IsNullOrWhiteSpace(_knowledgeDraft.Id) ? "Knowledge / Belief Editor" : "Editing Knowledge / Belief")</strong>
                                    <span>@(string.IsNullOrWhiteSpace(_knowledgeDraft.Id) ? "collapsed until needed" : "save or cancel")</span>
                                </summary>

                                <div class="subjective-editor-grid">
                                    <div class="subject-picker people-picker">
                                        <span>Subject</span>
                                        <div class="people-picker-selected">
                                            <strong>@MemorySubjectLabel</strong>
                                            @if (_memoryDraft.SubjectCharacterId is not null)
                                            {
                                                <button type="button" @onclick="@(() => SetMemorySubject(null))">×</button>
                                            }
                                        </div>
                                        <input class="people-picker-search"
                                               @bind="_memorySubjectSearch"
                                               @bind:event="oninput"
                                               placeholder="Search people..." />
                                        <div class="people-picker-results">
                                            @foreach (var relation in FilterPeople(_memorySubjectSearch))
                                            {
                                                <button type="button"
                                                        class="@(_memoryDraft.SubjectCharacterId == relation.TargetCharacterId ? "active" : "")"
                                                        @onclick="@(() => SetMemorySubject(relation.TargetCharacterId))">
                                                    <strong>@relation.TargetName</strong>
                                                    <small>@relation.RelationshipType</small>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <label>
                                        <span>Knowledge Type</span>
                                        <input @bind="_knowledgeDraft.KnowledgeType" placeholder="Knowledge, Suspicion, Rumor..." />
                                    </label>

                                    <div class="subjective-wide history-link-browser">
                                        <div class="history-link-head">
                                            <div>
                                                <span>Canonical History Event</span>
                                                <strong>@KnowledgeHistoryLinkLabel</strong>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_knowledgeDraft.EventId))
                                            {
                                                <button type="button" class="subjective-edit-button"
                                                        @onclick="ClearKnowledgeHistoryLink">
                                                    Clear Link
                                                </button>
                                            }
                                        </div>

                                        @if (_canonicalHistoryEvents.Count == 0)
                                        {
                                            <div class="history-link-empty">
                                                <strong>No canonical HISTORY events involving @_sheet.Name yet.</strong>
                                                <span>
                                                    This knowledge/belief can still be saved subjectively, but it cannot be linked to
                                                    objective history until a canonical event exists.
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="history-event-options">
                                                @foreach (var historyEvent in _canonicalHistoryEvents.Take(12))
                                                {
                                                    <button type="button"
                                                            class="@(_knowledgeDraft.EventId == historyEvent.EventId ? "selected" : "")"
                                                            @onclick="@(() => SelectKnowledgeHistoryEvent(historyEvent.EventId))">
                                                        <div class="history-event-card-top">
                                                            <strong>@Safe(historyEvent.Title, Safe(historyEvent.Summary, "Untitled event"))</strong>
                                                            <code>@historyEvent.EventId</code>
                                                        </div>
                                                        <span>@Safe(historyEvent.GameTime, "Undated") · @Safe(historyEvent.EventType, "Event")</span>
                                                        @if (!string.IsNullOrWhiteSpace(historyEvent.PlaceText))
                                                        {
                                                            <small>@historyEvent.PlaceText</small>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <label class="subjective-wide">
                                        <span>What They Know / Believe</span>
                                        <textarea rows="3" @bind="_knowledgeDraft.WhatTheyKnow"></textarea>
                                    </label>

                                    <label class="subjective-wide">
                                        <span>How They Learned It</span>
                                        <textarea rows="2" @bind="_knowledgeDraft.HowTheyLearnedIt"
                                                  placeholder="Observed it, was told by someone, inferred it..."></textarea>
                                    </label>

                                    <div class="subject-picker people-picker">
                                        <span>Source Person</span>
                                        <div class="people-picker-selected">
                                            <strong>@KnowledgeSourceLabel</strong>
                                            @if (_knowledgeDraft.SourceCharacterId is not null)
                                            {
                                                <button type="button" @onclick="@(() => SetKnowledgeSource(null))">×</button>
                                            }
                                        </div>
                                        <input class="people-picker-search"
                                               @bind="_knowledgeSourceSearch"
                                               @bind:event="oninput"
                                               placeholder="Search people..." />
                                        <div class="people-picker-results">
                                            @foreach (var relation in FilterPeople(_knowledgeSourceSearch))
                                            {
                                                <button type="button"
                                                        class="@(_knowledgeDraft.SourceCharacterId == relation.TargetCharacterId ? "active" : "")"
                                                        @onclick="@(() => SetKnowledgeSource(relation.TargetCharacterId))">
                                                    <strong>@relation.TargetName</strong>
                                                    <small>@relation.RelationshipType</small>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <label>
                                        <span>Confidence</span>
                                        <input type="number" min="0" max="100" @bind="_knowledgeDraft.Confidence" />
                                    </label>

                                    <div class="subjective-flags">
                                        <label><input type="checkbox" @bind="_knowledgeDraft.IsRumor" /><span>Rumor</span></label>
                                        <label><input type="checkbox" @bind="_knowledgeDraft.IsSecret" /><span>Secret</span></label>
                                        <label><input type="checkbox" @bind="_knowledgeDraft.IsFalseBelief" /><span>False Belief</span></label>
                                    </div>
                                </div>

                                <div class="subjective-editor-actions">
                                    <button type="button" class="dossier-button primary tiny" @onclick="SaveKnowledgeItem">
                                        @(string.IsNullOrWhiteSpace(_knowledgeDraft.Id) ? "Add Knowledge" : "Save Knowledge")
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(_knowledgeDraft.Id))
                                    {
                                        <button type="button" class="dossier-button secondary tiny" @onclick="ResetKnowledgeDraft">
                                            Cancel Edit
                                        </button>
                                    }
                                </div>
                            </details>

                            @if (FilteredKnowledge.Count == 0)
                            {
                                <div class="empty-copy">No beliefs or knowledge for this filter.</div>
                            }
                            else
                            {
                                <div class="subjective-list-scroll">
                                    <div class="relationship-memory-list knowledge compact-subjective-list">
                                    @foreach (var item in FilteredKnowledge)
                                    {
                                        <article class="subjective-authored-card @(item.IsFalseBelief ? "false-belief" : item.IsRumor ? "rumor" : "")">
                                            <header>
                                                <div>
                                                    <strong>@Safe(item.KnowledgeType, "Knowledge")</strong>
                                                    <span>Confidence @item.Confidence</span>
                                                </div>
                                                <button type="button" class="subjective-edit-button" @onclick="@(() => BeginEditKnowledge(item))">Edit</button>
                                            </header>
                                            <p>@item.WhatTheyKnow</p>
                                            @if (!string.IsNullOrWhiteSpace(item.HowTheyLearnedIt))
                                            {
                                                <small>Learned: @item.HowTheyLearnedIt</small>
                                            }
                                            <footer>
                                                @if (!string.IsNullOrWhiteSpace(item.SubjectName))
                                                {
                                                    <span>About @item.SubjectName</span>
                                                }
                                                else
                                                {
                                                    <span>Subject unassigned</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.SourceName))
                                                {
                                                    <span>Source @item.SourceName</span>
                                                }
                                                @if (item.IsRumor)
                                                {
                                                    <b>RUMOR</b>
                                                }
                                                @if (item.IsSecret)
                                                {
                                                    <b>SECRET</b>
                                                }
                                                @if (item.IsFalseBelief)
                                                {
                                                    <b>FALSE BELIEF</b>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.EventId))
                                                {
                                                    <span class="history-linked-badge">History linked · @GetHistoryEventLabel(item.EventId)</span>
                                                }
                                            </footer>
                                        </article>
                                    }
                                    </div>
                                </div>
                            }
                        </section>
                    </div>
                </section>

            }
        </div>
    }
    else if (_tab == "voice")
    {
        <div class="voice-dossier">
            <section class="dossier-panel voice-identity">
                <div class="panel-title"><div><span>V</span><h2>Voice Identity</h2></div><span class="field-state @CompletionClass(VoiceReady)">@CompletionText(VoiceReady)</span></div>
                <div class="dossier-grid three">
                    <DossierField Label="Voice Name"><input @bind="_sheet.Voice.VoiceName" /></DossierField>
                    <DossierField Label="Accent"><input @bind="_sheet.Voice.Accent" /></DossierField>
                    <DossierField Label="Status" Missing="@IsMissing(_sheet.Voice.VoiceStatus)"><input @bind="_sheet.Voice.VoiceStatus" /></DossierField>
                    <DossierField Label="Energy"><input @bind="_sheet.Voice.Energy" /></DossierField>
                    <DossierField Label="Warmth"><input @bind="_sheet.Voice.Warmth" /></DossierField>
                    <DossierField Label="Pace"><input @bind="_sheet.Voice.Pace" /></DossierField>
                    <DossierField Label="Pitch"><input @bind="_sheet.Voice.Pitch" /></DossierField>
                    <DossierField Label="Roughness"><input @bind="_sheet.Voice.Roughness" /></DossierField>
                    <DossierField Label="Age Tone"><input @bind="_sheet.Voice.AgeTone" /></DossierField>
                </div>
                <DossierField Label="Speaking Style"><textarea rows="4" @bind="_sheet.Voice.VoiceStyle"></textarea></DossierField>
                <DossierField Label="Voice Notes"><textarea rows="4" @bind="_sheet.Voice.Notes"></textarea></DossierField>
            </section>

            <section class="dossier-panel engine-panel">
                <div class="panel-title compact"><div><h2>Engine Assignments</h2></div></div>
                <div class="engine-grid">
                    <div><span>In-Person / Live</span><strong>Chatterbox Turbo</strong><small>low-latency conversation</small></div>
                    <div><span>Phone Call</span><strong>Chatterbox Turbo</strong><small>low-latency conversation</small></div>
                    <div><span>Voice Message</span><strong>Chatterbox</strong><small>recorded / quality path</small></div>
                    <div><span>Recorded Story</span><strong>Chatterbox</strong><small>non-live audio</small></div>
                </div>
            </section>

            <section class="dossier-panel reference-panel">
                <div class="panel-title compact"><div><h2>Approved Reference</h2></div></div>
                <DossierField Label="Master Voice Reference" Missing="@IsMissing(_sheet.Voice.ReferenceAudioPath)"><input @bind="_sheet.Voice.ReferenceAudioPath" /></DossierField>
                @if (!string.IsNullOrWhiteSpace(_sheet.Voice.ReferenceAudioPath))
                {
                    <audio controls src="@BuildImagePreviewUrl(_sheet.Voice.ReferenceAudioPath)"></audio>
                }
                <DossierField Label="Test Phrase"><textarea rows="3" @bind="_sheet.Voice.SampleText"></textarea></DossierField>
                <label class="approval-check"><input type="checkbox" @bind="_sheet.Voice.Approved" /> Approved canonical voice</label>
                <button class="dossier-button primary full" @onclick="SaveVoice">Save Voice Dossier</button>
            </section>
        </div>
    }
    else if (_tab == "media")
    {
        <!-- PROJECTEVE_MEDIA_STUDIO_MEDIA_TAB_ONLY -->
        <NpcMediaStudio NpcId="NpcId" />

        <section class="dossier-panel wide-panel">
            <div class="panel-title"><div><span>M</span><h2>Media</h2></div></div>
            <nav class="media-subtabs">
                <button class="@(_mediaTab == "photos" ? "active" : "")" @onclick="@(() => _mediaTab = "photos")">Photos</button>
                <button class="@(_mediaTab == "video" ? "active" : "")" @onclick="@(() => _mediaTab = "video")">Video</button>
                <button class="@(_mediaTab == "posts" ? "active" : "")" @onclick="@(() => _mediaTab = "posts")">Posts</button>
                <button class="@(_mediaTab == "clothing" ? "active" : "")" @onclick="@(() => _mediaTab = "clothing")">Clothing</button>
            </nav>
            @if (_mediaTab == "photos")
            {
                <div class="photo-board">
                    @PhotoCard("Face / Master", _sheet.Appearance.ReferenceImagePath, "Canonical identity")
                    @PhotoCard("Profile Picture", _sheet.Appearance.ProfileImagePath, "Game-facing portrait")
                    @PhotoCard("Contact Picture", _sheet.Appearance.ContactImagePath, "Phone / contact identity")
                    @foreach (var image in AdditionalPhotoImages)
                    {
                        @PhotoCard(image.ImageType, image.ImagePath, image.Approved ? "Approved" : "Current")
                    }
                </div>
                <div class="save-strip"></div>
            }
            else if (_mediaTab == "video")
            {
                <div class="future-module"><strong>Profile Video</strong><span>Neutral breathing/blink loop is the first canonical video asset. Mood loops build from the same identity later.</span></div>
            }
            else if (_mediaTab == "posts")
            {
                <div class="future-module"><strong>Posts</strong><span>Social images, captions, selfies, story posts, drafts, and approved social content live here.</span></div>
            }
            else
            {
                <div class="future-module"><strong>Clothing</strong><span>Everyday, work, casual, formal, date night, workout, seasonal, and special-event wardrobe references live here.</span></div>
            }
        </section>
    }
    else if (_tab == "notes")
    {
        <div class="dossier-layout">
            <main class="dossier-main">
                <section class="dossier-panel">
                    <div class="panel-title"><div><span>N</span><h2>Author Notes / Personality Context</h2></div></div>
                    <textarea class="large-notes" rows="18" @bind="_sheet.PersonalityContext"></textarea>
                    <div class="save-strip"><button class="dossier-button primary" @onclick="SaveOverview">Save Notes</button></div>
                </section>
            </main>
            <aside class="dossier-side">
                <section class="dossier-panel">
                    <div class="panel-title compact"><div><h2>Revision Trail</h2></div></div>
                    @foreach (var rev in _sheet.Revisions.Take(12))
                    {
                        <div class="revision-row"><strong>@rev.Title</strong><span>@rev.CreatedRealAt</span><p>@rev.Details</p></div>
                    }
                </section>
            </aside>
        </div>
    }
}
</section>


@if (_sheet is not null)
{
    <section class="dossier-media-inline">
</section>
}

<style>
.appearance-owner-note{
    margin:8px 12px 12px;
    padding:8px 10px;
    border:1px solid #2b4260;
    border-radius:8px;
    background:#0c1a2d;
    color:#8fa5c7;
    font-size:.72rem;
}
</style>
@code {
    [Parameter] public int NpcId { get; set; }

    private NpcCharacterSheet? _sheet;
    private string _tab = "overview";
    private string _mediaTab = "photos";
    private string _statusMessage = "";
    private bool _aiWorking;
    private bool _overviewEdit;
    private int _heightFeet;
    private int _heightInches;
    private double _weightPounds;
    private NpcTraitRow _newTrait = new() { IsEnabled = true, StartingValue = 50, CurrentValue = 50, MainGroup = "Personality" };
    private IReadOnlyList<FastTraitDossierItem> _fast20Dossier = Array.Empty<FastTraitDossierItem>();
    private MidTraitDossier _midDossier = new();
    private SlowTraitDossier _slowDossier = new();
    private string _traitSubTab = "summary";
    private string _traitFocusId = "";
    private string _newSlowTraitId = "";
    private readonly HashSet<string> _expandedSubSlowParents =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<SubSlowDossierItem>> _subSlowCache =
        new(StringComparer.OrdinalIgnoreCase);

    private RelationshipDossier _relationshipDossier = new();
    private string _relationshipSubTab = "summary";
