    private void ToggleSubSlowMultiValue(
        SubSlowDossierItem detail,
        string value)
    {
        var selected = SubSlowSelectedValues(detail).ToList();

        int existing = selected.FindIndex(x =>
            string.Equals(x, value, StringComparison.OrdinalIgnoreCase));

        if (existing >= 0)
        {
            selected.RemoveAt(existing);
            detail.EditValue =
                SubSlowDossierService.SerializeMultiValue(selected);
            return;
        }

        int limit = detail.ValueType == "catalog_ref"
            ? Math.Max(1, detail.PickCount)
            : Math.Max(1, detail.MaxItems);

        if (selected.Count >= limit)
        {
            _statusMessage =
                $"{detail.Label}: maximum {limit} selection{(limit == 1 ? "" : "s")}.";
            return;
        }

        selected.Add(value);
        detail.EditValue =
            SubSlowDossierService.SerializeMultiValue(selected);
    }

