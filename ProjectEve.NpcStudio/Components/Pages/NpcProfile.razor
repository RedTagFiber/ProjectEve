    private IReadOnlyList<NpcMemoryParticipantOption> FilterSharedParticipantOptions
    {
        get
        {
            var query = (_sharedParticipantSearch ?? "").Trim();
            return _memoryParticipantOptions
                .Where(x => string.IsNullOrWhiteSpace(query)
                    || x.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || x.Occupation.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || x.Location.Contains(query, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => IsSharedParticipant(x.CharacterId))
                .ThenBy(x => x.Name)
                .Take(10)
                .ToArray();
        }
    }

