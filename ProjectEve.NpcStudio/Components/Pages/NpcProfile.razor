    private TraitReasonDraft GetNewReasonDraft(string traitId)
    {
        if (_newReasonDrafts.TryGetValue(traitId, out var existing))
            return existing;

        var created = new TraitReasonDraft
        {
            ReasonType = "author",
            SourceType = "author",
            Confidence = 100,
            TargetCharacterId = -1
        };

        _newReasonDrafts[traitId] = created;
        return created;
    }

    private TraitReasonDraft GetReasonEdit(FastTraitReasonItem reason)
    {
        if (_reasonEdits.TryGetValue(reason.Id, out var existing))
            return existing;

        var created = new TraitReasonDraft
        {
            Id = reason.Id,
            ReasonType = reason.ReasonType,
            Reason = reason.Reason,
            Impact = reason.Impact,
            SourceType = reason.SourceType,
            SourceEventId = reason.SourceEventId,
            SourceMemoryId = reason.SourceMemoryId,
            TargetCharacterId = reason.TargetCharacterId,
            Confidence = reason.Confidence,
            GameTime = reason.GameTime
        };

        _reasonEdits[reason.Id] = created;
        return created;
    }

    private Task AddReason(
        FastTraitDossierItem item,
        TraitReasonDraft draft)
    {
        if (_sheet is null || string.IsNullOrWhiteSpace(draft.Reason))
            return Task.CompletedTask;

        NpcTraitRepository.SaveTraitReason(
            id: null,
            npcId: _sheet.Id,
            traitId: item.TraitId,
            targetCharacterId: draft.TargetCharacterId,
            reasonType: draft.ReasonType,
            reason: draft.Reason,
            impact: draft.Impact,
            sourceType: draft.SourceType,
            sourceEventId: draft.SourceEventId,
            sourceMemoryId: draft.SourceMemoryId,
            confidence: draft.Confidence,
            gameTime: draft.GameTime);

        _newReasonDrafts[item.TraitId] = new TraitReasonDraft
        {
            ReasonType = "author",
            SourceType = "author",
            Confidence = 100,
            TargetCharacterId = -1
        };

        RefreshFast20Reasons();
        _statusMessage = $"Added causal reason for {item.TraitName}.";
        return Task.CompletedTask;
    }

    private Task SaveReason(
        FastTraitDossierItem item,
        TraitReasonDraft draft)
    {
        if (_sheet is null ||
            string.IsNullOrWhiteSpace(draft.Id) ||
            string.IsNullOrWhiteSpace(draft.Reason))
        {
            return Task.CompletedTask;
        }

        NpcTraitRepository.SaveTraitReason(
            id: draft.Id,
            npcId: _sheet.Id,
            traitId: item.TraitId,
            targetCharacterId: draft.TargetCharacterId,
            reasonType: draft.ReasonType,
