    private static string GetSlowCategory(string traitId)
    {
        if (string.IsNullOrWhiteSpace(traitId))
            return "Other";

        string id = traitId.Trim().ToLowerInvariant();

        if (id.StartsWith("slow.sports.") || id == "slow.sports")
            return "Sports";

        if (id.StartsWith("slow.music.") || id == "slow.music")
            return "Music";

        if (id.StartsWith("slow.movies.") || id == "slow.movies")
            return "Movies";

        if (id.StartsWith("slow.tv.") || id == "slow.tv")
            return "TV";

        if (id.StartsWith("slow.life.") || id == "slow.life")
            return "Life";

        if (id.StartsWith("kink.") ||
            id.StartsWith("slow.kink.") ||
            id.StartsWith("slow.kinks."))
            return "Kinks";

        return "Other";
    }

    private static int SlowCategoryOrder(string category) =>
        category switch
        {
            "Life" => 0,
            "Sports" => 1,
            "Music" => 2,
            "Movies" => 3,
            "TV" => 4,
            "Kinks" => 5,
            _ => 99
        };

