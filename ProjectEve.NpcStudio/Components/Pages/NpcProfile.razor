    private async Task LoadAsync()
    {
        _sheet = await Studio.GetCharacterSheetAsync(NpcId);
        if (_sheet is null) return;
        var totalInches = (int)Math.Round(_sheet.HeightCm / 2.54);
        _heightFeet = totalInches / 12;
        _heightInches = totalInches % 12;
        _weightPounds = _sheet.WeightKg > 0 ? Math.Round(_sheet.WeightKg / 0.45359237, 1) : 0;
        _newTrait.NpcId = _sheet.Id;
        _newHistory.NpcId = _sheet.Id;
        _fast20Dossier = FastTraitDossierService.Load(_sheet.Id);
        _midDossier = MidTraitDossierService.Load(_sheet.Id);
        _slowDossier = SlowTraitDossierService.Load(_sheet.Id);
        _relationshipDossier = RelationshipDossierService.Load(_sheet.Id);
        _memoryParticipantOptions = await Studio.GetMemoryParticipantOptionsAsync();
        _canonicalHistoryEvents = await Studio.GetCanonicalHistoryEventsAsync(_sheet.Id);
        ResetMemoryDraft();
        ResetKnowledgeDraft();
        _reasonEdits.Clear();
    }

