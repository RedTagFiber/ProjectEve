@page "/canonical-professional/{NpcId:int}"
@rendermode InteractiveServer
@using ProjectEve.NpcStudio.Models
@using ProjectEve.NpcStudio.Services
@inject ProjectEve.NpcStudio.Data.NpcStudioRepository Repo
@inject AiEducationProfessionalAssistService AiAssist

<PageTitle>Education & Professional</PageTitle>

<div class="edu-shell">
    <header class="edu-hero">
        <div>
            <div class="eyebrow">PROJECT EVE · NPC STUDIO</div>
            <h1>Education & Professional</h1>
            @if (_bundle is not null)
            {
                <p>NPC #@_bundle.NpcId · @_bundle.NpcName</p>
            }
        </div>
        <button class="ghost-btn" @onclick="ReloadAsync" disabled="@_busy">Reload</button>
    </header>

    @if (_loading)
    {
        <div class="status-card">Loading NPC @NpcId...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="status-card error"><b>Load failed</b><pre>@_error</pre></div>
    }
    else if (_bundle is null)
    {
        <div class="status-card">NPC @NpcId was not found.</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="status-card success">@_message</div>
        }

        <section class="ai-card">
            <div class="ai-copy">
                <span class="ai-kicker">✦ AI ASSIST</span>
                <h2>Build the draft. You fine tune it.</h2>
                <p>
                    AI reads the NPC's existing canon and proposes education, career,
                    qualifications and competencies. It does not save anything automatically.
                </p>
            </div>
            <div class="ai-actions">
                <button class="ai-btn" @onclick="GenerateAiPreviewAsync" disabled="@_aiBusy">
                    @(_aiBusy ? "AI is building..." : "Generate AI Draft")
                </button>
                @if (_aiPreview is not null)
                {
                    <button class="ghost-btn" @onclick="ApplyAiPreviewToForm">Apply Draft to Form</button>
                }
            </div>

            @if (_aiPreview is not null)
            {
                <div class="ai-preview">
                    <b>AI Preview</b>
                    <p>@_aiPreview.Summary</p>
                    <div class="preview-chips">
                        <span>@_aiPreview.Education.Count education records</span>
                        <span>@_aiPreview.Qualifications.Count qualifications</span>
                        <span>@_aiPreview.Competencies.Count competencies</span>
                    </div>
                    <small>Nothing is written until you review the form and press Save.</small>
                </div>
            }
        </section>

        <details class="section-card" open>
            <summary>
                <div>
                    <span class="section-num">1</span>
                    <div><b>Education</b><small>School progression and credentials</small></div>
                </div>
                <span class="count">@_bundle.Education.Count records</span>
            </summary>

            <div class="section-body">
                <div class="section-toolbar">
                    <p>
                        Start with Elementary School, then Middle School, High School,
                        and College / University only when it makes sense for this NPC.
                    </p>
                    <button class="secondary-btn" @onclick="AddEducation">+ Add Education</button>
                </div>

                @if (_bundle.Education.Count == 0)
                {
                    <div class="empty-record">
                        No education records yet. Use AI Draft or add the first school record.
                    </div>
                }

                @for (var i = 0; i < _bundle.Education.Count; i++)
                {
                    var item = _bundle.Education[i];
                    var number = i + 1;

                    <details class="record-card" open="@(i == 0)">
                        <summary>
                            <div>
                                <span class="record-index">Education @number</span>
                                <b>@LabelOr(item.EducationType, "Choose education level")</b>
                            </div>
                            <span>@LabelOr(item.InstitutionName, item.Status)</span>
                        </summary>

                        <div class="record-body">
                            <div class="form-grid">
                                <label>
                                    <span>Education Level</span>
                                    <select @bind="item.EducationType">
                                        <option value="">Select level...</option>
                                        @foreach (var option in EducationLevels)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>

                                <label>
                                    <span>School / Institution</span>
                                    <input @bind="item.InstitutionName" placeholder="School name" />
                                </label>

                                <label>
                                    <span>Status</span>
                                    <select @bind="item.Status">
                                        <option>Completed</option>
                                        <option>Currently Enrolled</option>
                                        <option>Graduated</option>
                                        <option>Transferred</option>
                                        <option>Withdrawn</option>
                                        <option>Did Not Complete</option>
                                        <option>Not Applicable</option>
                                    </select>
                                </label>

                                <label>
                                    <span>Degree / Credential</span>
                                    <input @bind="item.DegreeOrCredential" placeholder="Diploma, GED, Associate, Bachelor's..." />
                                </label>

                                <label>
                                    <span>Program</span>
                                    <input @bind="item.ProgramName" />
                                </label>

                                <label>
                                    <span>Field of Study</span>
                                    <input @bind="item.FieldOfStudy" />
                                </label>
                            </div>

                            <div class="mini-grid">
                                <label><span>Start Age</span><input type="number" min="3" max="100" @bind="item.StartAge" /></label>
                                <label><span>End Age</span><input type="number" min="3" max="110" @bind="item.EndAge" /></label>
                                <label><span>GPA</span><input type="number" min="0" max="4" step="0.01" @bind="item.Gpa" /></label>
                            </div>

                            <label class="wide-field">
                                <span>Honors / Notes</span>
                                <input @bind="item.Honors" placeholder="Honors, activities, distinctions..." />
                            </label>

                            <label class="wide-field">
                                <span>Education Notes</span>
                                <textarea rows="2" @bind="item.Notes"></textarea>
                            </label>

                            <details class="advanced">
                                <summary>Advanced / Canonical Event Links</summary>
                                <div class="form-grid">
                                    <label><span>Institution ID</span><input @bind="item.InstitutionId" /></label>
                                    <label><span>Start Time</span><input @bind="item.StartGameTime" /></label>
                                    <label><span>End Time</span><input @bind="item.EndGameTime" /></label>
                                    <label><span>Start Event ID</span><input @bind="item.StartEventId" /></label>
                                    <label><span>Completion Event ID</span><input @bind="item.CompletionEventId" /></label>
                                    <label><span>Withdrawal Event ID</span><input @bind="item.WithdrawalEventId" /></label>
                                </div>
                            </details>

                            <div class="save-row">
                                <button class="primary-btn" @onclick="() => SaveEducationAsync(item)" disabled="@_busy">
                                    Save Education @number
                                </button>
                            </div>
                        </div>
                    </details>
                }
            </div>
        </details>

        <details class="section-card" open>
            <summary>
                <div>
                    <span class="section-num">2</span>
                    <div><b>Professional</b><small>Current work and career truth</small></div>
                </div>
                <span class="count">Current profile</span>
            </summary>

            <div class="section-body">
                <div class="form-grid">
                    <label><span>Primary Role ID</span><input @bind="_bundle.ProfessionalProfile.PrimaryRoleId" /></label>
                    <label><span>Career Field</span><input @bind="_bundle.ProfessionalProfile.CareerField" /></label>
                    <label>
                        <span>Training Level</span>
                        <select @bind="_bundle.ProfessionalProfile.TrainingLevel">
                            <option value="">Select...</option>
                            <option>None / Entry Level</option>
                            <option>On-the-Job Training</option>
                            <option>High School / Equivalent</option>
                            <option>Trade / Vocational</option>
                            <option>Associate Degree</option>
                            <option>Bachelor's Degree</option>
                            <option>Graduate Degree</option>
                            <option>Doctoral / Professional</option>
                            <option>Licensed Professional</option>
                            <option>Retired / Former Professional</option>
                            <option>Student</option>
                        </select>
                    </label>
                    <label><span>Years Experience</span><input type="number" min="0" max="80" @bind="_bundle.ProfessionalProfile.YearsExperience" /></label>
                    <label><span>License Standing</span><input @bind="_bundle.ProfessionalProfile.LicenseStanding" placeholder="N/A, Active, Expired..." /></label>
                    <label class="check-field"><span>Profile Status</span><div><input type="checkbox" @bind="_bundle.ProfessionalProfile.IsActive" /> Active</div></label>
                </div>

                <div class="metric-grid">
                    <label><span>Burnout</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.Burnout" /></label>
                    <label><span>Motivation</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.Motivation" /></label>
                    <label><span>Performance</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.CurrentPerformance" /></label>
                    <label><span>Reputation</span><input type="number" min="0" max="100" @bind="_bundle.ProfessionalProfile.ProfessionalReputation" /></label>
                </div>

                <label class="wide-field">
                    <span>Professional Notes</span>
                    <textarea rows="3" @bind="_bundle.ProfessionalProfile.Notes"></textarea>
                </label>

                <div class="save-row">
                    <button class="primary-btn" @onclick="SaveAndVerifyProfileAsync" disabled="@_busy">Save Professional Profile</button>
                </div>
            </div>
        </details>

        <details class="section-card">
            <summary>
                <div>
                    <span class="section-num">3</span>
                    <div><b>Qualifications</b><small>Licenses, certificates and formal qualifications</small></div>
                </div>
                <span class="count">@_bundle.Qualifications.Count records</span>
            </summary>
            <div class="section-body">
                <div class="section-toolbar">
                    <p>Only add qualifications that make sense for the job and education route.</p>
                    <button class="secondary-btn" @onclick="AddQualification">+ Add Qualification</button>
                </div>

                @foreach (var item in _bundle.Qualifications)
                {
                    <details class="record-card">
                        <summary><div><b>@LabelOr(item.Name, "Qualification")</b></div><span>@item.QualificationType · @item.Status</span></summary>
                        <div class="record-body">
                            <div class="form-grid">
                                <label><span>Role ID</span><input @bind="item.RoleId" /></label>
                                <label><span>Type</span><input @bind="item.QualificationType" /></label>
                                <label><span>Name</span><input @bind="item.Name" /></label>
                                <label><span>Issuer</span><input @bind="item.IssuerName" /></label>
                                <label><span>Status</span><input @bind="item.Status" /></label>
                                <label><span>Credential #</span><input @bind="item.CredentialNumber" /></label>
                            </div>
                            <label class="wide-field"><span>Notes</span><textarea rows="2" @bind="item.Notes"></textarea></label>
                            <div class="save-row"><button class="primary-btn" @onclick="() => SaveQualificationAsync(item)" disabled="@_busy">Save Qualification</button></div>
                        </div>
                    </details>
                }
            </div>
        </details>

        <details class="section-card">
            <summary>
                <div>
                    <span class="section-num">4</span>
                    <div><b>Competencies</b><small>What this NPC can actually do</small></div>
                </div>
                <span class="count">@_bundle.Competencies.Count records</span>
            </summary>
            <div class="section-body">
                <div class="section-toolbar">
                    <p>Competencies should come from education, training and real work experience.</p>
                    <button class="secondary-btn" @onclick="AddCompetency">+ Add Competency</button>
                </div>

                @foreach (var item in _bundle.Competencies)
                {
                    <div class="competency">
                        <input class="competency-name" @bind="item.CompetencyName" placeholder="Competency" />
                        <label><span>Current</span><input type="number" min="0" max="100" @bind="item.CurrentValue" /></label>
                        <label><span>Set Point</span><input type="number" min="0" max="100" @bind="item.SetPointValue" /></label>
                        <label><span>Confidence</span><input type="number" min="0" max="100" @bind="item.Confidence" /></label>
                        <input @bind="item.ExperienceLevel" placeholder="Beginner / Skilled / Expert" />
                        <button class="primary-btn small" @onclick="() => SaveCompetencyAsync(item)" disabled="@_busy">Save</button>
                    </div>
                }
            </div>
        </details>
    }
</div>

