        "blurry, soft focus, low quality, orange lighting, distorted face, bad anatomy, extra fingers, missing fingers, cross-eyed, lazy eye, duplicate person, second person, cartoon, anime, painting, CGI, plastic skin, over-smoothed skin, bad teeth, harsh shadows, text, watermark, logo, cropped face, cut off head, deformed body, unrealistic proportions, celebrity likeness, nudity, topless";

    private sealed class PreviewValidationResult
    {
        public bool IsValid { get; init; }
        public string FullPath { get; init; } = "";
        public string Message { get; init; } = "";

        public static PreviewValidationResult Ok(string fullPath) => new()
        {
            IsValid = true,
            FullPath = fullPath,
            Message = "OK"
        };

        public static PreviewValidationResult Fail(string message) => new()
        {
            IsValid = false,
            Message = message
        };
    }
