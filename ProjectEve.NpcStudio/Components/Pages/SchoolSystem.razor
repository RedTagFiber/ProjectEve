@page "/npc-studio/schools"
@rendermode InteractiveServer
@using ProjectEve.NpcStudio.Models
@using ProjectEve.NpcStudio.Services
@inject ProjectEve.NpcStudio.Services.SchoolSystemService Schools
@inject ProjectEve.NpcStudio.Services.BhsStaffDraftService BhsStaffDrafts
@inject ProjectEve.NpcStudio.Services.BhsStaffPersistenceService BhsStaffPersistence

<PageTitle>School System</PageTitle>

<div class="school-shell">
    <header class="school-hero">
        <div class="chief-mark" aria-label="ProjectEve Chieftains mark">
            <svg viewBox="0 0 120 120" role="img">
                <path d="M60 7 L106 28 L97 81 L60 111 L23 81 L14 28 Z" fill="#111" stroke="#b51f2e" stroke-width="7"/>
                <path d="M69 24 C54 30 45 43 47 57 C49 69 58 77 69 80 C59 84 48 83 39 76 C27 67 23 49 31 35 C38 23 53 17 69 24Z" fill="#b51f2e"/>
                <path d="M68 26 L92 17 L81 40 Z" fill="#f2f2f2"/>
                <text x="60" y="98" text-anchor="middle" font-size="20" font-weight="900" fill="#fff">B</text>
            </svg>
        </div>
        <div>
            <span class="kicker">PROJECT EVE · BELLEFONTAINE SCHOOL SYSTEM</span>
            <h1>Bellefontaine Chieftains</h1>
<div style="margin:12px 0;padding:12px 14px;border:1px solid #4f6b57;border-radius:10px;background:#17241c;">
    <strong>ONE PERSON TEST MODE</strong><br />
    Generate and validate one BHS staff member at a time before persistence is enabled.
</div>
            <p>Real building structure and locations. Fictional ProjectEve staff and student histories.</p>
        </div>
    </header>

    <div class="stats">
        <div><b>@_summary.Schools</b><span>Schools</span></div>
        <div><b>@_summary.Departments</b><span>Departments</span></div>
        <div><b>@_summary.Courses</b><span>Courses</span></div>
        <div><b>@_summary.StaffSlots</b><span>Staff Slots</span></div>
        <div><b>@_summary.AssignedStaff</b><span>NPC Staff Assigned</span></div>
    </div>

        <section class="staff-generator">
        <div class="staff-generator-head">
            <div>
                <span>BHS STAFF GENERATOR · PHASE 1</span>
                <h2>High School Staff First</h2>
                <p>
                    Start with non-teaching staff. AI creates complete adult-life drafts for review only.
                    High-school teachers are Phase 2 after this passes.
                </p>
            </div>
            <button @onclick="GenerateBhsStaffAsync" disabled="@_bhsGenerating">
                @(_bhsGenerating ? "Generating ONE complete staff..." : "Generate ONE BHS Staff")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_bhsMessage))
        {
            <div class="staff-message">@_bhsMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_bhsError))
        {
            <div class="staff-message error">@_bhsError</div>
        }

        @if (_bhsDraft is not null)
        {
            <div class="staff-preview-warning">
                PREVIEW ONLY — nothing below has been written to NPC, finance, family, vehicle, phone,
                relationship, history, or location canon.
            </div>

            @if (!string.IsNullOrWhiteSpace(_bhsDraft.Summary))
            {
                <p class="staff-batch-summary">@_bhsDraft.Summary</p>
            }

            <div class="staff-preview-grid">
                @foreach (var staff in _bhsDraft.Staff)
                {
                    <details class="staff-preview-card" open>
                        <summary>
                            <div>
                                <b>@staff.FullName</b>
                                <span>@staff.RoleTitle · Age @staff.Age · Tier @staff.Tier</span>
                            </div>
                            <strong>@staff.AnnualSalary.ToString("C0") / yr</strong>
                        </summary>

                        <div class="staff-preview-body">
                            <div class="staff-facts">
                                <div><span>Gender</span><b>@staff.Gender</b>
                        <div>
    <span>Race / Ethnicity</span>
    <select @bind="staff.RaceEthnicity">
        <option value="">Choose...</option>
        @foreach (var race in BhsStaffPersistenceService.OhioRaceEthnicityOptions)
        {
            <option value="@race">@race</option>
        }
    </select>
</div></div>
                                <div><span>Marital</span><b>@staff.MaritalStatus</b></div>
                                <div><span>Occupation</span><b>@staff.Occupation</b></div>
                                <div><span>Home</span><b>@staff.Home.StreetOrArea · @staff.Home.HousingType</b></div>
                                <div><span>Housing Cost</span><b>@staff.Home.EstimatedMonthlyHousingCost.ToString("C0") / mo</b></div>
                                <div><span>Vehicle</span><b>@staff.Vehicle.Year @staff.Vehicle.Make @staff.Vehicle.Model</b></div>
                                <div><span>Checking</span><b>@staff.Banking.CheckingBalance.ToString("C0")</b></div>
                                <div><span>Savings</span><b>@staff.Banking.SavingsBalance.ToString("C0")</b></div>
                            </div>

                            <details class="staff-subsection">
                                <summary>Education & Credentials</summary>
                                @foreach (var edu in staff.Education)
                                {
                                    <div class="staff-line">
                                        <b>@edu.Level</b>
                                        <span>@edu.Institution · @edu.Credential @edu.Field</span>
                                    </div>
                                }
                                @if (staff.Certifications.Count > 0)
                                {
                                    <div class="staff-chip-row">
                                        @foreach (var item in staff.Certifications)
                                        {
                                            <span>@item</span>
                                        }
                                    </div>
                                }
                            </details>

                            <details class="staff-subsection">
                                <summary>Appearance & Clothing</summary>
                                <div class="staff-facts">
                                    <div><span>Height</span><b>@staff.Appearance.HeightText</b></div>
                                    <div><span>Weight</span><b>@staff.Appearance.WeightLb lb</b></div>
                                    <div><span>Build</span><b>@staff.Appearance.BodyType</b></div>
                                    <div><span>Hair</span><b>@staff.Appearance.HairColor · @staff.Appearance.HairStyle</b></div>
                                    <div><span>Eyes</span><b>@staff.Appearance.EyeColor</b></div>
                                    <div><span>Skin</span><b>@staff.Appearance.SkinTone</b></div>
                                </div>
                                <p><b>Dress:</b> @staff.Appearance.ClothingStyle</p>
                                <p><b>Features:</b> @staff.Appearance.DistinguishingFeatures</p>
                                @if (!string.IsNullOrWhiteSpace(staff.Appearance.AdultAnatomyNotes))
                                {
                                    <p><b>Adult physical profile:</b> @staff.Appearance.AdultAnatomyNotes</p>
                                }
                            </details>

                            <details class="staff-subsection">
                                <summary>Traits, Personality & Interests</summary>
                                <p>@staff.Personality.Summary</p>
                                <div class="staff-chip-row">
                                    @foreach (var item in staff.Personality.Traits)
                                    {
                                        <span>@item</span>
                                    }
                                </div>
                                <p><b>Hobbies:</b> @string.Join(", ", staff.Personality.Hobbies)</p>
                                <p><b>Public:</b> @staff.Personality.PublicPersona</p>
                                <p><b>Private:</b> @staff.Personality.PrivatePersona</p>
                                <p><b>Goal:</b> @staff.Personality.Goal</p>
                                <p><b>Need:</b> @staff.Personality.Need</p>
                                <p><b>Fear:</b> @staff.Personality.Fear</p>
                            </details>

                            <details class="staff-subsection">
                                <summary>Household</summary>
                                @if (staff.Spouse.Include)
                                {
                                    <div class="staff-line">
                                        <b>Spouse: @staff.Spouse.Name</b>
                                        <span>Age @staff.Spouse.Age · @staff.Spouse.Occupation · Tier @staff.Spouse.Tier</span>
                                    </div>
                                }
                                else
                                {
                                    <p>No spouse proposed.</p>
                                }

                                @if (staff.Children.Count > 0)
                                {
                                    @foreach (var child in staff.Children)
                                    {
                                        <div class="staff-line">
                                            <b>@child.Name</b>
                                            <span>Age @child.Age · @child.Gender · Tier @child.Tier</span>
                                        </div>
                                    }
                                }
                            </details>

                            <details class="staff-subsection">
                                <summary>Professional / Future Connection Hooks</summary>
                                <p><b>Reputation:</b> @staff.Professional.Reputation</p>
                                <p><b>Strengths:</b> @string.Join(", ", staff.Professional.Strengths)</p>
                                @foreach (var hook in staff.Professional.StudentFamilyConnectionHooks)
                                {
                                    <div class="staff-hook">@hook</div>
                                }
                            </details>
                            <div class="staff-save-actions">
                                <button class="secondary"
                                        @onclick="GenerateBhsStaffAsync"
                                        disabled="@(_bhsGenerating || _bhsSaving)">
                                    Regenerate
                                </button>

                                <button class="save"
                                        @onclick="() => SaveBhsStaffAsync(staff)"
                                        disabled="@(_bhsGenerating || _bhsSaving)">
                                    @(_bhsSaving ? "Saving..." : "Approve & Save Household")
                                </button>
                            </div>
                        </div>
                    </details>
                }
            </div>
        }

        @if (_lastSaved is not null)
        {
            <div class="saved-batch-box">
                <b>SAVED TEST HOUSEHOLD</b>
                <span>Batch @_lastSaved.BatchId · Staff NPC @_lastSaved.StaffNpcId · Household @_lastSaved.HouseholdId</span>
                <span>@_lastSaved.Message</span>
                <button class="danger" @onclick="DeleteLastSavedBatch">DELETE ENTIRE GENERATED PROFILE</button>
            </div>
        }
    </section>
<details class="section" open>
        <summary><div><b>1 · Buildings & Locations</b><small>Real Bellefontaine City Schools structure</small></div></summary>
        <div class="body school-grid">
            @foreach (var school in _schools)
            {
                <article class="school-card">
                    <span>@school.SchoolId · @school.BuildingType</span>
                    <h3>@school.Name</h3>
                    <p>Grades @school.GradeLow–@school.GradeHigh</p>
                    <p>@school.Address</p>
                    <small>@school.StartTime–@school.EndTime · @school.MascotName</small>
                </article>
            }
        </div>
    </details>

    <details class="section" open>
        <summary><div><b>2 · Fictional Anchor Staff</b><small>Preview candidates — not NPCs yet</small></div></summary>
        <div class="body anchor-grid">
            @foreach (var anchor in _anchors)
            {
                <article>
                    <div class="anchor-head"><b>@anchor.SuggestedName</b><span>Tier @anchor.Tier</span></div>
                    <p>@anchor.SchoolId · @anchor.RoleTitle · @anchor.DepartmentId</p>
                    <div class="chips">
                        @foreach (var code in anchor.TeachableCourseCodes)
                        {
                            <span>@CourseName(code)</span>
                        }
                    </div>
                    <small>@anchor.Notes</small>
                </article>
            }
        </div>
    </details>

    <details class="section">
        <summary><div><b>3 · Complete Staff Model</b><small>Teachers, nurses, counselors, principals, custodians, food service, aides, district operations</small></div></summary>
        <div class="body">
            @foreach (var group in _roles.GroupBy(x => x.SchoolId))
            {
                <h3 class="group-title">@SchoolLabel(group.Key)</h3>
                <div class="role-grid">
                    @foreach (var role in group)
                    {
                        <div><b>@role.TargetCount</b><span>@role.RoleTitle</span><small>@role.DepartmentId · Tier @role.DefaultTier</small></div>
                    }
                </div>
            }
        </div>
    </details>

    <details class="section">
        <summary><div><b>4 · Course Catalog</b><small>Grade core, middle subjects, high-school departments and electives</small></div><span>@_courses.Count courses</span></summary>
        <div class="body">
            @foreach (var group in _courses.GroupBy(x => x.SchoolId))
            {
                <h3 class="group-title">@SchoolLabel(group.Key)</h3>
                <div class="course-grid">
                    @foreach (var c in group)
                    {
                        <div><b>@c.Name</b><span>@string.Join(", ", c.GradeLevels)</span><small>@c.CourseCode · @c.DepartmentId</small></div>
                    }
                </div>
            }
        </div>
    </details>

    <div class="rule-box">
        <b>School NPC Rule</b>
        <p>
            Staff slots do not silently create people. NPC Studio must search/reuse an existing suitable NPC first,
            otherwise propose a fictional staff NPC for Preview → Confirm. Student course rows then link to the real NPC ID.
        </p>
    </div>
</div>

