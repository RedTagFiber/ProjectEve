@code {
    private BhsStaffDraftBatch? _bhsDraft;
    private bool _bhsGenerating;
    private bool _bhsSaving;
    private BhsStaffSaveResult? _lastSaved;
    private string _bhsMessage = "";
    private string _bhsError = "";

    private async Task GenerateBhsStaffAsync()
    {
        _bhsGenerating = true;
        _bhsMessage = "";
        _bhsError = "";
        try
        {
            _bhsDraft = await BhsStaffDrafts.GenerateAsync(1);
            _bhsMessage = $"AI created {_bhsDraft.Staff.Count} complete BHS staff previews. Review only; nothing is saved.";
        }
        catch (Exception ex)
        {
            _bhsError = ex.Message;
        }
        finally
        {
            _bhsGenerating = false;
        }
    }


    private async Task SaveBhsStaffAsync(BhsStaffDraft staff)
    {
        _bhsSaving = true;
        _bhsError = "";
        _bhsMessage = "";
        try
        {
            _lastSaved = await BhsStaffPersistence.SaveOneHouseholdAsync(staff);
            _summary = Schools.GetSummary();
            _bhsMessage = _lastSaved.Message;
            _bhsDraft = null;
        }
        catch (Exception ex)
        {
            _bhsError = ex.Message;
        }
        finally
        {
            _bhsSaving = false;
        }
    }

    private void DeleteLastSavedBatch()
    {
        if (_lastSaved is null)
            return;

        var result = BhsStaffPersistence.DeleteGeneratedBatch(_lastSaved.BatchId);
        _bhsMessage = result.Message;
        if (result.Success)
            _lastSaved = null;

        _summary = Schools.GetSummary();
    }
    private SchoolSystemSummary _summary = new(0,0,0,0,0,0,0);
    private IReadOnlyList<SchoolMaster> _schools = Array.Empty<SchoolMaster>();
    private IReadOnlyList<SchoolCourseMaster> _courses = Array.Empty<SchoolCourseMaster>();
    private IReadOnlyList<SchoolStaffRoleTemplateMaster> _roles = Array.Empty<SchoolStaffRoleTemplateMaster>();
    private IReadOnlyList<FictionalSchoolStaffAnchorMaster> _anchors = Array.Empty<FictionalSchoolStaffAnchorMaster>();

    protected override void OnInitialized()
    {
        _summary = Schools.GetSummary();
        _schools = Schools.GetSchools();
        _courses = Schools.GetCourses();
        _roles = Schools.GetRoleTemplates();
        _anchors = Schools.GetAnchors();
    }

    private string CourseName(string code)
        => _courses.FirstOrDefault(x => x.CourseCode == code)?.Name ?? code;

    private string SchoolLabel(string id)
        => id == "DISTRICT" ? "District / Central Office" :
           _schools.FirstOrDefault(x => x.SchoolId == id)?.Name ?? id;
}





