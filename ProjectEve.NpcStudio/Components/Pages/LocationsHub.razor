@page "/npc-studio/locations"
@rendermode InteractiveServer

<PageTitle>Locations · Project Eve</PageTitle>

<section style="max-width:1500px;margin:24px auto;padding:0 18px;color:#e9eef8;">
    <div style="padding:22px;border:1px solid #2c3e5a;border-radius:16px;background:#0a1423;">
        <div style="font-size:.65rem;font-weight:900;letter-spacing:.16em;color:#9d82ff;">PROJECT EVE · LOCATIONS</div>
        <h1 style="margin:6px 0 8px;">Location System</h1>
        <p style="color:#91a5c5;max-width:850px;">
            Homes, schools, businesses, neighborhoods, roads and other canonical world places live here.
        </p>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-top:18px;">
            <a href="/npc-studio/schools" style="text-decoration:none;color:#fff;padding:18px;border-radius:12px;background:#111f33;border:1px solid #344967;">
                <b>School Locations</b><br />
                <span style="color:#91a5c5;">District, campuses, school buildings and organization links.</span>
            </a>
            <div style="padding:18px;border-radius:12px;background:#111f33;border:1px solid #344967;">
                <b>Homes & Households</b><br />
                <span style="color:#91a5c5;">Residence and property workspace.</span>
            </div>
            <div style="padding:18px;border-radius:12px;background:#111f33;border:1px solid #344967;">
                <b>Businesses & Workplaces</b><br />
                <span style="color:#91a5c5;">Workplace registry and employment locations.</span>
            </div>
            <div style="padding:18px;border-radius:12px;background:#111f33;border:1px solid #344967;">
                <b>Town & World Places</b><br />
                <span style="color:#91a5c5;">Neighborhoods, roads, public places and travel nodes.</span>
            </div>
        </div>
    </div>
</section>
