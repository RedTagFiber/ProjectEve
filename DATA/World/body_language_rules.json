  "tellProfile": {
    "fields": {
      "lie_skill": {
        "range": [
          0,
          100
        ],
        "meaning": "Ability to suppress, manage, or redirect leakage during deception."
      },
      "emotional_control": {
        "range": [
          0,
          100
        ],
        "meaning": "General ability to regulate visible reactions."
      },
      "expressiveness": {
        "range": [
          0,
          100
        ],
        "meaning": "How visible emotions normally are."
      },
      "self_monitoring": {
        "range": [
