  "lieModel": {
    "note": "Deception is inferred only from hidden world truth plus NPC intent. Body cues never reveal truth directly to the player.",
    "leakStrengthFormulaHint": "pressure + anxiety + guilt + shame - lie_skill - emotional_control + context_modifier",
    "pressureSources": [
      "stakes",
      "relationship_closeness",
      "fear_of_discovery",
      "social_audience",
      "current_stress",
      "fatigue"
    ],
    "goodLiarBehavior": [
      "fewer_large_leaks",
      "more_normal_baseline_behavior",
      "may_overcontrol",
      "may_redirect"
    ],
    "poorLiarBehavior": [
      "timing_shifts",
      "self_touch",
