  "combos": [
    {
      "id": "combo.lie_anxious_guilty",
      "when": {
        "trait.anxiety": ">=65",
        "trait.guilt": ">=60"
      },
      "bias": [
        "hesitation",
        "self_touch",
        "answer_timing_shift",
        "overexplain"
      ],
      "suppress_if": {
        "lie_skill": ">=80",
        "trait.guard": ">=75"
      },
      "note": "Not proof of deception. Similar pattern can appear under fear of being disbelieved."
    },
    {
      "id": "combo.lie_guarded_proud",
      "when": {
        "trait.guard": ">=70",
        "trait.pride": ">=65"
      },
      "bias": [
        "controlled_face",
        "oversteady_eye_contact",
        "jaw_set",
        "short_answer"
      ],
      "note": "Good at masking obvious leakage; may look unusually controlled."
    },
    {
