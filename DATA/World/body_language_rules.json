{
  "schema": "project_eve.body_language_rules.v1",
  "purpose": "Player-visible nonverbal behavior derived from Fast traits, personal tell profile, context, and conscious control.",
  "corePrinciples": [
    "No single cue proves lying, attraction, fear, guilt, or any other hidden state.",
    "Interpret clusters and changes from that NPC's normal baseline, not isolated gestures.",
    "ThoughtEngine selects involuntary LEAKS.",
    "DialogueEngineInPerson selects conscious PRESENTATION plus SAY.",
    "The player sees behavior, never hidden-state labels.",
    "Traits bias cues; they do not force deterministic animations.",
    "Personal TellProfile modifies which cues are common, rare, suppressed, or exaggerated."
  ],
  "intensityBands": {
    "off": [
      0,
      29
    ],
    "low": [
      30,
      49
    ],
    "mid": [
      50,
      69
    ],
    "high": [
      70,
      84
    ],
    "extreme": [
      85,
      100
    ]
  },
